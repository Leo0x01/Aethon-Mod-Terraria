<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AethonMod</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>AethonMod</RootNamespace>
    <AssemblyTitle>AethonMod</AssemblyTitle>
    <Company>AethonModTeam</Company>
    <Version>0.1.0.0</Version>
    <Configurations>Debug;Release;Server</Configurations>
    <NoWarn>CS1591;CS0649;CS0169;CA1416</NoWarn>
    <!-- No auto-generate assembly info (conflicts with tModLoader) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    tModLoader DLLs path.
    Descargados de https://github.com/tModLoader/tModLoader/releases/tag/v2026.06.3.6
    Extraidos a /tmp/tmodloader/
  -->
  <PropertyGroup>
    <TModLoaderPath>/tmp/tmodloader</TModLoaderPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- tModLoader API -->
    <Reference Include="tModLoader">
      <HintPath>$(TModLoaderPath)/tModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FNA (XNA replacement) -->
    <Reference Include="FNA">
      <HintPath>$(TModLoaderPath)/Libraries/FNA/1.0.0/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Steamworks.NET (required by Terraria) -->
    <Reference Include="Steamworks.NET">
      <HintPath>$(TModLoaderPath)/Libraries/steamworks.net.anycpu/2025.162.4/lib/net8.0/Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RailSDK (optional, may be needed) -->
    <!-- ReLogic (required for SlotId, Asset<T>) -->
    <Reference Include="ReLogic">
      <HintPath>$(TModLoaderPath)/Libraries/ReLogic/1.0.0/ReLogic.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RailSDK.Net">
      <HintPath>$(TModLoaderPath)/Libraries/RailSDK.Net/1.0.0.0/RailSDK.Net.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Contenido del mod -->
  <ItemGroup>
    <None Update="build.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="description.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
