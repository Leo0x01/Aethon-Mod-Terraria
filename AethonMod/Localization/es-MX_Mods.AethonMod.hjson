Jefe: {
        Resonancia: ¡Has absorbido {1} fragmentos de resonancia de {0}!

        // v6.50.61 — THE PURGE: Titan.Furia, Rift.*, Arquera.* and
        // Portador.Furia died with their bosses.

        Aethon: {
                Fase: Aethon — FASE {0}: {1}
                Nombre1: El Polvo Estelar
                Nombre2: La Canción del Tiempo
                Nombre3: La Gravedad
                Nombre4: El Telar
                Nombre5: El Veredicto
                // v6.50.57 — GRAVITY DIED (the letter: the boss must STOP bending
                // gravity) — its announce retired with it.
                Recordar: AETHON RECUERDA — las runas que memorizó de ti vuelven a su dueño.
                Reconocimiento: LA PRUEBA ESTÁ CERRADA: el grimorio te declara digno. LA FORMA ASCENDIDA cae a tus pies.
                Muerte: El libro SE CIERRA y su luz regresa a las páginas. El sol recupera su curso.
                Carga: EL DESTELLO — la luz cruza el mundo: no estés en su línea.
                Juicio: EL JUICIO DE LUZ — columnas de luz caen del cielo: corre.
                Nova: LA NOVA PRIMORDIAL — la luz estalla: busca el hueco.
                Aliento: EL RAYO PRIMORDIAL — la luz te busca.
                // v6.50.46 — THE ECLIPSE IS DEAD ("the light goes out and only the
                // bullets shine, it looks bad, remove it") — its successor: THE VORTEX.
                Vortice: EL VÓRTICE PRIMORDIAL — la luz gira alrededor tuyo: muévete con el remolino.
                // v6.50.45 — THE FIVE NEW WEAPON ANNOUNCES
                Reloj: EL RELOJ DE ARENA CÓSMICO — el tiempo cae del cielo: no vueles bajo su peso.
                Coro: EL CORO ESPECTRAL — las notas cantan alrededor tuyo: muévete con el anillo.
                Manada: LA MANADA ASTRAL — la luz suelta a los perros del cielo: mátalos o córreles.
                Telar: EL TELAR DE CONSTELACIONES — las estrellas tejen la jaula: sal de la figura.
                Decreto: EL DECRETO DEL ECLIPSE — el círculo CABALGA CON EL DIOS: córrele o sal YA de su sombra.
                // v6.50.53 — THE USER'S IMAGE, MADE AN ATTACK: THE RADIANT BURST
                Estallido: EL ESTALLIDO RADIANTE — toda la luz del mundo se junta y ARDE: fuera del anillo.
                // v6.50.54 — THE THREE NEW EMPRESS WEAPONS (the research)
                Danza: LA DANZA SOLAR — los rayos del dios giran: camina ENTRE la luz, con el giro.
                Lanzas: LAS LANZAS ETERNAS — la luz apunta DONDE VAS: rompe la línea recta.
                Corona: LA CORONA ETERNA — el arcoíris te asedia: muévete con las plumas.
                // v6.50.57 — THE SPECIAL ATTACK: THE GOD BECOMES A SUN AND THROWS IT
                Sol: EL SOL DEL DIOS — Aethon SE CONVIERTE en sol y lo LANZA: aléjate de la gigante roja.
        }
}

Esencia: {
        SinLibro: El alma busca un Grimorio del Eterno en tu barra rápida — el libro es quien la prueba.

        // v6.50.30 — EACH WARDEN'S OWN FLAVOR (the user's letter: dialogs
        // must match the boss the essence belongs to): the book's voice
        // tastes the soul of ITS boss — 3 samples each (EcoLib.ElegirClave
        // never repeats the last one).
        Sabor: {
                KingSlime1: El Rey baja dulce y entero: un trono de gelatina digerido en tres tragos.
                KingSlime2: Sabe a corona y a azúcar derretida. La realeza SIEMPRE cae blanda.
                KingSlime3: Digiero al Rey: la corona ya es página mía. ¿La siguiente?
                EyeofCthulhu1: El Ojo al fin cierra el párpado… dentro de mí. Sabe a vigilia cansada.
                EyeofCthulhu2: Un ojo entero: lo más parecido a beberse la luna de un trago.
                EyeofCthulhu3: La pupila fue lo último en disolverse. Me VIGILÓ hasta el final.
                Deerclops1: Escarcha ancestral en el paladar… el invierno caminante, digerido.
                Deerclops2: Un alma fría de verdad: congeló MI hambre un latido entero.
                Deerclops3: El cuerno pasó lento. Rareza de una en cien: vale CADA trago.
                QueenBee1: Miel real con aguijón: lo dulce con consecuencias. Baja ardiendo.
                QueenBee2: La Reina entera sabe a panal y a veneno de gala. Un festín REAL.
                QueenBee3: Aguijón digerido, colmena en página. Zumba al pasar la hoja.
                EaterofWorlds1: Un devorador devorado. El mundo entero cabe en una página SI sé masticar.
                EaterofWorlds2: Cien fauces corrompidas en un solo hilo… sabe a tierra enferma.
                EaterofWorlds3: Él devoraba mundos; YO devoro devoradores. La cadena soy yo.
                BrainofCthulhu1: El Cerebro piensa… dentro de mí. Sus reflejos aún gritan en rojo.
                BrainofCthulhu2: Sabe a materia gris y a pánico. Los pensamientos ajenos CRUJEN.
                BrainofCthulhu3: Digiero una mente entera: por un tick, pensé en ROSA.
                Skeletron1: La maldición copiada a mano alzada, letra por letra, hueso a hueso.
                Skeletron2: Sabe a calabozo, a moho y a una promesa vieja rota.
                Skeletron3: Sus huesos aún recitan. La maldición ya es página: ahora la escribo YO.
                // v6.50.61 — THE PURGE: the flavors of HollowTitan,
                // RiftKeeper, EchoArcher and EchoBlade died with their bosses.
                AethonBoss1: AETHON. El grimorio mismo, digerido. Sabe a principio de todo… y a mí mismo.
                AethonBoss2: Me PROBÓ y perdí contra mi propio portador. Sabe a perdón — el sabor que nunca había probado.
                AethonBoss3: La prueba era mía; la victoria, tuya. Al cerrarse el libro, el sol parpadeó UN tick.
        }

        CofreSeco: El cofre de almas de {0} ya está SECO en este mundo — diez páginas, cuento cerrado.
        UltimaAlma: La ÚLTIMA alma de {0} cayó. Su cuento en este mundo está completo.
}

