// v6.50.65 — ESPAÑOL LATINOAMÉRICA (es-MX): el idioma PRIMARIO del mod
// (la letra del usuario: «el idioma del juego debe ser español latinoamérica,
// no español españa»). v6.50.71 — TODAS LAS VARIANTES DE ESPAÑOL CAEN AQUÍ:
// el juego en «Español (España)» y en «Español (Latinoamérica)» lee ESTE
// archivo (es-ES es un ESPEJO GENERADO de este — tools/sync_es_es_v65077.py).
Mods.AethonMod.DisplayName: Aethon, el Grimorio Eterno

Items: {
        GenesisShard: {
                DisplayName: Fragmento Génesis
                Tooltip:
                        '''
                        Arma de luz que dispara partículas autoguiadas.
                        Material para fabricar el Grimorio del Eterno.
                        Se obtiene al vencer al Rey Slime y al Ojo de Cthulhu.
                        '''
        }

        AncientAltarItem: {
                DisplayName: Altar Antiguo
                Tooltip: ""
        }

        ResonanceShard: {
                DisplayName: Fragmento de Resonancia
                Tooltip: Moneda cósmica. Se obtiene de jefes.
        }

        GrimoireEternal: {
                DisplayName: Grimorio del Eterno
                Tooltip:
                        '''
                        Aethon, atado en forma de libro: el arma que come ES el
                        jefe final. Cada página que devoras lo hace más fuerte —
                        y más cerca de abrirse para probarte.
                        Arma híbrida mágica/de invocación.
                        Clic izq: descarga arcana. Clic der: invoca un esbirro.
                        Gana XP REAL con cada baja: la rareza del bestiario (0–5 estrellas)
                        mide su valor, la PRIMERA baja de cada especie paga ×3 y el modo difícil
                        duplica a las criaturas; los jefes pagan XP FIJA (base + 10% de su
                        vida + estrellas + un término que crece con tu nivel).
                        LOS TRES ESTADOS: sostenido = todo el poder; en la barra rápida =
                        sigue comiendo XP, conserva los espacios de esbirro y vida/maná (tope
                        +100); guardado = nada (los esbirros ya invocados permanecen).
                        Sin coste de maná (pruebas).
                        '''
        }

        BossSummonBag: {
                DisplayName: Bolsa de Invocadores
                Tooltip:
                        '''
                        Contiene 999 invocadores de cada jefe.
                        Objeto de pruebas — eliminar antes de publicar.
                        '''
        }

        LevelUpTester: {
                DisplayName: Verdugo de Niveles
                Tooltip:
                        '''
                        Da +10 niveles al Grimorio del Eterno.
                        Reutilizable — no se consume.
                        Busca en todo el inventario.
                        Objeto de pruebas — eliminar antes de publicar.
                        '''
        }

        CarnadaDelGrimorio: {
                DisplayName: La Carnada del Grimorio
                Tooltip:
                        '''
                        Provoca LAS OLEADAS DEL HAMBRE sin esperar.
                        Clic izq: desata la furia (las oleadas preparadas).
                        Clic der: prepara 1..11 oleadas (11 = EL JUICIO: los 6 guardianes ×15).
                        Todo lo que muera en la oleada k paga XP ×(k+1); la especial, ×15.
                        Objeto de pruebas — eliminar antes de publicar.
                        '''
        }

        // v6.50.75 — EL RELOJ DE ARENA DEL ESCRIBA: un clic cambia el día
        // por la noche y la noche por el día (la petición del usuario:
        // «un clic y es de día, otro clic y es de noche»).

        RelojDeArenaDelEscriba: {
                DisplayName: El Reloj de Arena del Escriba
                Tooltip:
                        '''
                        Un clic: si es de día, cae la noche; si es de noche, amanece.
                        La arena es tinta: con ella el escriba escribió el alba y el ocaso.
                        Funciona incluso a media oleada: el cielo del festín cruza suave.
                        Objeto de pruebas — eliminar antes de publicar.
                        '''
        }

        // v6.50.82 — EL GRIMORIO HAMBRIENTO: el arma DEMO del Códice Vivo.
        // La letra del usuario: el ciclo de hambre comprimido a 60 s.
        GrimorioHambriento: {
                DisplayName: Grimorio Hambriento
                Tooltip:
                        '''
                        El ojo del Códice Vivo: te mira, parpadea y pasa hambre.
                        Su apetito crece de cero a TOTAL en un minuto (tasa
                        de prueba): el parpadeo se acelera (de 10-20 s a
                        cada 2 s), la mirada se agita y el iris dorado se
                        enciende ROJO.
                        Clic izq: escupe LA LÁGRIMA DE TINTA — la descarga
                        perseguidora PROPIA del libro (pruebas, sin maná).
                        Clic der: reinicia el apetito.
                        Objeto de pruebas — eliminar antes de publicar.
                        '''
        }

        // v6.50.92 — LA FAMILIA SE ENCOGE A DOS (la letra del usuario:
        // «borra al grimorio hambriento inestable y al erratico, deja
        // el original y al nervioso»): el Errático (.87) y el Inestable
        // (.89) BORRADOS; el Nervioso (.90) vive sus DOS VIDAS (.91).
        GrimorioHambrientoNervioso: {
                DisplayName: Grimorio Hambriento Nervioso
                Tooltip:
                        '''
La copia HAMBRIENTA — el mismo ojo, pero este libro
es APETITO CON CUERPO: intranquilo, enojado, con
hambre. Su hambre sube SIEMPRE (tasa de prueba; la
versión real irá más lenta): sólo la presa comida la
baja (−1%) y el clic derecho la reinicia.
Desde el 25% sale a cazar POR SU CUENTA si te ausentas
(AFK 5 s, o 30 s sin atacar criaturas con el libro):
flota cerca de ti y su Sombra de la Página devora a
la criatura que se mueva cerca — ataca cuando QUIERE:
en cuanto termina con una presa, sale tras la
siguiente que se mueva.
El festín es EGOÍSTA: se come a la presa ENTERA, botín
incluido — la XP es de ESTE libro (sube su nivel);
tú no recibes nada. Mientras está fuera, sus ataques
salen DEL LIBRO (tu mano ataca vacía).
NUNCA se escapa: al 100% se queda flotando cerca de
ti, cazando por sí mismo.
Clic izq: escupe LA LÁGRIMA DE TINTA — la descarga
perseguidora PROPIA del libro (pruebas, sin maná).
Clic der: reinicia el apetito.
Objeto de pruebas — comparar con el original.
'''
        }

        // v6.50.62 — THE GRIMOIRE'S MAWS: the three shadow-devouring
        // weapons (test — the book is NOT touched). Pride's power (FMA:B).
        // v6.50.64 — the TWIN-HEAD pincer + the BLACK MIST on all three
        // ("the gif doubled at the tip, one per corner, so it behaves like
        // teeth" + "black mist on every tentacle and mouth").


        SombraDeLaPagina: {
                DisplayName: La Sombra de la Página
                Tooltip:
                        '''
                        «Escrita con tinta de la Puerta: ojos y dientes.»
                        La misma fauce del tentáculo, pero 100% ESCRITA POR CÓDIGO —
                        ni un sprite: la masa muscular, los ojos que se abren de
                        golpe, la carne que fluye, TODO dibujado por el motor.
                        Nace DE TU CUERPO — vueles o camines, la sombra va CONTIGO —,
                        caza a cualquier distancia, muerde y drena: la punta se
                        disuelve en BRUMA NEGRA y al clavarse, EL DEVORADOR — la masa
                        que CUBRE ENTERO al jefe — traga con pulso mientras las almas
                        vuelven a ti por el cuerpo. A 1 de vida: el festín.
                        (Arma de prueba de las fauces — v2.)
                        '''
        }

        // v6.50.95 — LA TINTA VIVA (la letra: «quiero que con este
        // proyectil seas creativo, lo animes y crees una nueva arma con
        // el proyectil»): el arma que escupe LA LÁGRIMA DE TINTA — el
        // disparo propio del libro, nacido del sprite EXACTO del usuario.
        TintaViva: {
                DisplayName: Tinta Viva
                Tooltip:
                        '''
                        «La primera lágrima que el grimorio no quiso llorar.»
                        Escupe LÁGRIMAS DE TINTA — la página doblada en
                        sombra con corazón de marfil: respiran en vuelo,
                        persiguen a tu presa (la tinta aprende a caer),
                        gotean estelas de sombra, atraviesan los muros y,
                        al romperse, salpican y dejan LA MANCHA.
                        Si el Nervioso anda FUERA, la tinta sale DEL LIBRO.
                        Tres presas por lágrima.
                        '''
        }
        // v6.50.91 — EL CÓDICE VIVO FUE BORRADO POR COMPLETO (la letra del
        // usuario: «El Codice Vivo lo puedes borrar por completo ya no es
        // necesario»). Su levitación — el libro que se suelta y vela flotando
        // — vive ahora en el ESPÍRITU del Grimorio Nervioso (caza — la
        // fuga murió en la .94: el libro nunca se escapa).

        // v6.50.61 — THE PURGE: the FOUR wardens' summon items died with
        // their bosses (Hollow Titan Crystal, Rift Seal, Archer's Feather,
        // Bearer's Shadow).

        NombreDeAethon: {
                DisplayName: El Nombre de Aethon
                Tooltip:
                        '''
                        «El libro que cargas tiene nombre propio.
                        Pronúncialo… y se abrirá para probarte.»
                        Convoca a AETHON, EL GRIMORIO ETERNO — el libro mismo,
                        levantándose de sus propias páginas: LA PRUEBA FINAL.
                        La entrada de la EMPERATRIZ DE LUZ, exacta: nace 200 pies
                        sobre tu cabeza y se presenta antes de la pelea.
                        Las cinco fases esperan — el veredicto del propio grimorio.
                        '''
        }

        AethonMenorItem: {
                DisplayName: El Aethon Menor
                Tooltip:
                        '''
                        Una chispa viva del propio grimorio.
                        Invoca al AETHON MENOR — la mascota de luz: una página
                        del libro hecha criatura, flotando a tu hombro, coronada
                        de perlas y alumbrando con el arcoíris del tomo.
                        '''
        }

        MedusaNebularStaff: {
                DisplayName: Báculo de la Medusa Nebular
                Tooltip:
                        '''
                        Invoca LA MEDUSA NEBULAR.
                        Una campana translúcida con una galaxia espiral dentro, nadando a pulsos de gravedad.
                        Su campana dispara LÁTIGOS ELÉCTRICOS que salen de ella misma, dejando la quemadura fría del vacío.
                        '''
        }

        LivingCometStaff: {
                DisplayName: Báculo del Cometa Estelar
                Tooltip:
                        '''
                        Invoca EL COMETA ESTELAR.
                        Un cometa vivo con corona de 8 puntas estelares, orbitándote en una elipse excéntrica.
                        CAE EN PICADO sobre tus enemigos y estalla en una pequeña nova.
                        '''
        }

        LivingPulsarStaff: {
                DisplayName: Báculo del Púlsar Vivo
                Tooltip:
                        '''
                        Invoca EL PÚLSAR VIVO.
                        Una estrella de neutrones girando a tu lado, barriendo el campo con dos haces de faro de radiación.
                        Todo lo que cruzan queda ELECTRIFICADO.
                        '''
        }

        BolsaProbador: {
                DisplayName: Bolsa del Probador
                Tooltip:
