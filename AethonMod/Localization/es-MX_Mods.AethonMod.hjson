        VoidCrownItem: {
                DisplayName: Corona de la Reina del Vacío
                Tooltip:
                        '''
                        La corona original del agujero negro carmesí, hoy cosmético portable.
                        Cinco arcos de neón carmesí con nudos naranjas arqueados JUSTO DETRÁS de tu cabeza.
                        Puro cosmético: sin estadísticas. Vale en huecos de accesorio o vanidad.
                        '''
                Titulo: "[c/FF1738:═══ CORONA DE LA REINA DEL VACÍO ═══]"
                Linea1:
                        '''
                        [c/FF66AA:Cinco lazos de neón carmesí→magenta con nudos naranja incandescentes,
                        arqueados JUSTO DETRÁS de tu cabeza]
                        '''
                Linea2:
                        '''
                        [c/78788C:La corona original del Agujero Negro Carmesí — retirada del proyectil
                        y hecha joya. Respira, se balancea y suelta ascuas rosas]
                        '''
                Linea3:
                        '''
                        [c/78788C:Puro cosmético: cero estadísticas. Equípala en cualquier hueco
                        de accesorio, funcional o de vanidad]
                        '''
        }

        RuneCrownItem: {
                DisplayName: Corona Rúnica Estelar
                Tooltip:
                        '''
                        Una corona nueva diseñada desde cero: ocho glifos rúnicos de luz fucsia
                        flotando en arco sobre tu cabeza, cada uno con su perla rosa pálido en la punta.
                        Puro cosmético: sin estadísticas. Vale en huecos de accesorio o vanidad.
                        '''
                Titulo: "[c/FF0055:═══ CORONA RÚNICA ESTELAR ═══]"
                Linea1:
                        '''
                        [c/FF66AA:Ocho glifos rúnicos de luz fucsia flotando en arco sobre tu cabeza,
                        cada uno con su perla rosa pálido en la punta]
                        '''
                Linea2:
                        '''
                        [c/78788C:La lanza, el cáliz, la puerta, la estrella, el rayo, el arco, la espiral
                        y el trono — escritura mágica que respira y suelta chispas ascendentes]
                        '''
                Linea3:
                        '''
                        [c/78788C:Puro cosmético: cero estadísticas. Equípala en cualquier hueco
                        de accesorio, funcional o de vanidad]
                        '''
        }

        SelloGenesisItem: {
                // v6.35: THE THREE ACCESSORIES OF THE MAGIC-SIGN LIBRARIES —
                // seals and rings that SURROUND THE PLAYER (SigiloLib + OrbitaLib).
                DisplayName: El Sello del Génesis
                Tooltip:
                        '''
                        Los signos mágicos del sol te rodean: el aro doble con las ocho runas girando,
                        y dentro el sello azul-estelar contrarrotando con el glifo del astro.
                        +40 de maná máximo, +8% de daño mágico y +4% de crítico mágico.
                        Vale en huecos de accesorio o de vanidad.
                        '''
                Titulo: "[c/FFD54F:═══ EL SELLO DEL GÉNESIS ═══]"
                Linea1:
                        '''
                        [c/FFC107:Los signos mágicos del sol te rodean: el aro doble con las ocho runas girando,
                        y dentro el sello azul-estelar contrarrotando con el glifo del astro]
                        '''
                Linea2: "[c/9FA8DA:+40 de maná máximo, +8% de daño mágico y +4% de crítico mágico]"
                Linea3:
                        '''
                        [c/78788C:La escritura solar vive en huecos de accesorio o de vanidad.
                        Firmada por las librerías de signos mágicos de la casa]
                        '''
        }

        AnillosSolRunicoItem: {
                DisplayName: Los Anillos del Sol Rúnico
                Tooltip:
                        '''
                        Siete aros rúnicos orbitan tu cuerpo en planos alternos:
                        par horario, impar antihorario, precesando vivos con sus runas a lomos.
                        +2 de regeneración de vida, +8% de daño melé, +3% de crítico melé y +3 de defensa.
                        Vale en huecos de accesorio o de vanidad.
                        '''
                Titulo: "[c/FFB74D:═══ LOS ANILLOS DEL SOL RÚNICO ═══]"
                Linea1:
