Buffs: {
	CosmicOrbBuff: {
		DisplayName: Cosmic Orb
		Description: A cosmic orb of light follows you and shoots at your enemies
	}

	NebulaJellyfishBuff: {
		DisplayName: Nebula Jellyfish
		Description: A nebula jellyfish drifts at your side on gravity pulses
	}

	StellarCometBuff: {
		DisplayName: Stellar Comet
		Description: A living comet orbits you and dive-bombs your enemies
	}

	LivingPulsarBuff: {
		DisplayName: Living Pulsar
		Description: A neutron star spins at your side, its beams raking your enemies
	}

	QuemaduraCosmica: {
		DisplayName: Cosmic Burn
		Description: The event horizon licks you: fire that burns inward
	}

	OcasoActivoBuff: {
		DisplayName: The Ocaso
		Description: The ocaso burns: 8 seconds of star-deaths at ×3 damage with execute
	}

	SobrecalentadoBuff: {
		DisplayName: Overheated
		Description: The staff smokes and stays silent: it won't fire while it cools
	}

	CriaEstelarBuff: {
		DisplayName: Star Hatchling
		Description: A star serpent hatchling swims by your side and hunts your enemies
	}

	FragmentoSupernovaBuff: {
		DisplayName: Supernova Fragment
		Description: A winged singularity hovers at your shoulder, firing bursts and beams at your enemies
	}
}

