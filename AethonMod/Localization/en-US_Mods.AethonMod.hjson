        // v6.22: THE PRIMORDIAL ECLIPSE
        "Projectiles.EclipsePrimordialProjectile.DisplayName": "Primordial Eclipse",

        // v6.19: the runic suns and the scepter's lightning bolt
        "Projectiles.RuneSunProjectile.DisplayName": "Runic Sun",
        "Projectiles.RunicLightning.DisplayName": "Runic Thunder",


        // v6.26 — The new arsenal: the reality tear, the real stars,
        // the stellar life cycle and the five creative staves
        "Items.DesgarroRealityStaff.DisplayName": "Reality Tear Staff",
        "Items.DesgarroRealityStaff.Tooltip": "Fires a TEAR in reality.\nThe rift pierces walls and damages along its line.\nWhen it closes it leaves a lingering rift that drains.\nWhile it lives, the wounded world darkens.",

        // v6.31 — THE SOWER: the anchoring pulsar of the stellar graveyard
        "Items.SembradorCementeralStaff.DisplayName": "Stellar Graveyard Sower",
        "Items.SembradorCementeralStaff.Tooltip": "Sows PULSARS that brake hard and anchor where you aim.\nEach pulsar spins up and sweeps with two opposite lighthouse beams.\nFull-power anchor strike; the beams bite without rest.\nMax 3 pulsars: the newest sowing eats the oldest.",

        // v6.31 — THE COLLAPSE: the star that brakes, trembles and bursts
        "Items.ColapsoMagnetarStaff.DisplayName": "Magnetar Collapse",
        "Items.ColapsoMagnetarStaff.Tooltip": "Fires a magnetar star that brakes until it nearly stops.\nThe harder the brake holds, the deadlier the STARQUAKE.\nThe ring only strikes with its FRONT and pierces armor.\nThe survivor enters overclock and dies in a final flash.",

        // v6.31 — THE TEARS: the orbital tear shotgun of the dying sun
        "Items.LagrimasSolMoribundoStaff.DisplayName": "Tears of the Dying Sun",
        "Items.LagrimasSolMoribundoStaff.Tooltip": "Sheds THREE TEARS from a dying sun.\nEach tear orbits for 2.5 s, kindling from charred to gold.\nThen it hunts without rest: up to 18 bites with cosmic burn.\nIt bursts into molten metal as it fades.",

        // v6.31 — THE DECREE: the eclipse circle that grows and executes
        "Items.DecretoEclipseStaff.DisplayName": "The Eclipse Decree",
        "Items.DecretoEclipseStaff.Tooltip": "Nails an ECLIPSE CIRCLE at the cursor.\nIt grows up to 660 px while alive and executes every 15 ticks:\nthe wave rides to the border and EVERYTHING inside is cut.\nClosest to the center pays ×4.8 · the eye contracts before the slash.",

        // v6.32 — W2-a: FOUR NEW COSMIC WEAPONS (comet, nova, quasar, loom)
        "Items.CometaErranteStaff.DisplayName": "The Wandering Comet",
        "Items.CometaErranteStaff.Tooltip": "Captures a comet in an ELLIPTICAL ORBIT around you for 6 laps.\nThe ice-fire core strikes at full power; the dust tail nips at ×0.4.\nThe tail ALWAYS points away from the orbit, like real comets.\nAfter 420 ticks it launches into the hunt and bursts into ice-fire.",
        "Items.NovaEncadenadaStaff.DisplayName": "The Chained Nova",
        "Items.NovaEncadenadaStaff.Tooltip": "A slow nova sphere that bursts on touching foe or ground.\nEach nova chains 3 daughters ×0.65 and 2 granddaughters ×0.42 — up to 3 generations.\nThe ring's FRONT is what strikes · zero chance: prey by distance.",
        "Items.VozCuasarStaff.DisplayName": "The Voice of the Quasar",
        "Items.VozCuasarStaff.Tooltip": "Summons a quasar that charges 40 ticks then unleashes a 460 px CONTINUOUS BEAM.\nThe beam PIERCES EVERYTHING · DOPPLER: leading edge blue, tail red.\nIt bounces once off walls · it dies with a flash.",
        "Items.TelarConstelacionesStaff.DisplayName": "The Constellation Loom",
        "Items.TelarConstelacionesStaff.Tooltip": "Each use nails a LITTLE STAR where your cursor was.\nThey connect themselves with threads of light: the constellation draws itself.\nWith 4 or more, every 30 ticks the FIGURE IGNITES:\nevery enemy inside the polygon takes ×2.2 per star.",

        // v6.33 — W2-b: FOUR MORE COSMIC WEAPONS (meteor shower, nebula, horizon, gamma ray)
        "Items.LluviaMeteorosStaff.DisplayName": "The Meteor Shower",
        "Items.LluviaMeteorosStaff.Tooltip": "Marks the cursor zone with a 30-tick amber telegraph.\nThen 8 meteors fall in staggered waves, one every 4 ticks, diagonal with fire trails.\nEach impact bursts ×1.0 in a 70 px radius and burns with cosmic burn for 3 s.",
        "Items.AbrazoNebulosaStaff.DisplayName": "The Nebula's Embrace",
        "Items.AbrazoNebulosaStaff.Tooltip": "Installs a nebula at the cursor: a magenta-cyan-violet cloud lasting 300 ticks.\nThose inside take ×0.06 every 3 ticks and are left SLOWED.\nBaby stars are born in its bosom and burst into ×0.8 mini-pops.\nOn death it dissipates into stardust.",
        "Items.FiloHorizonteStaff.DisplayName": "The Horizon's Edge",
        "Items.FiloHorizonteStaff.Tooltip": "Throws a black disc — an event horizon — with a photon line at its equator.\nIt pierces through enemies losing speed and returns like a boomerang.\nEvery hit leaves a mark that implodes 30 ticks later: ×0.7 + a pull.",
        "Items.RayoGammaStaff.DisplayName": "The Gamma Ray",
        "Items.RayoGammaStaff.Tooltip": "A thin 700 px beam crosses EVERYTHING instantly... but deals no damage yet.\nEvery enemy touched is marked with a glowing outline.\nAfter 30 ticks, ALL marks settle at once:\nclang, flash, ×1.0 damage and cosmic burn for 5 s.",

        "Items.NeutronStarStaff.DisplayName": "Neutron Star Staff",
        "Items.NeutronStarStaff.Tooltip": "A 12 px ultradense core.\n60 px aura with tripled damage.\nPeriodic starquakes shake the ground.\nGravity pulls it toward its prey.",
        "Items.PulsarStaff.DisplayName": "Pulsar Staff",
        "Items.PulsarStaff.Tooltip": "The cosmic lighthouse: two polar beams sweeping at 1 rev/s.\nEvery sweep that touches an enemy strikes hard.\nLight pulses synced to the spin.",
        "Items.WhiteDwarfStaff.DisplayName": "White Dwarf Staff",
        "Items.WhiteDwarfStaff.Tooltip": "The crystalline ember of an old star.\nSeven facets of cold light turning slowly.\nAn accretion ring that steals shine from nearby enemies.",
        "Items.DeadStarStaff.DisplayName": "Dead Star Staff",
        "Items.DeadStarStaff.Tooltip": "The black dwarf: what remains when all goes out.\nDark mass that devours light.\nConstant entropy around it.\nRune echoes at 0.2 Hz: the life it was.",
        "Items.RedSupergiantStaff.DisplayName": "Red Supergiant Staff",
        "Items.RedSupergiantStaff.Tooltip": "The dying 90 px colossus.\nConvection cells beating slowly.\nOn death it COLLAPSES and then erupts in a nova.",
        "Items.MagnetarStaff.DisplayName": "Magnetar Staff",
        "Items.MagnetarStaff.Tooltip": "The EXTREME neutron star.\nViolet magnetic field with twisted field lines.\nAutomatic lightning chains to enemies.\nIts heartbeat is a deterministic arrhythmia.",

        "Items.CicloEstelarStaff.DisplayName": "Stellar Cycle Staff",
        "Items.CicloEstelarStaff.Tooltip": "A star that LIVES a full life:\ncontracting nebula → ignition → red giant\n→ collapse and SUPERNOVA → neutron star.\nThe trail tells the story in five colors.",

        "Items.RelojArenaStaff.DisplayName": "Cosmic Hourglass Staff",
        "Items.RelojArenaStaff.Tooltip": "A living hourglass floating in the air.\nThe sand is light motes that fall and sting.\nWhen the chamber empties, time flips over.",
        "Items.MareaGravitatoriaStaff.DisplayName": "Gravitational Tide Staff",
        "Items.MareaGravitatoriaStaff.Tooltip": "A wave of light that rides the terrain.\nDrags enemies with the current.\nIf it hits a wall it breaks into three lesser waves.",
        "Items.EnjambrePrismaticoStaff.DisplayName": "Prismatic Swarm Staff",
        "Items.EnjambrePrismaticoStaff.Tooltip": "A core that bursts into twelve light wasps.\nThe swarm orbits and migrates from prey to prey.\nEach wasp stings with its own prismatic color.",
        "Items.PenduloJuicioStaff.DisplayName": "Pendulum of Judgment Staff",
        "Items.PenduloJuicioStaff.Tooltip": "A pendulum of light with real physics hanging in the air.\nEvery swing widens the arc of judgment.\nWhen released, the mace flies and explodes.",
        "Items.CoroEspectralStaff.DisplayName": "Spectral Choir Staff",
        "Items.CoroEspectralStaff.Tooltip": "Six notes of light singing in slow orbit.\nEach note emits its wave ring in turn.\nThe choir bids farewell going dark one by one.",

        "Projectiles.SembradorPulsarProjectile.DisplayName": "Graveyard Pulsar",
        "Projectiles.LagrimaSolarProjectile.DisplayName": "Solar Tear",
        "Projectiles.ColapsoMagnetarProjectile.DisplayName": "Collapsing Magnetar",
        "Projectiles.DecretoEclipseProjectile.DisplayName": "Eclipse Circle",
        "Projectiles.CometaErranteProjectile.DisplayName": "Wandering Comet",
        "Projectiles.NovaEncadenadaProjectile.DisplayName": "Chained Nova",
        "Projectiles.VozCuasarProjectile.DisplayName": "Voice of the Quasar",
        "Projectiles.TelarEstrellaProjectile.DisplayName": "Loom Star",
        "Projectiles.LluviaMeteorosProjectile.DisplayName": "Meteor Shower",
        "Projectiles.MeteoroProjectile.DisplayName": "Meteor",
        "Projectiles.AbrazoNebulosaProjectile.DisplayName": "Nebula's Embrace",
        "Projectiles.FiloHorizonteProjectile.DisplayName": "Horizon's Edge",
        "Projectiles.RayoGammaProjectile.DisplayName": "Gamma Ray",
        "Projectiles.NeutronStarProjectile.DisplayName": "Neutron Star",
        "Projectiles.PulsarProjectile.DisplayName": "Pulsar",
        "Projectiles.WhiteDwarfProjectile.DisplayName": "White Dwarf",
        "Projectiles.DeadStarProjectile.DisplayName": "Dead Star",
        "Projectiles.RedSupergiantProjectile.DisplayName": "Red Supergiant",
        "Projectiles.MagnetarProjectile.DisplayName": "Magnetar",
        "Projectiles.CicloEstelarProjectile.DisplayName": "Stellar Cycle",
        "Projectiles.RelojArenaProjectile.DisplayName": "Cosmic Hourglass",
        "Projectiles.MareaGravitatoriaProjectile.DisplayName": "Gravitational Tide",
        "Projectiles.MareaChicaProjectile.DisplayName": "Lesser Wave",
        "Projectiles.EnjambrePrismaticoProjectile.DisplayName": "Prismatic Swarm",
        "Projectiles.PenduloJuicioProjectile.DisplayName": "Pendulum of Judgment",
        "Projectiles.CoroEspectralProjectile.DisplayName": "Spectral Choir",
        "Projectiles.LanzaAlbaProjectile.DisplayName": "Dawn Lance",
        "Projectiles.RealityTearProjectile.DisplayName": "Reality Tear",
        "Projectiles.SinfoniaPrimordialProjectile.DisplayName": "Primordial Symphony",
        "Projectiles.TormentaNebularProjectile.DisplayName": "Nebular Storm",

        "Items.SuturaCuanticaStaff.DisplayName": "The Quantum Suture",
        "Items.SuturaCuanticaStaff.Tooltip": "Opens a GLITCH TEAR where you aim.\nCorrupts every enemy inside the circle.\nEvery 45 ticks fires quantum bolts at the 3 nearest.",
        "Items.PortalDimensionalStaff.DisplayName": "The Dimensional Portal",
        "Items.PortalDimensionalStaff.Tooltip": "Opens the ring gate where you aim.\nGentle pull within 300 px: whoever crosses the white core is shredded.\nThe portal breathes for 6 seconds.",
        "Items.PliegueEspacioStaff.DisplayName": "The Fold of Space",
        "Items.PliegueEspacioStaff.Tooltip": "Opens the EYE where you aim: the double ellipse with the black core.\nFolds space within 350 px and drags enemies in.\nWhoever touches the core is compressed.",
        "Items.HeridaElectricaStaff.DisplayName": "The Electric Wound",
        "Items.HeridaElectricaStaff.Tooltip": "Opens THE CRACK toward where you aim.\nStings in a line and applies ELECTRIFIED.\nThe current never cuts out.",

        // v6.35: THE FOUR NEW TEARS (second batch of references).
        "Items.CorazonColapsoStaff.DisplayName": "The Heart of the Collapse",
        "Items.CorazonColapsoStaff.Tooltip": "Ignites the FOUR-POINTED STAR of stellar fire.\nBurns every enemy inside the heart.\nEvery 30 ticks the filaments flare at the 2 closest.",

        "Items.GargantaVacioStaff.DisplayName": "The Throat of the Void",
        "Items.GargantaVacioStaff.Tooltip": "Opens the devouring vortex: absolute black core and magenta ring.\nThe lens bends the background and the pull drags within 320 px.\nWhoever touches the black core is devoured.",

        "Items.UmbralRotoStaff.DisplayName": "The Broken Threshold",
        "Items.UmbralRotoStaff.Tooltip": "Splits reality with a perfect horizontal cut.\nAbove, the void with the spectral skeleton; below, the world.\nStings in a line and every 60 ticks the other reality bites.",

        "Items.LeviatanEspectralStaff.DisplayName": "The Spectral Leviathan",
        "Items.LeviatanEspectralStaff.Tooltip": "Launches the ethereal bone creature: fourteen vertebrae swimming in S.\nPierces everything it touches and turns toward the nearest enemy.\n4 seconds of spectral swimming.",

        "Projectiles.DesgarroCuanticoProjectile.DisplayName": "Quantum Suture",
        "Projectiles.PortalDimensionalProjectile.DisplayName": "Dimensional Portal",
        "Projectiles.PliegueEspacioProjectile.DisplayName": "Fold of Space",
        "Projectiles.HeridaElectricaProjectile.DisplayName": "Electric Wound",
        "Projectiles.CorazonColapsoProjectile.DisplayName": "Heart of the Collapse",
        "Projectiles.GargantaVacioProjectile.DisplayName": "Throat of the Void",
        "Projectiles.UmbralRotoProjectile.DisplayName": "Broken Threshold",
        "Projectiles.LeviatanEspectralProjectile.DisplayName": "Spectral Leviathan",

        // v6.36: THE FOUR LIVING CODES (the image codes turned into
        // weapons) + THE RUNIC BACK RING.
        "Items.DanzaOrbesStaff.DisplayName": "The Dance of the Orbs",
        "Items.DanzaOrbesStaff.Tooltip": "Summons the living code of the chain: a miniature solar system orbiting you.\nEvery orb burns what it touches: sun x1.0, planets x0.7, moons x0.5.\n12 seconds of dance · one system at a time · no mana cost.",

        "Items.LenteAbismoStaff.DisplayName": "The Lens of the Abyss",
        "Items.LenteAbismoStaff.Tooltip": "Plants the living code of the black hole: a twenty-band disk,\na black horizon and bent stars falling in a spiral.\nThe lens bends the background · pull in 300 px · devours x1.2 · focuses and bites x0.6.",

        "Items.SolVivoStaff.DisplayName": "The Living Sun",
        "Items.SolVivoStaff.Tooltip": "Lights the living code of the sun: beating with the original's exact pulse.\nThe aura burns x0.55 · every pulse peak THUMPS x0.7 · prominences lash x0.85.\n5 seconds of sun · one sun at a time · no mana cost.",

        "Items.SierpeEstelarStaff.DisplayName": "The Star Serpent",
        "Items.SierpeEstelarStaff.Tooltip": "Releases the living code of the creature: sixteen segments — head,\ntwin fins and spine — swimming laps around your cursor.\nThe head pierces everything · the spine burns x0.4 · one serpent at a time.",

        "Items.AnilloRunicoDorsalItem.DisplayName": "The Runic Back Ring",
        "Items.AnilloRunicoDorsalItem.Tooltip": "The black hole's circle of conjuring hangs from your back:\nthe vortices' LITERAL runic triple crown — gold, counter-rotating\nviolet and intimate white beside the photon ring.\nPurely cosmetic: zero stats.",

        "Items.BolsaCodigosVivos.DisplayName": "Bag of Living Codes",
        "Items.BolsaCodigosVivos.Tooltip": "The image codes turned into weapons: the dance of the orbs,\nthe lens of the abyss, the living sun and the star serpent.\nEvery code learned to live here. Right-click to unfold them.\nOnly delivers what you are missing.",

        "Projectiles.DanzaOrbesProjectile.DisplayName": "Dance of the Orbs",
        "Projectiles.LenteAbismoProjectile.DisplayName": "Lens of the Abyss",
        "Projectiles.SolVivoProjectile.DisplayName": "Living Sun",
        "Projectiles.SierpeEstelarProjectile.DisplayName": "Star Serpent",

        // v6.38: THE SERPENT BROOD (10 new ways to move the same chain
        // + the hatchling minion — the original UNTOUCHED).
        "Items.OuroborosAstralStaff.DisplayName": "The Astral Ouroboros",
        "Items.OuroborosAstralStaff.Tooltip": "Twelve beads chase each other in a circle aiming ahead — nobody leads.\nEach bead sweeps x0.55; at expiry the spiral closes and DETONATES x2.0.\n10 seconds of ring · no mana cost.",

        "Items.CaravanaEspectralStaff.DisplayName": "The Spectral Caravan",
        "Items.CaravanaEspectralStaff.Tooltip": "The body repeats the lantern's EXACT trajectory: the path-memory.\nThe trail cleans the corridor x0.35 — with turns you draw S walls.\n9 seconds of caravan · no mana cost.",

        "Items.AnguilaSolarStaff.DisplayName": "The Solar Eel",
        "Items.AnguilaSolarStaff.Tooltip": "The body IS a formula: the eel's traveling wave, lambda ~= body length.\nCRESTS bite x1.0, troughs only x0.30 — graze with the crest.\n8 seconds of S-swimming · no mana cost.",

        "Items.CienpiesRunicoStaff.DisplayName": "The Runic Centipede",
        "Items.CienpiesRunicoStaff.Tooltip": "Twelve plates hugging the ground with a leg phase-shifted 45° each.\nPlanted legs leave their RUNE: the rune stings x0.40.\nThe gait raises its frequency far from prey · no mana cost.",

        "Items.FlageloEstelarStaff.DisplayName": "The Stellar Flagellum",
        "Items.FlageloEstelarStaff.Tooltip": "The Verlet whip with mass-weighted constraint: energy runs to the tip.\nThe tip strikes proportional to its speed (x0.5 -> x1.5); past 26 px/tick,\nTHE CRACK: x2.2 + screenshake. 8 seconds · no mana cost.",

        "Items.ViboraGenesiacaStaff.DisplayName": "The Genesis Viper",
        "Items.ViboraGenesiacaStaff.Tooltip": "One skeleton, two bodies: the serpent's spine and TWO braided strands.\nThe pearls burn x0.45; when the heading coils the helix compresses x1.6.\n9 seconds of viper · no mana cost.",

        "Items.BoaEclipseStaff.DisplayName": "The Eclipse Boa",
        "Items.BoaEclipseStaff.Tooltip": "The head draws the servo-spiral over the prey and the body wraps it.\nEach complete turn is a SQUEEZE stack: x0.5 -> x4.0.\nThe prey falls and it seeks the next. 10 seconds · no mana cost.",

        "Items.FarolGuardianStaff.DisplayName": "The Guardian Lantern",
        "Items.FarolGuardianStaff.Tooltip": "The base is a hanging lantern and the TIP chases the prey (FABRIK).\nThe hand bites x1.0 and the chain burns x0.40 — the body TENSES.\n12 seconds of guardian · no mana cost.",

        "Items.CintaAuroraStaff.DisplayName": "The Aurora Ribbon",
        "Items.CintaAuroraStaff.Tooltip": "The living banner: a spine anchored to your back and two incommensurable sines.\nThe ribbon cuts x0.5; the amplitude is YOUR SPEED — run and it whips.\n12 seconds of banner · no mana cost.",

        "Items.ManadaAstralStaff.DisplayName": "The Astral Pack",
        "Items.ManadaAstralStaff.Tooltip": "Six hunters with ELASTIC spacing and leadership that JUMPS.\nEach hunter strikes with ITS OWN speed: x0.55 -> x1.4.\n10 seconds of hunt · no mana cost.",

        "Items.CriaEstelarStaff.DisplayName": "The Star Hatchling",
        "Items.CriaEstelarStaff.Tooltip": "The star serpent's baby daughter: the SAME DNA, small and awake.\nAt rest she swims around you; on the hunt she charges (minion bite).\nTakes 1 minion slot · never expires · no mana cost.",

        "Items.BolsaSierpes.DisplayName": "Bag of Serpents",
        "Items.BolsaSierpes.Tooltip": "The star serpent and her eleven descendants: each swims differently.\nThe ring, the caravan, the eel, the centipede, the whip, the viper,\nthe boa, the lantern, the ribbon, the pack and the hatchling.\nOnly delivers what you are missing.",

        "Projectiles.OuroborosAstralProjectile.DisplayName": "Astral Ouroboros",
        "Projectiles.CaravanaEspectralProjectile.DisplayName": "Spectral Caravan",
        "Projectiles.AnguilaSolarProjectile.DisplayName": "Solar Eel",
        "Projectiles.CienpiesRunicoProjectile.DisplayName": "Runic Centipede",
        "Projectiles.FlageloEstelarProjectile.DisplayName": "Stellar Flagellum",
        "Projectiles.ViboraGenesiacaProjectile.DisplayName": "Genesis Viper",
        "Projectiles.BoaEclipseProjectile.DisplayName": "Eclipse Boa",
        "Projectiles.FarolGuardianProjectile.DisplayName": "Guardian Lantern",
        "Projectiles.CintaAuroraProjectile.DisplayName": "Aurora Ribbon",
        "Projectiles.ManadaAstralProjectile.DisplayName": "Astral Pack",
        "Projectiles.CriaEstelarMinion.DisplayName": "Star Hatchling",

        "Buffs.CriaEstelarBuff.DisplayName": "Star Hatchling",
        "Buffs.CriaEstelarBuff.Description": "A star serpent hatchling swims by your side and hunts your enemies",

        "Items.TajosAstralesStaff.DisplayName": "Staff of the Astral Cuts",
        "Items.TajosAstralesStaff.Tooltip": "Marks where you aim — ten ticks later THE CUT BLOOMS:\nseven white crescents in every direction, growing tip to tip.\nThe wound arrives when the slash appears (delayed causality).\nEach arc cuts its curved band once · no mana cost.",

        "Projectiles.TajoAstralProjectile.DisplayName": "Astral Slash",

        "Projectiles.AnillosSolaresHalo.DisplayName": "Solar Rings",
        "Projectiles.SelloGenesisHalo.DisplayName": "Genesis Seal",
        "Projectiles.AnilloRunicoDorsalHalo.DisplayName": "Dorsal Rune Ring",

        "Items.TomoApatiaNula.DisplayName": "Tome of Null Apathy",
        "Items.TomoApatiaNula.Tooltip": "The tome that feels nothing spits void tentacles:\nthey gestate for 2 seconds without harming (imploding pulses),\nthen lash out in three curves toward your cursor, teleporting\nbetween curves. Hits everything it touches (90×90) · each\nsuccessive hit weighs less.\nTEST WEAPON (exact replica of its study source).",

        "Projectiles.TentaculoCosmicoProjectile.DisplayName": "Void Tentacle",

        "Items.FragmentoSupernovaStaff.DisplayName": "Supernova Fragment",
        "Items.FragmentoSupernovaStaff.Tooltip": "The winged singularity made servant: the winged eye with\nafterimages orbiting and breathing around it (its signature).\nVOLLEY of 5 nova bursts in a fan · TELEGRAPHED beam of 900px (×2.5)\n· fire flower when each burst dies · no mana cost.\nMINION: takes 1 minion slot · never expires.\nTEST WEAPON (replica of the winged singularity boss).",

        "Projectiles.FragmentoSupernovaMinion.DisplayName": "Supernova Fragment",
        "Projectiles.RafagaNovaProjectile.DisplayName": "Nova Burst",

        "Buffs.FragmentoSupernovaBuff.DisplayName": "Supernova Fragment",
        "Buffs.FragmentoSupernovaBuff.Description": "A winged singularity hovers at your shoulder, firing bursts and beams at your enemies",

        "Items.BolsaHuespedes.DisplayName": "Bag of Guests",
        "Items.BolsaHuespedes.Tooltip": "The test replicas: the void tentacle, the supernova\nfragment and the astral cuts. Right click.\nOnly delivers what you're missing.",

        "Items.MetronomoPulsar.DisplayName": "The Pulsar Metronome",
        "Items.MetronomoPulsar.Tooltip": "The weapon that fires ON BEAT: the pulsar above your head ticks every 0.5s.\nPERFECT (±0.05s): guaranteed crit + double fan.\nGOOD (±0.1s): guaranteed crit. Off beat: the combo resets.\n8 hits in a row: THE LIGHTHOUSE — 3s of sweeping 900px beam.\nTEST WEAPON — no mana cost.",
        "Projectiles.MetronomoPulsarHalo.DisplayName": "Pulsar Metronome",
        "Projectiles.PulsoPulsarProjectile.DisplayName": "Pulsar Pulse",

        "Items.VelaSolar.DisplayName": "The Solar Sail",
        "Items.VelaSolar.Tooltip": "Hold: the photon sail unfurls and fire rate climbs\nfrom 12 to 30 shots/s with heat (damage ×1 → ×1.6).\nAt full heat: FUSION — 1.5s of ×2 plasma, then the sail melts (3s).\nReleasing in time keeps ~70% of the heat.\nTEST WEAPON — no mana cost.",
        "Projectiles.VelaSolarProjectile.DisplayName": "Solar Sail",
        "Projectiles.RafagaSolarProjectile.DisplayName": "Solar Burst",

        "Items.GuadanaDesgarro.DisplayName": "The Rend Reaper",
        "Items.GuadanaDesgarro.Tooltip": "The slash flies 220px and where it dies it opens A VERTICAL REALITY FISSURE (2s):\neverything crossing it bleeds, and enemy projectiles that touch it\nVANISH — it devours them and their damage joins YOUR NEXT SLASH.\nRight click: the fissure opens right at your cursor (≤480px).\nTEST WEAPON — no mana cost.",
        "Projectiles.TajoGuadanaProjectile.DisplayName": "Reaper Slash",
        "Projectiles.FisuraDesgarroProjectile.DisplayName": "Reality Fissure",

        "Items.EgidaNova.DisplayName": "The Nova Aegis",
        "Items.EgidaNova.Tooltip": "Left click: THE BASH — shield strike with knockback 9.\nRight click: RAISE GUARD (0.3s): a hit inside the perfect window\nDOES NOT EXIST — it detonates THE NOVA (3× + burn + 1s invulnerable).\nA guard that expires without a parry stuns you 0.5s. 8s cooldown (visible ring).\nTEST WEAPON — no mana cost.",
        "Projectiles.GuardiaNovaProjectile.DisplayName": "Nova Guard",
        "Projectiles.AnilloEnfriamientoProjectile.DisplayName": "Cooldown Ring",
        "Projectiles.NovaParryProjectile.DisplayName": "Parry Nova",
        "Projectiles.EmbestidaNovaProjectile.DisplayName": "Nova Bash",

        "Items.EcoCuantico.DisplayName": "The Quantum Echo",
        "Items.EcoCuantico.Tooltip": "Each pulse flies and decoheres into a seed that re-emits as an ECHO\nagainst the nearest enemy (60% · 36% · 21.6%: 2.17× per full chain).\nRight click: THE RESONANCE — all live seeds fire AT ONCE (5s cooldown).\nTEST WEAPON — no mana cost.",
        "Projectiles.PulsoEcoProjectile.DisplayName": "Quantum Pulse",

        "Items.VerboPrimordialStaff.DisplayName": "The Primordial Word",
        "Items.VerboPrimordialStaff.Tooltip": "The word that spoke the first light — SEVEN MOVEMENTS:\nI THE PULSE · II THE SEAL · III THE CROWN · IV THE STORM\nV THE FIRE · VI THE REND · VII THE SYMPHONY\nEach movement speaks with the libraries of the house; damage climbs ×1.0 → ×1.4\nand at the seventh second: THE DETONATION (2.5× + burn).\nTEST WEAPON — no mana cost.",
        "Projectiles.VerboPrimordialProjectile.DisplayName": "The Primordial Word",
        "Projectiles.VerboDetonacionProjectile.DisplayName": "Word Detonation",

        "Items.BolsaApuestas.DisplayName": "Bag of Bets",
        "Items.BolsaApuestas.Tooltip": "The five bets of the house (rhythm, cadence, zone,\nparry and echo) and THE PRIMORDIAL WORD that binds them. Right click.\nOnly delivers what you are missing.",

        "Common.LevelUp": "Your weapon has reached level {0}!",
        "Common.Milestone": "Milestone reached: {0}",

        "Items.PrismaDePaisajesItem.DisplayName": "The Landscape Prism",
        "Items.PrismaDePaisajesItem.Tooltip": "The sky library tester: each use unfurls AN ENTIRE LANDSCAPE\nover the world's background — layers with their own parallax, drift,\ndepth and their sky, light and brightness tints.\nCycle: Umbral Eclipse → Starfall Rain → Primordial Dawn → clear sky.\nTEST WEAPON — no mana cost.",
}
