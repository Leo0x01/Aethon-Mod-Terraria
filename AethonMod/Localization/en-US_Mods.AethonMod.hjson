	EclipsePrimordialStaff: {
		// v6.22: THE PRIMORDIAL ECLIPSE — the Sun of the 20 Rings fused
		// with ALL the black holes (light + mist + smoke + lightning)
		DisplayName: Bastón del Eclipse Primordial
		Tooltip: ""
	}

	SinfoniaPrimordialStaff: {
		// (v6.24: the FIRE VEIL and the STORM VEIL were removed — user request.)
		// v6.24: THE THREE LIBRARY WEAPONS — each one uses ALL of them
		// (StormLib lightning + BrumaFX smoke + LumenLib light + runes)
		DisplayName: Bastón de la Sinfonía Primordial
		Tooltip: ""
	}

	TormentaNebularStaff: {
		DisplayName: Cetro de la Tormenta Nebular
		Tooltip: The nebular storm sweeps the sky
	}

	LanzaAlbaStaff: {
		DisplayName: Lanza del Alba Rúnica
		Tooltip: The dawn spear rises over the wicked
	}

	StormRuneStaff: {
		// v6.19: THE THUNDER SCEPTER — the lightning weapon (LightningCore)
		DisplayName: Cetro del Trueno Rúnico
		Tooltip: ""
	}

	TruenoPerlinStaff: {
		// v6.50.17: THE PERLIN THUNDER SCEPTER — the noise-generated arc weapon
		DisplayName: Cetro del Trueno Perlin
		Tooltip: ""
	}

	RayoPrimordialStaff: {
		// v6.50.18: THE PRIMORDIAL LIGHTNING STAFF — vanilla 1.4.5 weather lightning
		DisplayName: Bastón del Rayo Primordial
		Tooltip:
			'''
			Invoca el rayo del clima de Terraria sobre el cursor.
			Cae de 1000 px · horquillas del propio canal · ola de energizado.
			Sin maná (arma de pruebas).
			'''
	}

	ArcoSobretensionStaff: {
		// v6.50.18: THE ARC SURGE STAFF — vanilla 1.4.5 Arc Surge port
		DisplayName: Arco de Sobretensión
		Tooltip:
			'''
			Descarga el arco rojo de la mano al cursor, instantáneo.
			El rayo del Arc Surge de Terraria: enganchado a tu mano.
			2 arcos extra a enemigos cercanos · electrifica.
			Sin maná (arma de pruebas).
			'''
	}

	VenaTruenoStaff: {
		// v6.50.24: THE THUNDER FANG — based on the reference's thunder-vein dragon
		DisplayName: Colmillo de Vena Trueno
		Tooltip:
			'''
			Convoca LA CAÍDA DEL DRAGÓN DE VENA TRUENO sobre el cursor.
			El trío del dragón (1 naranja + 2 amarillos) que cae del cielo.
			Telegrafiada: el golpe aterriza al final de la caída · cadena de 3.
			Sin maná (arma de pruebas).
			'''
	}

	BolsaArmasRayo: {
		// v6.50.18+24: THE LIGHTNING WEAPONS BAG — bag 18
		DisplayName: Bolsa de las Armas de Rayo
		Tooltip:
			'''
			El rayo de Terraria de verdad y todo el arsenal eléctrico.
			El clima (Rayo Primordial), el Arc Surge (Arco de Sobretensión),
			el dragón de venas de trueno y los cetros viejos.
			Clic derecho para desplegarlas. Solo entrega lo que te falte.
			'''
	}

	BolsaSombras: {
		// v6.50.63: THE SHADOWS BAG — bag 19 (THE GRIMOIRE'S MAWS — the 3 weapons the kit forgot)
		// v6.50.64: + THE FINAL PAGE (weapon 4 — the AAA evolution of the Shadow of the Page)
		// v6.50.69: THE TENTACLE FAMILY — the .68 concepts retired ("horrible"); now the Shadow + Lash/Bite/Brood
		DisplayName: Bolsa de las Sombras
		Tooltip:
			'''
			Las cuatro páginas de la sombra (el homenaje a las sombras devoradoras).
			La base intacta (La Sombra de la Página) y sus TRES HERMANAS
			de tentáculos: EL AZOTE (el látigo que cruje atravesándolo
			todo), LA MORDIDA (el glotón que mastica a mordidas de
			verdad) y LA CRÍA (la camada que vive en ti y caza sola).
			Todas exhalan bruma negra.
			A 1 de vida: el festín comienza — cada una con su firma.
			Clic derecho para desplegarlas. Solo entrega lo que te falte.
			'''
	}

	BolsaIdeasGrimorio: {
		// v6.50.19: THE SIX GRIMOIRE PROJECTILE IDEAS — bag 17
		DisplayName: Bolsa de las Ideas del Grimorio
		Tooltip:
			'''
			Los seis futuros del proyectil del grimorio.
			Cada idea EVOLUCIONA con el nivel del Grimorio del Eterno que lleves (6 · 12 · 20).
			Clic derecho para desplegarlas. Solo entrega lo que te falte.
			'''
	}

	IdeasFolioErrante: {
		DisplayName: El Folio Errante
		Tooltip:
			'''
			IDEA 1 para el proyectil del grimorio: LA PÁGINA.
			Una página que ondula y perfora (nivel 6: motas y más filo
			· nivel 12: se rompe en 3 mini-páginas homing
			· nivel 20: las rotas persiguen más duras).
			Sin maná — la evolución sigue al GRIMORIO que lleves encima.
			'''
	}

	IdeasPlumaPrimordial: {
		DisplayName: La Pluma Primordial
		Tooltip:
			'''
			IDEA 2: LA PLUMA QUE ESCRIBIÓ EL LIBRO.
			Dardo perforante (nivel 6: abanico de 3
			· nivel 12: al clavar ESCRIBE una runa que arde
			· nivel 20: la pluma ORO escribe EL VERSO — seis glifos secuenciales).
			Sin maná.
			'''
	}

	IdeasSelloErrante: {
		DisplayName: El Sello Errante
		Tooltip:
			'''
			IDEA 3: EL SELLO QUE CAMINA.
			Un círculo lento que detona en aro (nivel 6: seis pernos radiales
			· nivel 12: ENCADENA — nace un sello junto al siguiente enemigo
			· nivel 20: TRES sellos).
			Sin maná.
			'''
	}

	IdeasLenguaTinta: {
		DisplayName: La Lengua de Tinta
		Tooltip:
			'''
			IDEA 4: LA SIERPE DE TINTA.
			Una lengua que serpentea hacia la presa (nivel 6: 14 segmentos y más rápida
			· nivel 12: al morder SE BIFURCA en dos
			· nivel 20: LA HYDRA — tres lenguas desde el arranque).
			Sin maná.
			'''
	}

	IdeasOjoTexto: {
		DisplayName: El Ojo del Texto
		Tooltip:
			'''
			IDEA 5: EL OJO QUE LEE — el sucesor conceptual del proyectil actual.
			Un ojo homing que mira a su presa (nivel 6: dos pupilas lo escoltan
			· nivel 12: cada 80 t dispara un glifo a lo que lee
			· nivel 20: LA MIRADA — lee a TRES presas a la vez).
			Sin maná.
			'''
	}

	IdeasVersoVivo: {
		DisplayName: El Verso Vivo
		Tooltip:
			'''
			IDEA 6: LA PALABRA HECHA PROYECTIL.
			Glifos en formación que golpean por letra (nivel 6: la ola de 5
			· nivel 12: EL PALÍNDROMO — la palabra rebota y vuelve a golpear
			· nivel 20: LA SENTENCIA — 7 glifos en dos filas y EL PUNTO FINAL que detona).
			Sin maná.
			'''
	}

	DesgarroRealityStaff: {
		// v6.26 — The new arsenal: the reality tear, the real stars,
		// the stellar life cycle and the five creative staves
		DisplayName: Bastón del Desgarro en la Realidad
		Tooltip:
			'''
			Dispara un DESGARRO en la realidad.
			La grieta atraviesa paredes y daña con su línea.
			Al cerrarse deja una grieta persistente que drena.
			Mientras vive, el mundo se oscurece herido.
			'''
	}

	SembradorCementeralStaff: {
		// v6.31 — THE SOWER: the anchoring pulsar of the stellar graveyard
		DisplayName: Sembrador del Cementerio Estelar
		Tooltip:
			'''
			Siembra PÚLSARES que frenan en seco y se anclan donde apuntas.
			Cada púlsar gira acelerando y barre con dos haces-faro opuestos.
			Golpe de anclaje a plena potencia; los haces pican sin descanso.
			Máximo 3 púlsares: la nueva siembra se come a la más vieja.
			'''
	}

	ColapsoMagnetarStaff: {
		// v6.31 — THE COLLAPSE: the star that brakes, trembles and bursts
		DisplayName: El Colapso del Magnetar
		Tooltip:
			'''
			Dispara una estrella magnetar que frena hasta casi detenerse.
			Cuanto más aprieta el freno, más devasta el STARQUAKE.
			El anillo solo golpea con su FRENTE y perfora armaduras.
			La superviviente entra en overclock y muere en un destello.
			'''
	}

	LagrimasSolMoribundoStaff: {
		// v6.31 — THE TEARS: the orbital tear shotgun of the dying sun
		DisplayName: Las Lágrimas del Sol Moribundo
		Tooltip:
			'''
			Derrama TRES LÁGRIMAS de un sol moribundo.
			Cada lágrima orbita 2,5 s encendiéndose de chamuscado a oro.
			Luego caza sin descanso: hasta 18 mordiscos con quemadura cósmica.
			Al desvanecerse estalla en metal fundido.
			'''
	}

	DecretoEclipseStaff: {
		// v6.31 — THE DECREE: the eclipse circle that grows and executes
		DisplayName: El Decreto del Eclipse
		Tooltip:
			'''
			Clava un CÍRCULO DE ECLIPSE en el punto del cursor.
			Crece hasta 660 px mientras vive y ejecuta cada 15 ticks:
			la onda viaja al borde y TODO lo de dentro recibe el corte.
			El más cercano al centro paga ×4,8 · el ojo se contrae antes del tajo.
			'''
	}

	CometaErranteStaff: {
		// v6.32 — W2-a: FOUR NEW COSMIC WEAPONS (comet, nova, quasar, loom)
		DisplayName: El Cometa Errante
		Tooltip:
			'''
			Captura un cometa en ÓRBITA ELÍPTICA a tu alrededor durante 6 vueltas.
			El núcleo de hielo-fuego golpea a plena potencia; la cola de polvo pica a ×0.4.
			La cola apunta SIEMPRE hacia afuera de la órbita, como los cometas reales.
			Tras 420 ticks se lanza en cacería y estalla en hielo-fuego.
			'''
	}

	NovaEncadenadaStaff: {
		DisplayName: La Nova Encadenada
		Tooltip:
			'''
			Una esfera de nova lenta que estalla al tocar enemigo o suelo.
			Cada nova encadena 3 hijas ×0.65 y 2 nietas ×0.42 — hasta 3 generaciones.
			El frente del anillo es lo que golpea · cero azar: presas por distancia.
			'''
	}

	VozCuasarStaff: {
		DisplayName: La Voz del Cuásar
		Tooltip:
			'''
			Invoca un cuásar que carga 40 ticks y suelta un HAZ CONTINUO de 460 px.
			El haz PERFORA TODO · DOPPLER: el borde delantero azul, la cola roja.
			Rebota una vez en las paredes · muere con un destello.
			'''
	}

	TelarConstelacionesStaff: {
		DisplayName: El Telar de Constelaciones
		Tooltip:
			'''
			Cada uso clava una ESTRELLITA donde estaba tu cursor.
			Se conectan solas con hilos de luz: la constelación se dibuja sola.
			Con 4 o más, cada 30 ticks la FIGURA SE ENCIENDE:
			todo enemigo dentro del polígono recibe ×2.2 por estrella.
			'''
	}

	LluviaMeteorosStaff: {
		// v6.33 — W2-b: FOUR MORE COSMIC WEAPONS (meteor shower, nebula, horizon, gamma ray)
		DisplayName: La Lluvia de Meteoros
		Tooltip:
			'''
			Marca la zona del cursor con un telégrafo ámbar de 30 ticks.
			Luego caen 8 meteoros escalonados, uno cada 4 ticks, en diagonal con estela de fuego.
			Cada impacto estalla ×1.0 en radio 70 y quema con la quemadura cósmica 3 s.
			'''
	}

	AbrazoNebulosaStaff: {
		DisplayName: El Abrazo de la Nebulosa
		Tooltip:
			'''
			Instala una nebulosa en el cursor: nube magenta-cian-violeta de 300 ticks.
			Los de dentro reciben ×0.06 cada 3 ticks y quedan lentos.
			En su seno nacen estrellitas que revientan en mini-pops ×0.8.
			Al morir se disipa en polvo de estrellas.
			'''
	}

	FiloHorizonteStaff: {
		DisplayName: El Filo del Horizonte
		Tooltip:
			'''
			Lanza un disco negro — un horizonte de sucesos — con línea de fotón en el ecuador.
			Atraviesa a los enemigos perdiendo velocidad y vuelve como bumerán.
			Cada golpe deja una marca que implosiona 30 ticks después: ×0.7 + arrastre.
			'''
	}

	RayoGammaStaff: {
		DisplayName: El Rayo Gamma
		Tooltip:
			'''
			Un haz fino de 700 px cruza TODO al instante... pero aún no hace daño.
			Cada enemigo tocado queda marcado con un contorno brillante.
			Tras 30 ticks, todas las marcas liquidan a la vez:
			clang, destello, daño ×1.0 y quemadura cósmica 5 s.
			'''
	}

	NeutronStarStaff: {
		DisplayName: Bastón de la Estrella de Neutrones
		Tooltip:
			'''
			Un núcleo de 12 px ultradenso.
			Aura de 60 px con daño triplicado.
			Starquakes periódicos que sacuden el suelo.
			Gravita hacia sus presas.
			'''
	}

	PulsarStaff: {
		DisplayName: Bastón del Púlsar
		Tooltip:
			'''
			El faro cósmico: dos haces polares barriendo a 1 rev/s.
			Cada barrido que toca a un enemigo lo golpea con fuerza.
			Pulsos de luz sincronizados con el giro.
			'''
	}

	WhiteDwarfStaff: {
		DisplayName: Bastón de la Enana Blanca
		Tooltip:
			'''
			El rescoldo cristalino de una estrella vieja.
			Siete facetas de luz fría girando lento.
			Anillo de acreción que roba brillo a los enemigos cercanos.
			'''
	}

	DeadStarStaff: {
		DisplayName: Bastón de la Estrella Muerta
		Tooltip:
			'''
			La enana negra: lo que queda cuando todo se apaga.
			Masa oscura que devora la luz.
			Entropía constante en su alrededor.
			Ecos de runas a 0,2 Hz: la vida que fue.
			'''
	}

	RedSupergiantStaff: {
		DisplayName: Bastón de la Supergigante Roja
		Tooltip:
			'''
			El coloso moribundo de 90 px.
			Celdas de convección latiendo despacio.
			Al morir se COLAPSA y luego revienta en nova.
			'''
	}

	MagnetarStaff: {
		DisplayName: Bastón del Magnetar
		Tooltip:
			'''
			La estrella de neutrones EXTREMA.
			Campo magnético violeta con líneas retorcidas.
			Cadenas de rayo automáticas a los enemigos.
			El latido es una arritmia determinista.
			'''
	}

	CicloEstelarStaff: {
		DisplayName: Bastón del Ciclo Estelar
		Tooltip:
			'''
			Una estrella que VIVE una vida completa:
			nebulosa que se contrae → ignición → gigante roja
			→ colapso y SUPERNOVA → estrella de neutrones.
			La estela cuenta la historia en cinco colores.
			'''
	}

	RelojArenaStaff: {
		DisplayName: Bastón del Reloj de Arena Cósmico
		Tooltip:
			'''
			Un reloj de arena vivo flotando en el aire.
			La arena son motas de luz que caen y pican.
			Cuando la cámara se vacía, el tiempo se invierte.
			'''
	}

	MareaGravitatoriaStaff: {
		DisplayName: Bastón de la Marea Gravitatoria
		Tooltip:
			'''
			Una ola de luz que avanza pegada al terreno.
			Arrastra a los enemigos con la corriente.
			Si golpea una pared, se rompe en tres olas menores.
			'''
	}

	EnjambrePrismaticoStaff: {
		DisplayName: Bastón del Enjambre Prismático
		Tooltip:
			'''
			Un núcleo que revienta en doce avispas de luz.
			El enjambre orbita y migra de presa en presa.
			Cada avispa pica con su color del prisma.
			'''
	}

	PenduloJuicioStaff: {
		DisplayName: Bastón del Péndulo del Juicio
		Tooltip:
			'''
			Un péndulo de luz con física real colgado del aire.
			Cada vaivén amplía el arco del juicio.
			Al soltarse, la maza vuela y estalla.
			'''
	}

	CoroEspectralStaff: {
		DisplayName: Bastón del Coro Espectral
		Tooltip:
			'''
			Seis notas de luz cantando en órbita lenta.
			Cada nota emite su anillo de onda a su turno.
			El coro se despide apagándose de a una.
			'''
	}

	SuturaCuanticaStaff: {
		DisplayName: La Sutura Cuántica
		Tooltip:
			'''
			Abre un DESGARRO GLITCH donde apuntas.
			Corrompe a todo enemigo dentro del círculo.
			Cada 45 ticks dispara rayos cuánticos a los 3 más cercanos.
			'''
	}

	PortalDimensionalStaff: {
		DisplayName: El Portal Dimensional
		Tooltip:
			'''
			Abre la puerta de anillos donde apuntas.
			Succión suave en 300 px: el que cruza el núcleo blanco es triturado.
			El portal respira 6 segundos.
			'''
	}

	PliegueEspacioStaff: {
		DisplayName: El Pliegue del Espacio
		Tooltip:
			'''
			Abre el OJO donde apuntas: la doble elipse con el núcleo negro.
			Dobla el espacio en 350 px y arrastra a los enemigos.
			El que toca el núcleo es comprimido.
			'''
	}

	HeridaElectricaStaff: {
		DisplayName: La Herida Eléctrica
		Tooltip:
			'''
			Abre LA GRIETA hacia donde apuntas.
			Pica en línea y aplica ELECTRIFICADO.
			La corriente nunca se corta.
			'''
	}

	CorazonColapsoStaff: {
		// v6.35: THE FOUR NEW TEARS (second batch of references).
		DisplayName: El Corazón del Colapso
		Tooltip:
			'''
			Enciende la ESTRELLA DE CUATRO PUNTAS de fuego estelar.
			Quema a todo enemigo dentro del corazón.
			Cada 30 ticks los filamentos lanzan llamaradas a los 2 más cercanos.
			'''
	}

	GargantaVacioStaff: {
		DisplayName: La Garganta del Vacío
		Tooltip:
			'''
			Abre el vórtice devorador: núcleo negro absoluto y anillo magenta.
			La lente curva el fondo y la succión arrastra en 320 px.
			El que toca el núcleo negro es devorado.
			'''
	}

	UmbralRotoStaff: {
		DisplayName: El Umbral Roto
		Tooltip:
			'''
			Raja la realidad con un corte horizontal perfecto.
			Arriba el vacío con el esqueleto espectral; abajo, el mundo.
			Pica en línea y cada 60 ticks la otra realidad muerde.
			'''
	}

	LeviatanEspectralStaff: {
		DisplayName: El Leviatán Espectral
		Tooltip:
			'''
			Lanza a la criatura de hueso etéreo: catorce vértebras nadando en S.
			Atraviesa todo lo que toca y gira hacia el enemigo más cercano.
			4 segundos de nado espectral.
			'''
	}

	DanzaOrbesStaff: {
		// v6.36: THE FOUR LIVING CODES (the image codes turned into
		// weapons) + THE RUNIC BACK RING.
		DisplayName: La Danza de los Orbes
		Tooltip:
			'''
			Invoca el código vivo de la cadena: un minisistema solar orbitándote.
			Todo orbe quema al que toca: sol ×1.0, planetas ×0.7, lunas ×0.5.
			12 segundos de danza · un sistema a la vez · sin coste de maná.
			'''
	}

	LenteAbismoStaff: {
		DisplayName: La Lente del Abismo
		Tooltip:
			'''
			Planta el código vivo del agujero negro: disco de veinte bandas,
			horizonte negro y estrellas dobladas cayendo en espiral.
			La lente curva el fondo · succión en 300 px · devora ×1.2 · enfoca y muerde ×0.6.
			'''
	}

	SolVivoStaff: {
		DisplayName: El Sol Vivo
		Tooltip:
			'''
			Enciende el código vivo del sol: latiendo con el pulso exacto del original.
			El aura quema ×0.55 · cada pico del pulso LATE ×0.7 · las prominencias azotan ×0.85.
			5 segundos de sol · un sol a la vez · sin coste de maná.
			'''
	}

	SierpeEstelarStaff: {
		DisplayName: La Sierpe Estelar
		Tooltip:
			'''
			Libera el código vivo de la criatura: dieciséis segmentos — cabeza,
			aletas gemelas y espina — nadando en vueltas alrededor de tu cursor.
			La cabeza atraviesa todo · la espina quema ×0.4 · una sierpe a la vez.
			'''
	}

	AnilloRunicoDorsalItem: {
		DisplayName: El Anillo Rúnico Dorsal
		Tooltip:
			'''
			El círculo de conjuro del agujero negro cuelga de tu espalda:
			la triple corona rúnica LITERAL de los vórtices — dorada, violeta
			contrarrotante y blanca íntima junto al anillo de fotones.
			Puro cosmético: cero estadísticas.
			'''
		Titulo: "[c/FFC36B:═══ EL ANILLO RÚNICO DORSAL ═══]"
		Linea1:
			'''
			[c/FFE7B0:El círculo de conjuro del agujero negro cuelga de tu espalda: la triple
			corona rúnica LITERAL de los vórtices — ocho runas doradas girando con el conjunto]
			'''
		Linea2:
			'''
			[c/CDA8FF:seis runas violetas contrarrotando más afuera y el círculo blanco íntimo latiendo
			junto al anillo de fotones — runas de pie, respirando, con sus perlas]
			'''
		Linea3:
			'''
			[c/78788C:Puro cosmético: cero estadísticas. Equípalo en cualquier hueco
			de accesorio, funcional o de vanidad]
			'''
	}

	BolsaCodigosVivos: {
		DisplayName: Bolsa de los Códigos Vivos
		Tooltip:
			'''
			Los códigos de las imágenes hechos armas: la danza de los orbes,
			la lente del abismo, el sol vivo y la sierpe estelar.
			Cada código aprendió a vivir aquí. Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	OuroborosAstralStaff: {
		// v6.38: THE SERPENT BROOD (10 new ways to move the same chain
		// + the hatchling minion — the original UNTOUCHED).
		DisplayName: El Ouroboros Astral
		Tooltip:
			'''
			Doce cuentas se persiguen en círculo apuntando adelante — nadie manda.
			Cada cuenta barre ×0.55; al expirar la espiral se cierra y DETONA ×2.0.
			10 segundos de anillo · sin coste de maná.
			'''
	}

	CaravanaEspectralStaff: {
		DisplayName: La Caravana Espectral
		Tooltip:
			'''
			El cuerpo repite la trayectoria EXACTA del faro: el camino-memoria.
			El rastro limpia el pasillo ×0.35 — con giros dibujas muros en S.
			9 segundos de caravana · sin coste de maná.
			'''
	}

	AnguilaSolarStaff: {
		DisplayName: La Anguila Solar
		Tooltip:
			'''
			El cuerpo ES una fórmula: la onda viajera de la anguila, λ ≈ el cuerpo.
			Las CRESTAS muerden ×1.0, los valles solo ×0.30 — roza con la cresta.
			8 segundos de nado en S · sin coste de maná.
			'''
	}

	CienpiesRunicoStaff: {
		DisplayName: El Ciempiés Rúnico
		Tooltip:
			'''
			Doce placas pegadas al suelo con una pata desfasada Δφ=45° cada una.
			Las patas plantadas dejan su RUNA: la runa pica ×0.40.
			La marcha sube de frecuencia lejos de la presa · sin coste de maná.
			'''
	}

	FlageloEstelarStaff: {
		DisplayName: El Flagelo Estelar
		Tooltip:
			'''
			El látigo de Verlet con constraint por masa: la energía corre a la punta.
			La punta golpea ∝ su velocidad (×0.5 → ×1.5); sobre 26 px/tick,
			EL CHASQUIDO: ×2.2 + sacudida. 8 segundos · sin coste de maná.
			'''
	}

	ViboraGenesiacaStaff: {
		DisplayName: La Víbora Genesíaca
		Tooltip:
			'''
			Un esqueleto, dos cuerpos: la espina de la sierpe y DOS HEBRAS trenzadas.
			Las perlas queman ×0.45; al enroscar el rumbo la hélice se comprime ×1.6.
			9 segundos de víbora · sin coste de maná.
			'''
	}

	BoaEclipseStaff: {
		DisplayName: La Boa del Eclipse
		Tooltip:
			'''
			La cabeza hace la servo-espiral sobre la presa y el cuerpo la envuelve.
			Cada vuelta completa es un stack de APRIETE: ×0.5 → ×4.0.
			La presa cae y busca la siguiente. 10 segundos · sin coste de maná.
			'''
	}

	FarolGuardianStaff: {
		DisplayName: El Farol Guardián
		Tooltip:
			'''
			La base es un farol colgante y la PUNTA persigue a la presa (FABRIK).
			La mano muerde ×1.0 y la cadena quema ×0.40 — el cuerpo se TENSA.
			12 segundos de guardián · sin coste de maná.
			'''
	}

	CintaAuroraStaff: {
		DisplayName: La Cinta Aurora
		Tooltip:
			'''
			El estandarte vivo: la espina anclada a tu espalda y dos senos inconmensurables.
			La cinta corta ×0.5; la amplitud es TU VELOCIDAD — corre y se vuelve látigo.
			12 segundos de estandarte · sin coste de maná.
			'''
	}

	ManadaAstralStaff: {
		DisplayName: La Manada Astral
		Tooltip:
			'''
			Seis cazadores con distancia ELÁSTICA y liderazgo que SALTA.
			Cada cazador golpea con SU PROPIA velocidad: ×0.55 → ×1.4.
			10 segundos de cacería · sin coste de maná.
			'''
	}

	CriaEstelarStaff: {
		DisplayName: La Cría Estelar
		Tooltip:
			'''
			La hijita de la sierpe estelar: el MISMO ADN, pero cachorra y despierta.
			En reposo nada a tu alrededor; en caza embiste (mordida de esbirro).
			Ocupa 1 espacio de esbirro · nunca expira · sin coste de maná.
			'''
	}

	BolsaSierpes: {
		DisplayName: Bolsa de las Sierpes
		Tooltip:
			'''
			La sierpe estelar y sus once descendientes: cada una nada distinto.
			El anillo, la caravana, la anguila, el ciempiés, el látigo, la víbora,
			la boa, el farol, la cinta, la manada y la cría. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	TajosAstralesStaff: {
		DisplayName: El Bastón de los Tajos Astrales
		Tooltip:
			'''
			Marca el punto donde apuntas — y diez ticks después EL CORTE FLORECE:
			siete medias lunas blancas en todas direcciones, creciendo de punta a punta.
			La herida llega cuando el tajo aparece (causalidad retrasada).
			Cada arco corta una vez su banda curva · sin coste de maná.
			'''
	}

	TomoApatiaNula: {
		DisplayName: El Tomo de la Apatía Nula
		Tooltip:
			'''
			El tomo que ya no siente nada escupe tentáculos de vacío:
			maduran 2 segundos sin dañar (pulsos que implosionan) y luego azotan
			en tres curvas hacia tu mira, teletransportándose entre curva y curva.
			Golpea todo lo que toca (90×90) · cada impacto sucesivo pesa menos.
			ARMA DE PRUEBAS (réplica exacta de su fuente de estudio).
			'''
	}

	FragmentoSupernovaStaff: {
		DisplayName: El Fragmento de Supernova
		Tooltip:
			'''
			La singularidad alada hecha sirviente: el ojo alado con sus
			estelas fantasma orbitando y respirando a su alrededor (la firma).
			VOLEA de 5 ráfagas nova en abanico · HAZ telegrafiado de 900px (×2.5)
			· flor de fuego al morir cada ráfaga · sin coste de maná.
			ESBIRO: ocupa 1 espacio de esbirro · nunca expira.
			ARMA DE PRUEBAS (réplica del jefe de la singularidad alada).
			'''
	}

	BolsaHuespedes: {
		DisplayName: Bolsa de los Huéspedes
		Tooltip:
			'''
			Las réplicas de prueba: el tentáculo del vacío, el fragmento
			de supernova y los tajos astrales. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	MetronomoPulsar: {
		DisplayName: El Metrónomo de Púlsar
		Tooltip:
			'''
			El arma que dispara AL COMPÁS: el púlsar sobre tu cabeza late cada 0,5 s.
			PERFECT (±0,05 s): crítico garantizado + abanico doble.
			GOOD (±0,1 s): crítico garantizado. Fuera de compás: el combo se pierde.
			8 aciertos seguidos: EL FARO — 3 s de haz giratorio de 900 px.
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	VelaSolar: {
		DisplayName: La Vela Solar
		Tooltip:
			'''
			Mantén pulsado: la vela de fotones se despliega y la cadencia sube
			de 12 a 30 disparos/s con el calor (daño ×1 → ×1,6).
			Al calor pleno: LA FUSIÓN — 1,5 s de plasma ×2 y luego la vela se funde (3 s).
			Soltar a tiempo conserva ~70% del calor.
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	GuadanaDesgarro: {
		DisplayName: La Guadaña del Desgarro
		Tooltip:
			'''
			El tajo vuela 220 px y donde muere abre UNA FISURA VERTICAL de realidad (2 s):
			todo lo que la cruza sangra, y los proyectiles enemigos que la tocan
			DESAPARECEN — los traga y su daño se suma AL PRÓXIMO Tajo (EL HAMBRE).
			Clic der: la fisura se abre directamente en tu mira (≤480 px).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	EgidaNova: {
		DisplayName: La Égida de Nova
		Tooltip:
			'''
			Clic izq: EL EMBESTÓN — golpe de escudo con empujón 9.
			Clic der: ALZAR LA GUARDIA (0,3 s): un golpe en la ventana perfecta
			NO EXISTE — detona LA NOVA (3× + quemadura + 1 s invulnerable).
			La guardia que expira sin parar te aturde 0,5 s. Enfriamiento 8 s (anillo visible).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	EcoCuantico: {
		DisplayName: El Eco Cuántico
		Tooltip:
			'''
			Cada pulso vuela y decohiere en una semilla que se re-emite como ECO
			contra el enemigo más cercano (60% · 36% · 21,6%: 2,17× por cadena completa).
			Clic der: LA RESONANCIA — todas las semillas disparan A LA VEZ (5 s de recarga).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	VerboPrimordialStaff: {
		DisplayName: El Verbo Primordial
		Tooltip:
			'''
			La palabra que pronunció la primera luz — SIETE MOVIMIENTOS:
			I EL PULSO · II EL SELLO · III LA CORONA · IV LA TORMENTA
			V EL FUEGO · VI EL DESGARRO · VII LA SINFONÍA
			Cada movimiento habla con las bibliotecas de la casa; el daño crece ×1,0 → ×1,4
			y al séptimo segundo: LA DETONACIÓN (2,5× + quemadura).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	BolsaApuestas: {
		DisplayName: Bolsa de las Apuestas
		Tooltip:
			'''
			Las cinco apuestas de la casa (el ritmo, la cadencia, la zona,
			el parry y el eco) y EL VERBO PRIMORDIAL que las une. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	EsenciaDelReyGelatina: {
		DisplayName: Esencia del Rey Gelatina
		Tooltip:
			'''
			El alma dulce del trono que rueda.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelOjoDeCthulhu: {
		DisplayName: Esencia del Ojo de Cthulhu
		Tooltip:
			'''
			La vigilia hambrienta, soñando contigo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeDeerclops: {
		DisplayName: Esencia de Deerclops
		Tooltip:
			'''
			La escarcha ancestral del invierno caminante.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeLaAbejaReina: {
		DisplayName: Esencia de la Abeja Reina
		Tooltip:
			'''
			La miel real con aguijón.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelDevoradorDeMundos: {
		DisplayName: Esencia del Devorador de Mundos
		Tooltip:
			'''
			Cien fauces corrompidas en un hilo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelCerebroDeCthulhu: {
		DisplayName: Esencia del Cerebro de Cthulhu
		Tooltip:
			'''
			Los reflejos que gritan en rojo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeSkeletron: {
		DisplayName: Esencia de Skeletron
		Tooltip:
			'''
			La maldición copiada a mano alzada.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	// v6.50.61 — THE PURGE: the FOUR wardens' essences died with
	// their bosses (Hollow Titan, Rift Keeper, Stellar Archer, First
	// Bearer) — only the soul of the grimoire itself remains.
	
	EsenciaDeAethon: {
		DisplayName: Esencia de Aethon
		Tooltip:
			'''
			El alma del Grimorio Eterno — la página que el libro
			arranca de sí mismo al caer vencido: la PRUEBA superada.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			Solo 10 por mundo: ni el libro se rinde dos veces.
			'''
	}

	FormaAscendidaItem: {
		DisplayName: La Forma Ascendida
		Tooltip:
			'''
			El aura del grimorio mismo respirando a tu alrededor.
			La dejó caer Aethon al cerrar su prueba: el portador
			digno viste la luz del libro.
			The great double halo with its crown of stars, the
			writings under your feet and the golden feathers falling
			in your wake — the whole apotheosis. Wingless and
			beamless: the pure light that opens no heaven (v6.111).
			'''
	}

	FormaAscendidaDosItem: {
		DisplayName: La Forma Ascendida 2
		Tooltip:
			'''
			La apoteosis absoluta de la segunda luz.
			Las once capas de la Forma Ascendida, elevadas — más LA MANDORLA
			que te enmarca, LA CORONA DE DOCE ESTRELLAS, LOS SIETE
			CANDELEROS de la espalda y EL RÍO DE LUZ bajo tus pies.
			Las alas del serafín con el DOBLE de plumas y la extensión
			COMPLETA de arriba abajo: por encima de tu cabeza y por debajo
			de tus pies.
			Y VUELO INFINITO (como su hermana).
			'''
	}

	FormaAscendidaTresItem: {
		DisplayName: La Forma Ascendida 3
		Tooltip:
			'''
			EL TRONO — la tercera luz, la divinidad celestial canónica.
			EL ARCOÍRIS alrededor del trono girando en dos aros,
			EL MAR DE VIDRIO bajo tus pies, LAS SIETE LÁMPARAS DE FUEGO
			orbitándote y LAS RUEDAS DE OFANIM — ojos de luz girando
			en contra. Y detrás de ti, LA CRUZ DE LUZ de la Maiestas Domini —
			la columna del cielo y el brazo del horizonte.
			Las alas del serafín con sus 28 plumas PRISMÁTICAS — cada
			pluma, su color del arcoíris.
			Y VUELO INFINITO (como sus dos hermanas).
			'''
	}

	FormaAscendidaCuatroItem: {
		DisplayName: La Forma Ascendida 4
		Tooltip:
			'''
			EL SERAFÍN — la cuarta luz: EL QUE ARDE (Isaías 6).
			LAS SEIS ALAS — dos que cubren tu rostro, dos que cubren
			tus pies y dos con las que vuelas. EL CUERPO QUE ARDE con sus
			lenguas de fuego, EL HALO TRIPLE con el trisagión («santo,
			santo, santo»), LA CORONA DEL REY DE GLORIA con sus picos
			y joyas, LOS RAYOS DE DIOS girando detrás de ti, LA BRUMA
			SANTA que llena el templo y EL DESTELLO del corazón.
			La ILUMINACIÓN mayor de las cuatro formas — el que arde, ALUMBRA.
			Y VUELO INFINITO (como sus tres hermanas).
			'''
	}

	FormaAscendidaOchoItem: {
		DisplayName: The Ascended Form 8
		Tooltip:
			'''
			THE OPHANIM — the eighth light: THE WHEELS WITHIN WHEELS of Ezekiel.
			THREE RINGS turn, each in its own plane — the equatorial slow, the
			vertical PLANTED in place, the inner one fast — and along the rims
			travel EYES OF LIGHT that blink at their own rhythm and WATCH wherever
			you go; the RUNES of friction BURN upon the rings and THE THRONE'S FOOT
			shows its twelve marks beneath your feet.
			When you strike, the irises and the runes BURN.
			The wheels' palette: fire white at the core, living gold at the middle
			and ember violet at the rim — the forge become wheel.
			And INFINITE FLIGHT (like its four sisters).
			'''
	}

	HaloArcoirisItem: {
		DisplayName: El Halo Arcoíris
		Tooltip:
			'''
			EL ARCOÍRIS DE LA FORMA 3, DESTILADO (Ap 4:3).
			Nada de trono, nada de cruz, nada de mar de vidrio: SOLO
			LA BANDA de siete franjas — pequeña, alrededor de tu cabeza,
			girando despacito con sus doce perlas zodiacales de color.
			El aro del trono, hecho adorno. Y una luz blanca suave.
			'''
	}

	// v6.51.3 — THE RUNIC SUNS' SHINE (the 4-point twinkles of 3+ ring suns, made an adornment).
	BrilloSolarItem: {
		DisplayName: El Brillo de los Soles Rúnicos
		Tooltip:
			'''
			EL BRILLO ESPECIAL DE LOS SOLES RÚNICOS, DESTILADO.
			Solo LOS DESTELLOS DE 4 PUNTAS de los soles de 3 anillos
			en adelante — dos trazos de blanco incandescente cruzados
			y su corazón dorado, naciendo y muriendo alrededor de ti.
			Un trozo de sol caminando por el mundo.
			'''
	}

	BrasaDelEclipseItem: {
		DisplayName: La Brasa del Eclipse
		Tooltip:
			'''
			El cuarto tipo de aura: la BRUMA que oscurece.
			Humo negro de doble Perlin en los bordes, ORO fundido en
			el medio y un NÚCLEO ROJO que late — luz, bruma, desenfoque,
			distorsión, bloom y glow, TODO por código.
			'''
	}

	BolsaCategoria: {
		Titulo: "[c/{0}:{1}]"
		Linea1: "[c/E6B0FF:Clic derecho para desplegar esta categoría del arsenal]"
		Linea2: "[c/FFD66B:Solo entrega lo que te falte — reábrela cuando pierdas un arma]"
		Nota: "[c/78788C:{0}]"
		Abierta: La {0} se abre: {1} objetos nuevos.
		Completa: La {0} ya está completa contigo.
	}

	// v6.51.4 → v6.51.5 — THE SIX WORTHY CANDIDATES of the Grimoire (one weapon
	// per idea: the binary, the commas, the page, the eye, the line and
	// the bookmark) + THE BAG that delivers them.
	DignosEquinoccioBinario: {
		DisplayName: El Equinoccio Binario
		Tooltip: The Worthy's weapon: light and shadow in balance
	}

	BolsaProyectilesDignos: {
		DisplayName: La Bolsa de los Proyectiles Dignos
		Tooltip: ""
	}

	// v6.50.99/.102 — THE FOURTH WEAPON — DUAL OPTION B — THE CHOSEN ONE
	Equinoccio: {
		DisplayName: El Equinoccio
		Tooltip:
			'''
			«Mitad aurora, mitad eclipse.»
			LA ELEGIDA — OPCIÓN B DUAL: dos Nightglow vanilla por disparo.
			EL DORADO sale con LUZ de sol: halo dorado pulsante y ocho rayos
			giratorios. EL NEGRO es un eclipse limpio: disco oscuro con rim
			violeta pulsante y chispas de llama de sombra (la bruma murió).
			El día y la noche se separan sobre tu cabeza… y luego cazan.
			Sin maná (arma de pruebas).
			'''
	}

	// v6.50.99/.102 — THE EMPRESS BAG — bag 20 (the chosen one)
	BolsaEmperatriz: {
		DisplayName: Bolsa de la Emperatriz
		Tooltip:
			'''
			La elegida del estudio del proyectil de la Emperatriz de la Luz:
			EL EQUINOCCIO — el día y la noche en un libro. Las otras tres
			pruebas (el clon cósmico, el eco y el veredicto) cumplieron su
			misión y se retiraron.
			Clic derecho para desplegarla. Solo entrega lo que te falte.
			'''
	}

	// v6.50.128 — LA ESENCIA DEL ETERNO (v6.89 — el nombre nuevo: la
	// carta cósmica del grimorio, NO la del bioma de la corrupción —
	// la letra: «creo que mejor seria llamarlo de otra forma»)
	ItemCorrupto: {
		DisplayName: Esencia del Eterno
		Tooltip:
			'''
			Un residuo del poder del Eterno: la esencia que las criaturas
			destilan desde su llegada (y los jefes, a raudales).
			CÓMELA (clic): +0,1% de daño PERMANENTE a todo lo que hagas,
			hasta +100% con 1000 esencias — después, cada una es 1 oro.
			O suéltala DELANTE del grimorio seleccionado: el libro se la
			come para su DESPERTAR.
			'''
	}

	// v6.50.130 — THE CRATER MIST (the invisible item that IS the
	// mist: the portable corruption altar)
	BrumaDelCrater: {
		DisplayName: Bruma del cráter (vestigio)
		Tooltip:
			'''
			Un VESTIGIO de la vieja caída: la bruma que una vez fue altar.
			LA LLEGADA ya no la necesita — la corrupción vive en el apartado
			de creación mientras cargues el grimorio, y el Eterno devora las
			armas corruptas que sueltes con él en la mano.
			'''
	}

	ArmaCorruptaTag: (Consagrado)
	// v6.158 — the consecrated potion doubles what it does.
	PocionConsagrada: The consecration doubles its effect:
	PocionVidaDoble: life ×2
	PocionManaDoble: mana ×2
	PocionBuffDoble: duration ×2
	ArmaCorrupta1: +5% a TODAS sus estadísticas — daña más, empuja más, pega más rápido.
	ArmaCorrupta2: Ya no acepta prefijos ni reforge — el yunque le está cerrado para siempre.
	ArmaCorrupta3: Consagrada por el Eterno: suéltala con el grimorio EN LA MANO y él la devorará.

	// ================================================================
	//  v6.100 — LOS ÚLTIMOS DOS DEL ESCRIBA: el archivo de localización
	//  separado (Localization/Escriba/) MURIÓ con la purga de las
	//  armas muertas que arrastraba; sus dos ítems VIVOS (el Primer
	//  Trazo y la Aurora de Tinta) se mudaron AQUÍ con sus tooltips.
	// ================================================================
	
	PrimerTrazo: {
		DisplayName: El Primer Trazo
		Tooltip:
			'''
			La pluma que escribió la primera línea del mundo, cargada de luz.
			MANTÉN el clic: cinco trazos convergen en UN RAYO DE FUSIÓN
			(el arcoíris de aceite corre a lo largo, el núcleo arde blanco
			y el ruido fluye de la boca a la punta — la técnica del dios).
			A plena carga el daño se triplica.
			'''
		Prueba: SIN COSTE DE MANÁ — arma de prueba: canaliza sin miedo.
	}

	// v6.100 — the new weapons of the session (clickers, auras and the
	// definitive one — all made with THE HOUSE TOOLS: the forge, the
	// pixel engine and the multilayer wiring).
	SelloDeTinta: {
		DisplayName: The Scribe's Seal
		Tooltip: The grimoire's ink seal
	}

	ParpadeoDelEterno: {
		DisplayName: The Eternal's Blink
		Tooltip: The Eternal's blink: wherever you close your eyes
	}

	CoronaDePlumas: {
		DisplayName: The Crown of Feathers
		Tooltip: The Eternal's feather crown circles the wicked
	}

	DerrameDeTinta: {
		DisplayName: The Ink Spill
		Tooltip: The grimoire's ink spill covers the ground
	}

	LaUltimaPalabra: {
		DisplayName: The Last Word
		Tooltip: The Eternal's last word: the final silence
	}

	// v6.54.0 — LA INVESTIGACIÓN: LAS ALAS DE CÓDIGO (Task 74-a/b/c)
	
	BolsaDeAlasPrisma: {
		DisplayName: The Wings Bag
		Tooltip:
			'''
			        The FIVE code wings of the house (v6.113 — the purge): the
			        four runic pairs and the corollas of dawn, each with its
			        own palette, tempo and noise. Flight 240, no fall damage.
			        Right click to unfold them. Only delivers what is missing.
			'''
	}

	RayoConcentradoDos: {
		DisplayName: Rayo Concentrado 2
		Tooltip:
			'''
			EL ATAQUE DEFINITIVO: 300 ticks de carga absorbiendo soles
			rúnicos, 800 de láser — el cono de 3500 px con el plasma
			de la casa (CarnePlasma × SegundoRuido × RampaGlow +
			BitsChispa en doble AND) y EL GRADIENTE PRISMÁTICO que
			viaja a lo largo (el color del mod, de punta a punta).
			Círculos rúnicos de conjuro en la boca, temblor sostenido,
			música callada al 30 % y vuelo infinito mientras vive.
			'''
	}

	RayoPruebaC: {
		DisplayName: Rayo de Prueba C — El Sueño
		Tooltip:
			'''
			EL RAYO DE PRUEBA C — EL SUEÑO: LA GANADORA (las copias A y B
			murieron con la elección: esta ES la definitiva). El desenfoque
			máximo: bruma ambiental ×3.6, DOBLE envolvente de glow (×2.5 +
			×1.9), núcleo suave ×0.28 y 6 soles de 4 puntas con su núcleo
			blanco-violeta. El conducto onírico: todo fundido, como mirar
			el rayo a través de un velo.
			Y es EL HAZ DE LA IRA DE UN SER EXTERIOR: el ataque del
			despertar 50 del grimorio eterno — el círculo del escuadrón,
			la bruma blanco-morada, los círculos rúnicos y EL HAZ.
			'''
	}

	JuicioDosSoles: {
		DisplayName: The Judgment of the Two Suns
		Tooltip:
			'''
			THE DEFINITIVE ATTACK OF LIGHT AND DARKNESS: hold the click and the
			TWO RUNE SUNS are born — the WHITE SUN with its golden palette and
			the BLACK SUN with its violet rings — and they fly to the point you
			look at. They fuse into THE FUSED SUN, bigger and more devastating,
			swelling as it charges the sentence… and it BURSTS into THE NOVA:
			the double ring of golden mist, the rain of echo runes and the
			shockwave that strikes everything alive within 460 px.
			'''
	}

	TajoDelVacio: {
		// v6.124 — THE VOID SLASH: the beam-teardrop of the letter
		// ("usa un pequeño haz usando nuestros hazes, el inicio y final
		// del tajo tipo haz sera muy fino en el centro se vuelve mas
		// grueso... negro en el centro, morado en los bordes").
		DisplayName: The Void Slash
		Tooltip:
			'''
			THE BEAM-SLASH: each use stabs UP TO THREE SLASHES near your enemies
			(the closest to your cursor) — small beams THIN at both ends and THICK
			in the middle, with the BLACK core and the burning PURPLE edges: the
			void teardrop that stabs like a needle and pierces everything it touches.
			'''
	}

	BolsaSuperforja: {
		DisplayName: The Superforge Bag
		Tooltip:
			'''
			THE SUPERFORGE'S DEFINITIVE WEAPONS: The Judgment of the Two Suns (the
			two rune suns that fuse into the bigger, devastating sun and burst into
			the mist-and-rune nova) and The Void Slash (the beam-slashes, thin at
			the ends and thick in the middle — black core, burning purple edge —
			that stab near your enemies and pierce through them).
			'''
	}

	CetroDagasEterno: {
		DisplayName: Scepter of the Eternal Daggers
		Tooltip:
			'''
			THE SCEPTER OF THE FULL SQUADRON: one swing brings EVERYTHING
			at once. Its own counter summons THE 11 ETERNAL EYES AND the
			FIVE DAGGERS simultaneously — the eyes close their circle
			and the daggers ride their intimate ring (your bodyguard).
			The squadron's damage follows the grimoire (the Eternal law).
			'''
		Linea1: ✧ THE 11 EYES close their circle around the book's spirit.
		Linea2: ✧ THE 5 DAGGERS (Crystal · Flame · Rock · Void · Verdict) ride
		Linea3: their intimate ring, radius 32 — the guard inside the crown.
	}

	RenglonFinal: {
		DisplayName: El Renglón Final
		Tooltip:
			'''
			LA ÚLTIMA LÍNEA DEL GRIMORIO: mantén el clic en LA CITACIÓN
			(0,6 s — el reglón fantasma trazado entre dos plumas estelares)
			y el Eterno TIENDE EL RENGLÓN: una barra de tinta de 4.800 px
			que te ATRAVIESA y da UNA VUELTA ENTERA a la página borrando
			todo lo que toque (daño sostenido, 4 s). La tinta corre con
			grumo dendrítico a dos octavas, el charco dorado arde en el
			escritor, las plumas escupen chispas y la línea ondula viva.
			Al cerrar se contrae y estalla: EL PUNTO FINAL.
			'''
	}

	BolsaDefinitivas: {
		DisplayName: La Bolsa de las Armas Definitivas
		Tooltip:
			'''
			LOS ATAQUES DEFINITIVOS DE LA CASA: EL RAYO CONCENTRADO 2 (el
			cono de plasma de 3.500 px), EL SUEÑO (la copia ganadora — el
			haz de la Ira de un Ser Exterior) y EL RENGLÓN FINAL (la barra
			de tinta de 4.800 px que gira borrando la página entera).
			'''
	}

	ColmilloDoradoStaff: {
		DisplayName: El Colmillo Dorado
		Tooltip:
			'''
			R7 — los RAYOS DE ENERGÍA DEL CIELO: 3 rayos dorados sobre los
			enemigos más cercanos al cursor (presagio → doble bolt → ventana de
			daño → resplandor). Clic derecho: EL JUICIO DEL COLMILLO (6 rayos en
			anillo). Arma de pruebas: 0 maná.
			'''
	}

	SolEnMiniaturaStaff: {
		DisplayName: El Sol en Miniatura
		Tooltip:
			'''
			R3 — el sol en miniatura: un minion con núcleo térmico y 2 anillos
			dorados contra-rotantes; cada 45 ticks telegrafía y descarga su
			láser dorado. PERSISTENTE: sobrevive a la muerte y a salir de la
			partida (se despide con clic derecho en su buff).
			'''
	}

	MiradaDelEterno: {
		DisplayName: La Mirada del Eterno
		Tooltip:
			'''
			R8 — el rayo de energía: mantén el clic 0,75 s (la carga estelar) y
			suelta la RÁFAGA de 5.600 px que barre tras el ratón — núcleo rosa,
			espina dorada, filamentos dendríticos y latido de 14 Hz. 0 maná.
			'''
	}

	// v6.159 — the weapon of three weapons.
	TrioDelEterno: {
		DisplayName: The Eternal Trio
		Tooltip:
			'''
			The fused one's stand: holds up to THREE weapons and fires THEIR
			projectiles, one per turn. Right-click with a weapon in hand to
			insert it; right-click with an empty hand to extract the last one.
			'''
	}
	TrioVacio: The stand is empty — insert weapons with a right-click.
	TrioNoArma: That is not a weapon — the stand only holds weapons.
	TrioLleno: The stand already holds three weapons — extract one first (right-click with an empty hand).
	TrioInsertada: Weapon seated in slot {0}.
	TrioComo: Right-click: insert / extract. Left click: the weapon on duty fires.
	TrioLibre: (free)
	TrioRanura: Slot {0}: {1}

	BolsaInvestigaciones: {
		DisplayName: La Bolsa de las Investigaciones
		Tooltip:
			'''
			Lo que nació de las INVESTIGACIONES de la casa: primero los
			dos CLICKERS de la v6.82 (El Compás Rúnico y la Furia Solar),
			y de ahí en adelante TODO lo que nazca de estudiar el arte
			de los efectos: armas, altares y códices del Eterno.
			'''
	}

	BolsaAuras: {
		// v6.104 → v6.109: THE AURAS BAG — the aura research material
		// (the two dead banners OUT, the seven lights IN).
		DisplayName: The Auras Bag
		Tooltip:
			'''
			THE AURA RESEARCH MATERIAL: the AURA OF THE VOID (the one that
			burns even ghosts) and the SEVEN Ascended Forms — everything
			that AURAS, in one kit.
			'''
	}

	// v6.114 — THE DEFINITIVE COSMETIC (the letter: "time to create the
	// definitive cosmetic item… a single accessory").
	FormaEternaItem: {
		// v6.143 — THE TRUE ACCESSORY (the letter: make sure the
		// Eternal Form born at awakening 112 is the ACCESSORY — it
		// carries the VOID AURA effect with its burn, buffs and
		// debuffs).
		DisplayName: THE ETERNAL FORM
		Tooltip: ✦ THE VOID'S ACCESSORY — twelve parts built on the awakening, made one body
		Titulo: "[c/B96EEA:═══ THE ETERNAL FORM ═══]"
		Linea1: "[c/D9B3FF:WHAT IT IS: the Eterno's complete body, made an accessory. Twelve parts"
		Linea2: "[c/D9B3FF:built on the awakening (101-112) — each grew WORN by the bearer while using"
		Linea3: "[c/D9B3FF:the book; when the 12th arrived, THE MANIFESTATION erupted and the form was"
		Linea4: "[c/D9B3FF:CONVERTED into THIS accessory: glory, now portable.]"
		Linea5: The presence of a god made your own flesh: the way to witness
		Linea6: that power inside the bearer. Not a garment you wear: a presence
		Linea7: that uses the body as a hanger — wings that are not wings but the
		Linea8: silhouette of something larger, endless flight, the god's full
		Linea9: dress sewn onto a body that proved, door by door, it could bear
		Linea10: the cloth.
		Linea11: «Aethon waited for a mortal, and behind door 120 he found no
		Linea12: mortal: the only being in devoured creation that could finish the
		Linea13: ritual standing. When the bearer completes the Eternal Form, the hunger, for the first time, is not alone.»
	}

