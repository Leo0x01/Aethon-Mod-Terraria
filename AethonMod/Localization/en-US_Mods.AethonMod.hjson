	BolsaCategoria: {
		Titulo: "[c/{0}:{1}]"
		Linea1: "[c/E6B0FF:Right-click to deploy this category of the arsenal]"
		Linea2: "[c/FFD66B:Only delivers what you're missing — reopen it whenever you lose a weapon]"
		Nota: "[c/78788C:{0}]"
		Abierta: The {0} opens: {1} new items.
		Completa: The {0} is already complete with you.
	}
}

