}

Hambre: {
	Barra: Hunger {0}
	Calmado: The eye watches you, serene. It blinks when it wants.
	Inquieto: It blinks faster and faster… something is missing.
	Furioso: The iris ignites RED. The fury is coming.
	Maximo: IT IS HUNGRY. It never stops staring.
	Reinicio: The grimoire's appetite has calmed down.

	// v6.50.91 — THE NERVOUS ONE: restless, hungry, angry — "I want to
	// eat and it's hungry". Not fear: appetite with a voice.
	Nervioso: {
		Tranquilo: The hunter waits. It watches, patient, hungry.
		Hambriento: HUNGRY — at 25% it already wants out to hunt.
		Cazando: OUT HUNTING — it floats above you, seeking its own food.
		Impaciente: IMPATIENT — it's hungry and won't stop saying so.
		Frase1: I'm hungry…
		Frase2: I want to eat. NOW.
		Frase3: Are you feeding me today… or what?
		Frase4: I'm starving! HUNGRY!
		Frase5: HUNGER! HUNGER! HUNGER!
		SaleACazar: If you won't feed me, I'll go hunt for myself.
		Saciado: …satiated. For now.
		Absorbe: −{0}% hunger
		Nivel: Level {0} · XP {1}/{2}
	}
}

