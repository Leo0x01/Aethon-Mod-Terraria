Mods.AethonMod.DisplayName: Aethon, the Primordial Light

Items: {
	GenesisShard: {
		DisplayName: Genesis Shard
		Tooltip:
			'''
			Light weapon that fires homing particles.
			Material to craft the Grimoire of the Eternal.
			Drops from King Slime and Eye of Cthulhu.
			'''
	}

	AncientAltarItem: {
		DisplayName: Ancient Altar
		Tooltip: ""
	}

	ResonanceShard: {
		DisplayName: Resonance Shard
		Tooltip: Cosmic currency. Dropped by bosses.
	}

	GrimoireEternal: {
		DisplayName: Grimoire of the Eternal
		Tooltip:
			'''
			Hybrid magic/summon weapon.
			Left click: arcane bolt. Right click: summon minion.
			Earns REAL XP from every kill: the bestiary rarity (0–5 stars)
			sets its worth, the FIRST kill of each species pays ×3 and
			hardmode doubles creatures; bosses pay FIXED XP (base + 10% of
			their life + stars + a term that grows with your level).
			THREE STATES: held = full power; in the hotbar = still eats XP,
			keeps minion slots and life/mana (capped at +100); stored = nothing
			(already-summoned minions remain).
			No mana cost (testing).
			'''
	}

	BossSummonBag: {
		DisplayName: Summoner Bag
		Tooltip:
			'''
			Contains 999 of every boss summoner.
			Testing item — remove before release.
			'''
	}

	LevelUpTester: {
		DisplayName: Level Slayer
		Tooltip:
			'''
			Grants +10 levels to the Grimoire of the Eternal.
			Searches the whole inventory.
			Testing item — remove before release.
			'''
	}

	CarnadaDelGrimorio: {
		DisplayName: Grimoire Bait
		Tooltip:
			'''
			Triggers the WAVES OF HUNGER without waiting.
			Left click: unleash the fury (prepared waves).
			Right click: cycle 1..11 waves (11 = THE JUDGMENT: all 7 wardens ×15).
			Everything dying in wave k pays XP ×(k+1); the special, ×15.
			Testing item — remove before release.
			'''
	}

	CristalDelTitanHueco: {
		DisplayName: Hollow Titan Crystal
		Tooltip:
			'''
			A shard of the crystal colossus of the Sanctum.
			Summons the HOLLOW TITAN.
			ONLY WORKS BY DAY — the night belongs to the dead.
			'''
	}

	SelloDelRift: {
		DisplayName: Rift Seal
		Tooltip:
			'''
			The key of the one half here, half between worlds.
			Summons the RIFT KEEPER.
			ONLY WORKS BY DAY.
			'''
	}

	PlumaDeLaArquera: {
		DisplayName: Archer's Feather
		Tooltip:
			'''
			It fell from the sky when she tried to shoot Aethon down.
			Summons the ECHO OF THE STAR ARCHER.
			ONLY WORKS BY DAY.
			'''
	}

	SombraDelPortador: {
		DisplayName: Bearer's Shadow
		Tooltip:
			'''
			The silhouette of the first soul ever bound to a shard.
			Summons the ECHO OF THE FIRST BEARER.
			ONLY WORKS BY DAY.
			'''
	}

	NombreDeAethon: {
		DisplayName: The Name of Aethon
		Tooltip:
			'''
			'Go to the Hollow Sanctum and call its name.'
			Summons AETHON, THE PRIMORDIAL LIGHT.
			ONLY WORKS BY DAY.
			Five phases await — the final acknowledgment.
			'''
	}

	MedusaNebularStaff: {
		DisplayName: Nebula Jellyfish Staff
		Tooltip:
			'''
			Summons THE NEBULA JELLYFISH.
			A translucent bell holding a spiral galaxy, swimming on gravity pulses.
			Its stings leave the cold burn of the vacuum.
			'''
	}

	LivingCometStaff: {
		DisplayName: Living Comet Staff
		Tooltip:
			'''
			Summons THE STELLAR COMET.
			A living comet with a crown of 8 star-points, orbiting you on an eccentric ellipse.
			It DIVE-BOMBS enemies and bursts into a small nova.
			'''
	}

	LivingPulsarStaff: {
		DisplayName: Living Pulsar Staff
		Tooltip:
			'''
			Summons THE LIVING PULSAR.
			A neutron star spinning at your side, sweeping the battlefield with two lighthouse beams of radiation.
			Everything they cross is ELECTRIFIED.
			'''
	}

	BolsaProbador: {
		DisplayName: Tester's Bag
		Tooltip:
			'''
			Aethon's testing tools.
			Right-click to deploy them.
			Only delivers what you're missing.
			The bag is permanent: reopen it whenever you lose something.
			'''
	}

	BolsaFundacionales: {
		DisplayName: Founding Staves Bag
		Tooltip:
			'''
			The four staves that started it all.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaClasicosCosmicos: {
		DisplayName: Cosmic Classics Bag
		Tooltip:
			'''
			The primordial sun and its living creatures.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaAgujerosNegros: {
		DisplayName: Black Holes Bag
		Tooltip:
			'''
			Ten ways to devour the light.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaSolesRunicos: {
		DisplayName: Runic Suns Bag
		Tooltip:
			'''
			From the one-ring sun to the Grand Seal (all 20).
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaEstrellasReales: {
		DisplayName: Real Stars Bag
		Tooltip:
			'''
			Real physics turned into weapons (all 7).
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaArmasLibrerias: {
		DisplayName: Library Weapons Bag
		Tooltip:
			'''
			Each weapon is a concert of our VFX libraries (all 7).
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaBastonesCreativos: {
		DisplayName: Creative Staves Bag
		Tooltip:
			'''
			The gauge, the pendulum, the choir and other oddities (all 6).
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaExhumados: {
		DisplayName: Exhumed Bag
		Tooltip:
			'''
			The exhumed forms: the rancor and the eminence.
			The arsenal's original exhumed forms.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaCosmeticos: {
		DisplayName: Cosmetics Bag
		Tooltip:
			'''
			Crowns, seals and rings that sit upon your character.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaDosFormas: {
		DisplayName: Two Forms Bag
		Tooltip:
			'''
			The two-usage-form weapons: each one deploys its alternative form.
			The four that learned to say two things at once.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaDesgarros: {
		DisplayName: Tears Bag
		Tooltip:
			'''
			The staves that rip reality: suture, portal, fold, wound,
			heart, throat, threshold and leviathan. Each tear opens differently.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	RencorPrimordialStaff: {
		DisplayName: The Primordial Rancor
		Tooltip:
			'''
			The arsenal's exhumed form: THE PRIMORDIAL RANCOR.
			Pins a runic transmutation circle 380 px away.
			3 s of charge → THE CONTINUOUS white-core, pink-edged beam that pierces EVERYTHING.
			On wall contact: spectral arms (x0.66) and cinders (x0.33).
			Enemies caught by the beam disintegrate into ash. No mana.
			'''
	}

	EminenciaAtrozStaff: {
		DisplayName: The Gruesome Eminence
		Tooltip:
			'''
			The arsenal's exhumed form: THE GRUESOME EMINENCE.
			Hold to channel: the spirit congregation hovers near your cursor.
			14 s of accumulation → THE ABOMINATION, full control.
			Damage climbs from 100% to 185% as it accumulates.
			Release the channel and the mass decays and dissipates. No mana.
			'''
	}

	OcasoAethonStaff: {
		DisplayName: Ocaso of Aethon Staff
		Tooltip:
			'''
			The supreme gauge weapon: charge → burst → lockout.
			Every fragment hit charges the halo over your head.
			Full halo: RIGHT-CLICK ignites THE OCASO (8 s of ×3 star-deaths).
			Below 50% target health, death EXECUTES.
			Afterwards: 2 s overheat lockout. No mana.
			'''
	}

