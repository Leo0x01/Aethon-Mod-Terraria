	VoidCrownItem: {
		DisplayName: Crown of the Void Queen
		Tooltip:
			'''
			The original crown of the crimson black hole, now a wearable cosmetic.
			Five crimson neon arcs with orange knots arched JUST BEHIND your head.
			Pure cosmetic: no stats. Works in accessory or vanity slots.
			'''
		Titulo: "[c/FF1738:═══ CROWN OF THE VOID QUEEN ═══]"
		Linea1:
			'''
			[c/FF66AA:Five crimson→magenta neon ribbons with incandescent orange knots,
			arched JUST BEHIND your head]
			'''
		Linea2:
			'''
			[c/78788C:The original crown of the Crimson Black Hole — taken off the projectile
			and made into a jewel. It breathes, it sways, it sheds pink embers]
			'''
		Linea3:
			'''
			[c/78788C:Pure cosmetic: zero stats. Equip it in any accessory slot,
			functional or vanity]
			'''
	}

	RuneCrownItem: {
		DisplayName: Astral Rune Crown
		Tooltip:
			'''
			A new crown designed from scratch: eight runic glyphs of fuchsia light
			floating in an arc above your head, each tipped with a pale-pink pearl.
			Pure cosmetic: no stats. Works in accessory or vanity slots.
			'''
		Titulo: "[c/FF0055:═══ ASTRAL RUNE CROWN ═══]"
		Linea1:
			'''
			[c/FF66AA:Eight runic glyphs of fuchsia light floating in an arc above your head,
			each one with its pale-pink pearl at the tip]
			'''
		Linea2:
			'''
			[c/78788C:The lance, the chalice, the gate, the star, the bolt, the bow, the spiral
			and the throne — living script that breathes and sheds rising sparks]
			'''
		Linea3:
			'''
			[c/78788C:Pure cosmetic: zero stats. Equip it in any accessory slot,
			functional or vanity]
			'''
	}

	SelloGenesisItem: {
		// v6.35: THE THREE ACCESSORIES OF THE MAGIC-SIGN LIBRARIES —
		// seals and rings that SURROUND THE PLAYER (SigiloLib + OrbitaLib).
		DisplayName: The Seal of Genesis
		Tooltip:
			'''
			The sun's magic signs surround you: the double ring with its eight runes spinning,
			and inside, the star-blue seal counter-rotating with the glyph of the Astro.
			+40 max mana, +8% magic damage and +4% magic crit.
			Works in accessory or vanity slots.
			'''
		Titulo: "[c/FFD54F:═══ THE SEAL OF GENESIS ═══]"
		Linea1:
			'''
			[c/FFC107:The sun's magic signs surround you: the double ring with its eight runes spinning,
			and inside, the star-blue seal counter-rotating with the glyph of the Astro]
			'''
		Linea2: "[c/9FA8DA:+40 max mana, +8% magic damage and +4% magic crit]"
		Linea3:
			'''
			[c/78788C:The solar script lives in accessory or vanity slots alike.
			Signed by the house's magic-sign libraries]
			'''
	}

	AnillosSolRunicoItem: {
		DisplayName: The Rune Sun's Rings
		Tooltip:
			'''
			Seven rune rings orbit your body on alternating planes:
			even clockwise, odd counter-clockwise, precessing alive with runes riding each one.
			+2 life regeneration, +8% melee damage, +3% melee crit and +3 defense.
			Works in accessory or vanity slots.
			'''
		Titulo: "[c/FFB74D:═══ THE RUNE SUN'S RINGS ═══]"
		Linea1:
			'''
			[c/FFD180:Seven runic rings orbit your body on alternating planes:
			even clockwise, odd counter-clockwise, precessing alive with their runes riding along]
			'''
		Linea2: "[c/A7FFEB:+2 life regeneration, +8% melee damage, +3% melee crit and +3 defense]"
		Linea3:
			'''
			[c/78788C:Every third ring wears the cold star-blue of high-tier suns.
			The system lives in accessory or vanity slots alike]
			'''
	}

	AnillosHorizonteItem: {
		DisplayName: The Event Horizon Rings
		Tooltip:
			'''
			The accretion disk orbits you: twenty incandescent bands traveling,
			photons running the vortex and the horizon's fine ring.
			THE LENS: the background bends around you. THE PULL: nearby enemies drift toward you.
			+10% speed and +5% universal damage. Works in accessory or vanity slots.
			'''
		Titulo: "[c/FF7043:═══ THE EVENT HORIZON RINGS ═══]"
		Linea1:
			'''
			[c/FFAB91:The accretion disk orbits you: twenty incandescent bands traveling,
			photons running the vortex and the horizon's fine ring]
			'''
		Linea2: "[c/FF8A65:THE LENS: the background bends around you · THE PULL: nearby enemies slide toward you]"
		Linea3:
			'''
			[c/80CBC4:+10% speed and +5% universal damage.
			The rings live in accessory or vanity slots alike]
			'''
	}

