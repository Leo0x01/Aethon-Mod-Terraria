Mods.AethonMod.DisplayName: Aethon, the Eternal Grimoire

Items: {
	// v6.50.117 — GENESIS PURGE: Items.GenesisShard and
	// Items.AncientAltarItem died with the shard and the altar
	// (THE FALL is the only way to the Grimoire of the Eternal).
	
	ResonanceShard: {
		DisplayName: Resonance Shard
		Tooltip: Cosmic currency. Dropped by bosses.
	}

	GrimoireEternal: {
		DisplayName: Grimoire of the Eternal
		Tooltip:
			'''
				An old book that devours whatever its bearer kills.
				Keep its pages full... or your soul will be the one to fill the next.
			'''
	}

	BossSummonBag: {
		DisplayName: Summoner Bag
		Tooltip:
			'''
			Contains 999 of every boss summoner.
			Testing item — remove before publishing.
			'''
	}

	LevelUpTester: {
		DisplayName: Level Slayer
		Tooltip:
			'''
			Grants +10 levels to the Grimoire of the Eternal.
			Reusable — not consumed.
			Searches the whole inventory.
			Testing item — remove before publishing.
			'''
	}

	CarnadaDelGrimorio: {
		DisplayName: Grimoire Bait
		Tooltip:
			'''
			Triggers the WAVES OF HUNGER without waiting.
			Left click: unleash the fury (prepared waves).
			Right click: cycle 1..11 waves (11 = THE JUDGMENT: all 6 wardens ×15).
			Everything dying in wave k pays XP ×(k+1); the special, ×15.
			Testing item — remove before publishing.
			'''
	}

	EsenciaHambre: {
		DisplayName: Hunger Essence
		Tooltip:
			'''
			Raises the Eternal Grimoire's hunger +5% per use.
			The nervous clock tester — no waiting a full hour.
			Reusable — not consumed.
			Testing item — remove before publishing.
			'''
	}

	PaginaEnBlanco: {
		DisplayName: Blank Page
		Tooltip:
			'''
			Wipes the Eternal Grimoire's feast memory.
			Every boss type will debut its FIRST DINNER again.
			Also wipes the sky's mark: THE FALL will cross the
			bearer's first night once more.
			Reusable — not consumed.
			Testing item — remove before publishing.
			'''
	}

	// v6.50.75 — THE SCRIBE'S HOURGLASS: one click swaps day for night
	// and night for day (the user's request: "one click and it's day,
	// another click and it's night").
	
	RelojDeArenaDelEscriba: {
		DisplayName: The Scribe's Hourglass
		Tooltip:
			'''
			One click: if it's day, night falls; if it's night, dawn breaks.
			The sand is ink: the scribe wrote dawn and dusk with it.
			Works even mid-feast: the wave's sky crosses smoothly.
			Testing item — remove before publishing.
			'''
	}

	// v6.50.82 — THE HUNGRY GRIMOIRE: the Living Codex DEMO weapon.
	// User's letter: the hunger cycle compressed to 60 s.
	GrimorioHambriento: {
		DisplayName: Hungry Grimoire
		Tooltip:
			'''
			The Living Codex's eye: it watches, blinks and gets hungry.
			Its appetite grows from zero to FULL in one minute
			(test rate): blinking speeds up (from 10-20 s to
			every 2 s), the gaze grows restless and the golden
			iris ignites RED.
			Left click: opens THE INK RIFT — the book's OWN
			homing shot (testing, no mana).
			Right click: resets the appetite.
			Testing item — remove before publishing.
			'''
	}

	// v6.50.92 — THE FAMILY SHRINKS TO TWO (the user's letter:
	// "delete the unstable and the erratic hungry grimoire, keep
	// the original and the nervous one"): the Erratic (.87) and
	// the Unstable (.89) are DELETED; the Nervous one lives its
	// TWO LIVES from .91.
	GrimorioHambrientoNervioso: {
		DisplayName: Nervous Hungry Grimoire
		Tooltip:
			'''
			The HUNGRY copy — the same eye, but this book is
			APPETITE WITH A BODY: restless, angry, starving. Its
			hunger ALWAYS rises (test rate; the real one will be
			slower): only a devoured prey lowers it (−1%) and
			right click resets it.
			From 25% hunger on it hunts ON ITS OWN whenever you
			step away (AFK 5 s, or 30 s without attacking
			creatures with the book): it floats near you and its
			Page Shadow devours whatever creature moves nearby —
			it strikes WHENEVER IT WANTS: the moment it finishes
			one prey, it goes after the next one that moves.
			The feast is SELFISH: it eats the prey WHOLE, loot
			included — the XP belongs to THIS book (it raises its
			own level); you get nothing. While it is out, its
			attacks come FROM THE BOOK (your hand swings empty).
			It NEVER escapes: at 100% it just keeps floating
			near you, hunting on its own.
			Left click: opens THE INK RIFT — the book's OWN
			homing shot (testing, no mana).
			Right click: resets the appetite.
			Testing item — compare against the original.
			'''
	}

	// v6.50.62 — THE GRIMOIRE'S MAWS: the three shadow-devouring
	// weapons (test — the book is NOT touched). Pride's power (FMA:B).
	// v6.50.64 — the TWIN-HEAD pincer + the BLACK MIST on all three
	// ("the gif doubled at the tip, one per corner, so it behaves like
	// teeth" + "black mist on every tentacle and mouth").
	
	
	
	SombraDeLaPagina: {
		DisplayName: The Shadow of the Page
		Tooltip:
			'''
			"Written in ink of the Gate: eyes and teeth."
			The same tentacle maw, but 100% WRITTEN IN CODE — not a
			single sprite: the muscled mass, the eyes that snap open,
			the flesh that flows, ALL drawn by the engine.
			It rises FROM YOUR OWN BODY — fly or walk, the shadow goes
			WITH YOU —, hunts at any distance, bites and drains: the tip
			dissolves into BLACK MIST, and on the bite THE DEVOURER — the
			mass that COVERS the whole boss — swallows in pulse while its
			souls travel back to you through the body. At 1 HP: the feast.
			(Maw test weapon — v2.)
			'''
	}

	// v6.50.91 — THE LIVING CODEX WAS DELETED ENTIRELY (the user's word:
	// "El Codice Vivo lo puedes borrar por completo ya no es necesario").
	// Its levitation — the book that leaves your hands and hovers — now
	// lives in the NERVOUS GRIMOIRE's spirit (hunt — the escape died
	// in .94: the book never runs away).
	
	// v6.50.61 — THE PURGE: the FOUR wardens' summon items died with
	// their bosses (Hollow Titan Crystal, Rift Seal, Archer's Feather,
	// Bearer's Shadow).
	
	NombreDeAethon: {
		DisplayName: Fragments of a Distant Memory - Aethon
		Tooltip:
			'''
			"Not everything a book remembers fits on its pages.
			What fell out of them… is still hungry."
			Summons THE FRAGMENTS OF A DISTANT MEMORY: a dead god's
			light and darkness, falling on the world TOGETHER.
			While they live, noon never ends.
			Bring both down… and THE WHOLE MEMORY will remember
			who it was.
			'''
	}

	AethonMenorItem: {
		DisplayName: The Lesser Aethon
		Tooltip:
			'''
			A living spark of the grimoire itself.
			Summons THE LESSER AETHON — the light pet: a page of
			the book made creature, floating by your shoulder, crowned
			with pearls and shining with the rainbow of the tome.
			EQUIPS in the LIGHT pet slot of your equipment.
			'''
	}

	BolsaDeLaCria: {
		DisplayName: Brood Pouch
		Tooltip:
			'''
			Both pets of the house sleep inside: the memory PAIR
			(the brood of LIGHT and her DARK twin — the BOSS in
			miniature) and the LESSER GRIMOIRE (the BOOK in
			miniature, with its mini minions). Open it (right
			click) and both of them wake up.
			'''
		Abierta: Both pets awaken — the memory pair and the lesser grimoire follow you.
	}

	GrimorioMenorItem: {
		DisplayName: Lesser Grimoire
		Tooltip:
			'''
			The Eternal Grimoire… IN MINIATURE (the OTHER pet: the
			BOOK miniature, not the light boss).
			It floats by your shoulder with its eye awake; if you
			stand still too long it gets bored and flies off to
			PESTER the neighbors with its 3 mini minions and its
			page umbrella (1 damage, 10 hits max… then it gets
			bored again).
			EQUIPS in the pet slot of your equipment (and its
			eye is alive even in the icon).
			'''
	}

	TintaDelCometa: {
		DisplayName: Ink of the Arrival
		Tooltip:
			'''
			THE ARRIVAL'S ACTIVATOR (testing item — the Hatchling's Bag carries it).
			Break the vial and the world REMEMBERS: the Eternal Grimoire's
			mist is born again before you — day or night.
			The automatic paths keep their law (each player's first night in
			each world + the first neighbor who isn't the Guide); THIS ink
			is the MANUAL path: the event is NEVER lost… and it never
			duplicates your grimoire (if it already awaits you, the sky
			doesn't insist).
			'''
	}

	EcoDelDespertar: {
		DisplayName: Echo of Awakening
		Tooltip:
			'''
			THE TESTING KEY OF THE AWAKENING (non-consumable): each use
			wakes the grimoire ONE MORE LEVEL (full ceremony included — and
			at 20, the pet's little movie).
			The real path is the three offerings: corrupt essences, coins
			and the corrupted weapon of the rung… but a tester's key
			belongs to the tester.
			'''
	}

	MedusaNebularStaff: {
		DisplayName: Nebula Jellyfish Staff
		Tooltip:
			'''
			Summons THE NEBULA JELLYFISH.
			A translucent bell holding a spiral galaxy, swimming on gravity pulses.
			Its stings leave the cold burn of the vacuum.
			'''
	}

	LivingCometStaff: {
		DisplayName: Living Comet Staff
		Tooltip:
			'''
			Summons THE STELLAR COMET.
			A living comet with a crown of 8 star-points, orbiting you on an eccentric ellipse.
			It DIVE-BOMBS enemies and bursts into a small nova.
			'''
	}

	LivingPulsarStaff: {
		DisplayName: Living Pulsar Staff
		Tooltip:
			'''
			Summons THE LIVING PULSAR.
			A neutron star spinning at your side, sweeping the battlefield with two lighthouse beams of radiation.
			Everything they cross is ELECTRIFIED.
			'''
	}

	BolsaProbador: {
		DisplayName: Tester's Bag
		Tooltip:
			'''
			Aethon's testing tools.
			Right-click to deploy them.
			Only delivers what you're missing.
			The bag is permanent: reopen it whenever you lose something.
			'''
	}

	BolsaFundacionales: {
