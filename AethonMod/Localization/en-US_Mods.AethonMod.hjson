Buffs: {
	OjoEternoBuff: {
		DisplayName: Eyes of the Eternal
		Description: The grimoire's eyes hover in a crown and fire their misty black ray
	}

	AethonMenorBuff: {
		DisplayName: Lesser Aethon
		Description: A living spark of the grimoire itself lights your way with the rainbow
	}

	GrimorioMenorBuff: {
		DisplayName: Lesser Grimoire
		Description: A miniature grimoire floats by your shoulder — it gets bored, visits town and pesters the neighbors
	}

	NebulaJellyfishBuff: {
		DisplayName: Nebula Jellyfish
		Description: A nebula jellyfish drifts at your side on gravity pulses
	}

	StellarCometBuff: {
		DisplayName: Stellar Comet
		Description: A living comet orbits you and dive-bombs your enemies
	}

	LivingPulsarBuff: {
		DisplayName: Living Pulsar
		Description: A neutron star spins at your side, its beams raking your enemies
	}

	QuemaduraCosmica: {
		DisplayName: Cosmic Burn
		Description: The event horizon licks you: fire that burns inward
	}

	OcasoActivoBuff: {
		DisplayName: The Ocaso
		Description: The ocaso burns: 8 seconds of star-deaths at ×3 damage with execute
	}

	SobrecalentadoBuff: {
		DisplayName: Overheated
		Description: The staff smokes and stays silent: it won't fire while it cools
	}

	CriaEstelarBuff: {
		DisplayName: Star Hatchling
		Description: A star serpent hatchling swims by your side and hunts your enemies
	}

	FragmentoSupernovaBuff: {
		DisplayName: Supernova Fragment
		Description: A winged singularity hovers at your shoulder, firing bursts and beams at your enemies
	}
}

NPCs: {
	AethonBoss: {
		// v6.50.117 — THE MEMORY SPLIT IN TWO: the boss is now
		// "Fragments of a Distant Memory - Aethon" and fights as a
		// light+darkness pair; the fusion is THE WHOLE MEMORY.
		// v6.50.121 — THE MISSING RENAME: .117 left the OLD name
		// here — only the dark twin and the fusion had been renamed.
		DisplayName: Fragments of a Distant Memory - Aethon
		// v6.50.61 — THE PURGE (the letter: "delete every NPC of the mod,
		// keep only the main boss, Aethon; delete the other bosses and the
		// witness"): HollowTitan, RiftKeeper, EchoArcher, EchoBlade and
		// TheWitness died with their entries.
		// v6.50.45 — THE HUNTER OF THE BOSS'S PACK
		Bestiary: What is left of a dead god's mind: a memory that still burns. It controls time so night never falls while it exists.
	}

	AethonBossOscuro: {
		DisplayName: Fragments of a Distant Memory - Aethon
		Bestiary: The dark half of the memory. Its sun is dying: black on the outside, purple within, and it warms nothing.
	}

	AethonBossFusionado: {
		DisplayName: The Whole Memory - Aethon
		Bestiary: Both halves remembered being one. An eclipse with teeth: light and darkness no longer take turns.
	}

	CazadorAstral.DisplayName: Astral Hunter

	GrimorioDormido: {
		// v6.50.61 — THE PURGE (the letter: "delete every NPC of the mod,
		// keep only the main boss, Aethon; delete the other bosses and the
		// witness"): HollowTitan, RiftKeeper, EchoArcher, EchoBlade and
		// TheWitness died with their entries.
