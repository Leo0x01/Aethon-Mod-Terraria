	RayoPrimordialStaff: {
		// v6.50.18: THE PRIMORDIAL LIGHTNING STAFF — vanilla 1.4.5 weather lightning
		DisplayName: Primordial Lightning Staff
		Tooltip:
			'''
			Summons Terraria's weather lightning upon the cursor.
			Falls from 1000 px · self-forking channel · energizing wave.
			No mana (test weapon).
			'''
	}

	ArcoSobretensionStaff: {
		// v6.50.18: THE ARC SURGE STAFF — vanilla 1.4.5 Arc Surge port
		DisplayName: Overvoltage Arc
		Tooltip:
			'''
			Fires the crimson arc from hand to cursor, instant.
			Terraria's Arc Surge lightning: tethered to your hand.
			2 extra arcs at nearby enemies · electrifies.
			No mana (test weapon).
			'''
	}

	VenaTruenoStaff: {
		// v6.50.24: THE THUNDERVEIN FANG — based on Coralite's Thundervein Dragon
		DisplayName: Thundervein Fang
		Tooltip:
			'''
			Summons THE THUNDERVEIN DRAGON'S FALL upon the cursor.
			Coralite's trio (1 orange + 2 yellows) falling from the sky.
			Telegraphed: the strike lands at the end of the fall · chains to 3.
			No mana (test weapon).
			'''
	}

	BolsaArmasRayo: {
		// v6.50.18+24: THE LIGHTNING WEAPONS BAG — bag 18
		DisplayName: Lightning Weapons Bag
		Tooltip:
			'''
			Terraria's true lightning and the whole electric arsenal.
			The weather (Primordial Lightning), Arc Surge (Overvoltage Arc),
			Coralite's dragon (Thundervein) and the old scepters.
			Right-click to deploy them. Only delivers what you're missing.
			'''
	}

	BolsaSombras: {
		// v6.50.63: THE SHADOWS BAG — bag 19 (THE GRIMOIRE'S MAWS — the 3 weapons the kit forgot)
		// v6.50.64: + THE FINAL PAGE (weapon 4 — the AAA evolution of the Shadow of the Page)
		// v6.50.69: THE TENTACLE FAMILY — the .68 concepts retired ("horrible"); now the Shadow + Lash/Bite/Brood
		DisplayName: Bag of Shadows
		Tooltip:
			'''
			The four pages of the shadow (Pride style).
			The untouched base (The Shadow of the Page) and her THREE
			TENTACLE SISTERS: THE LASH (the whip that cracks through
			everything), THE BITE (the glutton that chews with real
			bites) and THE BROOD (the litter that lives on you and
			hunts alone). All of them exhale black bruma.
			At 1 HP: the feast begins — each with her own signature.
			Right-click to unfold them. Only gives what you're missing.
			'''
	}

	BolsaIdeasGrimorio: {
		// v6.50.19: THE SIX GRIMOIRE PROJECTILE IDEAS — bag 17
		DisplayName: Grimoire Ideas Bag
		Tooltip:
			'''
			The six futures of the grimoire's projectile.
			Each idea EVOLVES with the level of the Eternal Grimoire you carry (6 · 12 · 20).
			Right-click to deploy them. Only delivers what you're missing.
			'''
	}

	IdeasFolioErrante: {
		DisplayName: The Wandering Folio
		Tooltip:
			'''
			IDEA 1: THE PAGE.
			A waving, piercing page (level 6: ink motes and more bite · level 12: tears into 3 homing mini-pages · level 20: the torn ones hunt harder).
			No mana — evolution follows the GRIMOIRE you carry.
			'''
	}

	IdeasPlumaPrimordial: {
		DisplayName: The Primordial Quill
		Tooltip:
			'''
			IDEA 2: THE QUILL THAT WROTE THE BOOK.
			Piercing dart (level 6: fan of 3 · level 12: on hit it WRITES a burning rune · level 20: the GOLD quill writes THE VERSE — six sequential glyphs).
			No mana.
			'''
	}

	IdeasSelloErrante: {
		DisplayName: The Wandering Seal
		Tooltip:
			'''
			IDEA 3: THE SEAL THAT WALKS.
			A slow circle that detonates in a ring (level 6: six radial bolts · level 12: CHAINS — a new seal by the next enemy · level 20: THREE seals).
			No mana.
			'''
	}

	IdeasLenguaTinta: {
		DisplayName: The Ink Tongue
		Tooltip:
			'''
			IDEA 4: THE INK SERPENT.
			A tongue that slithers at prey (level 6: 14 segments and faster · level 12: FORKS on bite · level 20: THE HYDRA — three tongues from the start).
			No mana.
			'''
	}

	IdeasOjoTexto: {
		DisplayName: The Eye of the Text
		Tooltip:
			'''
			IDEA 5: THE EYE THAT READS — the conceptual successor of the current projectile.
			A homing eye that watches its prey (level 6: two pupil escorts · level 12: fires a glyph at what it reads · level 20: THE STARE — reads THREE prey at once).
			No mana.
			'''
	}

	IdeasVersoVivo: {
		DisplayName: The Living Verse
		Tooltip:
			'''
			IDEA 6: THE WORD AS PROJECTILE.
			Glyphs in formation striking per letter (level 6: the wave of 5 · level 12: THE PALINDROME — the word bounces back · level 20: THE SENTENCE — 7 glyphs in two rows and the detonating FINAL PERIOD).
			No mana.
			'''
	}

	DesgarroRealityStaff: {
		// v6.26 — The new arsenal: the reality tear, the real stars,
		// the stellar life cycle and the five creative staves
		DisplayName: Reality Tear Staff
		Tooltip:
			'''
			Fires a TEAR in reality.
			The rift pierces walls and damages along its line.
			When it closes it leaves a lingering rift that drains.
			While it lives, the wounded world darkens.
			'''
	}

	SembradorCementeralStaff: {
		// v6.31 — THE SOWER: the anchoring pulsar of the stellar graveyard
		DisplayName: Stellar Graveyard Sower
		Tooltip:
			'''
			Sows PULSARS that brake hard and anchor where you aim.
			Each pulsar spins up and sweeps with two opposite lighthouse beams.
			Full-power anchor strike; the beams bite without rest.
			Max 3 pulsars: the newest sowing eats the oldest.
			'''
	}

	ColapsoMagnetarStaff: {
		// v6.31 — THE COLLAPSE: the star that brakes, trembles and bursts
		DisplayName: Magnetar Collapse
		Tooltip:
			'''
			Fires a magnetar star that brakes until it nearly stops.
			The harder the brake holds, the deadlier the STARQUAKE.
			The ring only strikes with its FRONT and pierces armor.
			The survivor enters overclock and dies in a final flash.
			'''
	}

	LagrimasSolMoribundoStaff: {
		// v6.31 — THE TEARS: the orbital tear shotgun of the dying sun
		DisplayName: Tears of the Dying Sun
		Tooltip:
			'''
			Sheds THREE TEARS from a dying sun.
			Each tear orbits for 2.5 s, kindling from charred to gold.
			Then it hunts without rest: up to 18 bites with cosmic burn.
			It bursts into molten metal as it fades.
			'''
	}

	DecretoEclipseStaff: {
		// v6.31 — THE DECREE: the eclipse circle that grows and executes
		DisplayName: The Eclipse Decree
		Tooltip:
			'''
			Nails an ECLIPSE CIRCLE at the cursor.
			It grows up to 660 px while alive and executes every 15 ticks:
			the wave rides to the border and EVERYTHING inside is cut.
			Closest to the center pays ×4.8 · the eye contracts before the slash.
			'''
	}

	CometaErranteStaff: {
		// v6.32 — W2-a: FOUR NEW COSMIC WEAPONS (comet, nova, quasar, loom)
		DisplayName: The Wandering Comet
		Tooltip:
			'''
			Captures a comet in an ELLIPTICAL ORBIT around you for 6 laps.
			The ice-fire core strikes at full power; the dust tail nips at ×0.4.
			The tail ALWAYS points away from the orbit, like real comets.
			After 420 ticks it launches into the hunt and bursts into ice-fire.
			'''
	}

	NovaEncadenadaStaff: {
		DisplayName: The Chained Nova
		Tooltip:
			'''
			A slow nova sphere that bursts on touching foe or ground.
			Each nova chains 3 daughters ×0.65 and 2 granddaughters ×0.42 — up to 3 generations.
			The ring's FRONT is what strikes · zero chance: prey by distance.
			'''
	}

	VozCuasarStaff: {
		DisplayName: The Voice of the Quasar
		Tooltip:
			'''
			Summons a quasar that charges 40 ticks then unleashes a 460 px CONTINUOUS BEAM.
			The beam PIERCES EVERYTHING · DOPPLER: leading edge blue, tail red.
			It bounces once off walls · it dies with a flash.
			'''
	}

	TelarConstelacionesStaff: {
		DisplayName: The Constellation Loom
		Tooltip:
			'''
			Each use nails a LITTLE STAR where your cursor was.
			They connect themselves with threads of light: the constellation draws itself.
			With 4 or more, every 30 ticks the FIGURE IGNITES:
			every enemy inside the polygon takes ×2.2 per star.
			'''
	}

	LluviaMeteorosStaff: {
		// v6.33 — W2-b: FOUR MORE COSMIC WEAPONS (meteor shower, nebula, horizon, gamma ray)
		DisplayName: The Meteor Shower
		Tooltip:
			'''
			Marks the cursor zone with a 30-tick amber telegraph.
			Then 8 meteors fall in staggered waves, one every 4 ticks, diagonal with fire trails.
			Each impact bursts ×1.0 in a 70 px radius and burns with cosmic burn for 3 s.
			'''
	}

	AbrazoNebulosaStaff: {
		DisplayName: The Nebula's Embrace
		Tooltip:
			'''
			Installs a nebula at the cursor: a magenta-cyan-violet cloud lasting 300 ticks.
			Those inside take ×0.06 every 3 ticks and are left SLOWED.
			Baby stars are born in its bosom and burst into ×0.8 mini-pops.
			On death it dissipates into stardust.
			'''
	}

	FiloHorizonteStaff: {
		DisplayName: The Horizon's Edge
		Tooltip:
			'''
			Throws a black disc — an event horizon — with a photon line at its equator.
			It pierces through enemies losing speed and returns like a boomerang.
			Every hit leaves a mark that implodes 30 ticks later: ×0.7 + a pull.
			'''
	}

	RayoGammaStaff: {
		DisplayName: The Gamma Ray
		Tooltip:
			'''
			A thin 700 px beam crosses EVERYTHING instantly... but deals no damage yet.
			Every enemy touched is marked with a glowing outline.
			After 30 ticks, ALL marks settle at once:
			clang, flash, ×1.0 damage and cosmic burn for 5 s.
			'''
	}

	NeutronStarStaff: {
		DisplayName: Neutron Star Staff
		Tooltip:
			'''
			A 12 px ultradense core.
			60 px aura with tripled damage.
			Periodic starquakes shake the ground.
			Gravity pulls it toward its prey.
			'''
	}

	PulsarStaff: {
		DisplayName: Pulsar Staff
		Tooltip:
			'''
			The cosmic lighthouse: two polar beams sweeping at 1 rev/s.
			Every sweep that touches an enemy strikes hard.
			Light pulses synced to the spin.
			'''
	}

	WhiteDwarfStaff: {
		DisplayName: White Dwarf Staff
		Tooltip:
			'''
			The crystalline ember of an old star.
			Seven facets of cold light turning slowly.
			An accretion ring that steals shine from nearby enemies.
			'''
	}

	DeadStarStaff: {
		DisplayName: Dead Star Staff
		Tooltip:
			'''
			The black dwarf: what remains when all goes out.
			Dark mass that devours light.
			Constant entropy around it.
			Rune echoes at 0.2 Hz: the life it was.
			'''
	}

	RedSupergiantStaff: {
		DisplayName: Red Supergiant Staff
		Tooltip:
			'''
			The dying 90 px colossus.
			Convection cells beating slowly.
			On death it COLLAPSES and then erupts in a nova.
			'''
	}

	MagnetarStaff: {
		DisplayName: Magnetar Staff
		Tooltip:
			'''
			The EXTREME neutron star.
			Violet magnetic field with twisted field lines.
			Automatic lightning chains to enemies.
			Its heartbeat is a deterministic arrhythmia.
			'''
	}

	CicloEstelarStaff: {
		DisplayName: Stellar Cycle Staff
		Tooltip:
			'''
			A star that LIVES a full life:
			contracting nebula → ignition → red giant
			→ collapse and SUPERNOVA → neutron star.
			The trail tells the story in five colors.
			'''
	}

	RelojArenaStaff: {
		DisplayName: Cosmic Hourglass Staff
		Tooltip:
			'''
			A living hourglass floating in the air.
			The sand is light motes that fall and sting.
			When the chamber empties, time flips over.
			'''
	}

	MareaGravitatoriaStaff: {
		DisplayName: Gravitational Tide Staff
		Tooltip:
			'''
			A wave of light that rides the terrain.
			Drags enemies with the current.
			If it hits a wall it breaks into three lesser waves.
			'''
	}

	EnjambrePrismaticoStaff: {
		DisplayName: Prismatic Swarm Staff
		Tooltip:
			'''
			A core that bursts into twelve light wasps.
			The swarm orbits and migrates from prey to prey.
			Each wasp stings with its own prismatic color.
			'''
	}

	PenduloJuicioStaff: {
		DisplayName: Pendulum of Judgment Staff
		Tooltip:
			'''
			A pendulum of light with real physics hanging in the air.
			Every swing widens the arc of judgment.
			When released, the mace flies and explodes.
			'''
	}

	CoroEspectralStaff: {
		DisplayName: Spectral Choir Staff
		Tooltip:
			'''
			Six notes of light singing in slow orbit.
			Each note emits its wave ring in turn.
			The choir bids farewell going dark one by one.
			'''
	}

	SuturaCuanticaStaff: {
		DisplayName: The Quantum Suture
		Tooltip:
			'''
			Opens a GLITCH TEAR where you aim.
			Corrupts every enemy inside the circle.
			Every 45 ticks fires quantum bolts at the 3 nearest.
			'''
	}

	PortalDimensionalStaff: {
		DisplayName: The Dimensional Portal
		Tooltip:
			'''
			Opens the ring gate where you aim.
			Gentle pull within 300 px: whoever crosses the white core is shredded.
			The portal breathes for 6 seconds.
			'''
	}

	PliegueEspacioStaff: {
		DisplayName: The Fold of Space
		Tooltip:
			'''
			Opens the EYE where you aim: the double ellipse with the black core.
			Folds space within 350 px and drags enemies in.
			Whoever touches the core is compressed.
			'''
	}

	HeridaElectricaStaff: {
		DisplayName: The Electric Wound
		Tooltip:
			'''
			Opens THE CRACK toward where you aim.
			Stings in a line and applies ELECTRIFIED.
			The current never cuts out.
			'''
	}

	CorazonColapsoStaff: {
		// v6.35: THE FOUR NEW TEARS (second batch of references).
		DisplayName: The Heart of the Collapse
		Tooltip:
			'''
			Ignites the FOUR-POINTED STAR of stellar fire.
			Burns every enemy inside the heart.
			Every 30 ticks the filaments flare at the 2 closest.
			'''
	}

	GargantaVacioStaff: {
		DisplayName: The Throat of the Void
		Tooltip:
			'''
			Opens the devouring vortex: absolute black core and magenta ring.
			The lens bends the background and the pull drags within 320 px.
			Whoever touches the black core is devoured.
			'''
	}

	UmbralRotoStaff: {
		DisplayName: The Broken Threshold
		Tooltip:
			'''
			Splits reality with a perfect horizontal cut.
			Above, the void with the spectral skeleton; below, the world.
			Stings in a line and every 60 ticks the other reality bites.
			'''
	}

	LeviatanEspectralStaff: {
		DisplayName: The Spectral Leviathan
		Tooltip:
			'''
			Launches the ethereal bone creature: fourteen vertebrae swimming in S.
			Pierces everything it touches and turns toward the nearest enemy.
			4 seconds of spectral swimming.
			'''
	}

	DanzaOrbesStaff: {
		// v6.36: THE FOUR LIVING CODES (the image codes turned into
		// weapons) + THE RUNIC BACK RING.
		DisplayName: The Dance of the Orbs
		Tooltip:
			'''
			Summons the living code of the chain: a miniature solar system orbiting you.
			Every orb burns what it touches: sun x1.0, planets x0.7, moons x0.5.
			12 seconds of dance · one system at a time · no mana cost.
			'''
	}

	LenteAbismoStaff: {
		DisplayName: The Lens of the Abyss
		Tooltip:
			'''
			Plants the living code of the black hole: a twenty-band disk,
			a black horizon and bent stars falling in a spiral.
			The lens bends the background · pull in 300 px · devours x1.2 · focuses and bites x0.6.
			'''
	}

	SolVivoStaff: {
		DisplayName: The Living Sun
		Tooltip:
			'''
			Lights the living code of the sun: beating with the original's exact pulse.
			The aura burns x0.55 · every pulse peak THUMPS x0.7 · prominences lash x0.85.
			5 seconds of sun · one sun at a time · no mana cost.
			'''
	}

	SierpeEstelarStaff: {
		DisplayName: The Star Serpent
		Tooltip:
			'''
			Releases the living code of the creature: sixteen segments — head,
			twin fins and spine — swimming laps around your cursor.
			The head pierces everything · the spine burns x0.4 · one serpent at a time.
			'''
	}

	AnilloRunicoDorsalItem: {
		DisplayName: The Runic Back Ring
		Tooltip:
			'''
			The black hole's circle of conjuring hangs from your back:
			the vortices' LITERAL runic triple crown — gold, counter-rotating
			violet and intimate white beside the photon ring.
			Purely cosmetic: zero stats.
			'''
		Titulo: "[c/FFC36B:═══ THE RUNIC BACK RING ═══]"
		Linea1:
			'''
			[c/FFE7B0:The black hole's circle of conjuring hangs from your back: the vortices'
			LITERAL triple runic crown — eight golden runes spinning with the ensemble]
			'''
		Linea2:
			'''
			[c/CDA8FF:six violet runes counter-rotating farther out and the intimate white circle pulsing
			beside the photon ring — runes standing upright, breathing, each with its pearl]
			'''
		Linea3:
			'''
			[c/78788C:Pure cosmetic: zero stats. Equip it in any accessory slot,
			functional or vanity]
			'''
	}

	BolsaCodigosVivos: {
		DisplayName: Bag of Living Codes
		Tooltip:
			'''
			The image codes turned into weapons: the dance of the orbs,
			the lens of the abyss, the living sun and the star serpent.
			Every code learned to live here. Right-click to unfold them.
			Only delivers what you are missing.
			'''
	}

	OuroborosAstralStaff: {
		// v6.38: THE SERPENT BROOD (10 new ways to move the same chain
		// + the hatchling minion — the original UNTOUCHED).
		DisplayName: The Astral Ouroboros
		Tooltip:
			'''
			Twelve beads chase each other in a circle aiming ahead — nobody leads.
			Each bead sweeps x0.55; at expiry the spiral closes and DETONATES x2.0.
			10 seconds of ring · no mana cost.
			'''
	}

	CaravanaEspectralStaff: {
		DisplayName: The Spectral Caravan
		Tooltip:
			'''
			The body repeats the lantern's EXACT trajectory: the path-memory.
			The trail cleans the corridor x0.35 — with turns you draw S walls.
			9 seconds of caravan · no mana cost.
			'''
	}

	AnguilaSolarStaff: {
		DisplayName: The Solar Eel
		Tooltip:
			'''
			The body IS a formula: the eel's traveling wave, lambda ~= body length.
			CRESTS bite x1.0, troughs only x0.30 — graze with the crest.
			8 seconds of S-swimming · no mana cost.
			'''
	}

	CienpiesRunicoStaff: {
		DisplayName: The Runic Centipede
		Tooltip:
			'''
			Twelve plates hugging the ground with a leg phase-shifted 45° each.
			Planted legs leave their RUNE: the rune stings x0.40.
			The gait raises its frequency far from prey · no mana cost.
			'''
	}

	FlageloEstelarStaff: {
		DisplayName: The Stellar Flagellum
		Tooltip:
			'''
			The Verlet whip with mass-weighted constraint: energy runs to the tip.
			The tip strikes proportional to its speed (x0.5 -> x1.5); past 26 px/tick,
			THE CRACK: x2.2 + screenshake. 8 seconds · no mana cost.
			'''
	}

	ViboraGenesiacaStaff: {
		DisplayName: The Genesis Viper
		Tooltip:
			'''
			One skeleton, two bodies: the serpent's spine and TWO braided strands.
			The pearls burn x0.45; when the heading coils the helix compresses x1.6.
			9 seconds of viper · no mana cost.
			'''
	}

	BoaEclipseStaff: {
		DisplayName: The Eclipse Boa
		Tooltip:
			'''
			The head draws the servo-spiral over the prey and the body wraps it.
			Each complete turn is a SQUEEZE stack: x0.5 -> x4.0.
			The prey falls and it seeks the next. 10 seconds · no mana cost.
			'''
	}

	FarolGuardianStaff: {
		DisplayName: The Guardian Lantern
		Tooltip:
			'''
			The base is a hanging lantern and the TIP chases the prey (FABRIK).
			The hand bites x1.0 and the chain burns x0.40 — the body TENSES.
			12 seconds of guardian · no mana cost.
			'''
	}

	CintaAuroraStaff: {
		DisplayName: The Aurora Ribbon
		Tooltip:
			'''
			The living banner: a spine anchored to your back and two incommensurable sines.
			The ribbon cuts x0.5; the amplitude is YOUR SPEED — run and it whips.
			12 seconds of banner · no mana cost.
			'''
	}

	ManadaAstralStaff: {
		DisplayName: The Astral Pack
		Tooltip:
			'''
			Six hunters with ELASTIC spacing and leadership that JUMPS.
			Each hunter strikes with ITS OWN speed: x0.55 -> x1.4.
			10 seconds of hunt · no mana cost.
			'''
	}

	CriaEstelarStaff: {
		DisplayName: The Star Hatchling
		Tooltip:
			'''
			The star serpent's baby daughter: the SAME DNA, small and awake.
			At rest she swims around you; on the hunt she charges (minion bite).
			Takes 1 minion slot · never expires · no mana cost.
			'''
	}

	BolsaSierpes: {
		DisplayName: Bag of Serpents
		Tooltip:
			'''
			The star serpent and her eleven descendants: each swims differently.
			The ring, the caravan, the eel, the centipede, the whip, the viper,
			the boa, the lantern, the ribbon, the pack and the hatchling.
			Only delivers what you are missing.
			'''
	}

	TajosAstralesStaff: {
		DisplayName: Staff of the Astral Cuts
		Tooltip:
			'''
			Marks where you aim — ten ticks later THE CUT BLOOMS:
			seven white crescents in every direction, growing tip to tip.
			The wound arrives when the slash appears (delayed causality).
			Each arc cuts its curved band once · no mana cost.
			'''
	}

	TomoApatiaNula: {
		DisplayName: Tome of Null Apathy
		Tooltip:
			'''
			The tome that feels nothing spits void tentacles:
			they mature for 2 seconds without harming (imploding pulses),
			then lash out in three curves toward your cursor, teleporting
