        "Items.CrimsonBlackHoleStaff.DisplayName": "Void Black Hole",
        "Items.CrimsonBlackHoleStaff.Tooltip": "Summons THE VOID BLACK HOLE — exactly like the reference.\nA tilted fuchsia accretion disk of living matter (Doppler-bright on the approaching side),\na black core, a pale-pink photon ring, fourteen upper rays and lightning arcs.\nSame physics as the Black Hole: eats bullets, ramps up its damage ticks, and dies in an Einstein Ring.",

        "Items.VoidCrownItem.DisplayName": "Crown of the Void Queen",
        "Items.VoidCrownItem.Tooltip": "The original crown of the crimson black hole, now a wearable cosmetic.\nFive crimson neon arcs with orange knots arched JUST BEHIND your head.\nPure cosmetic: no stats. Works in accessory or vanity slots.",

        "Items.RuneCrownItem.DisplayName": "Astral Rune Crown",
        "Items.RuneCrownItem.Tooltip": "A new crown designed from scratch: eight runic glyphs of fuchsia light\nfloating in an arc above your head, each tipped with a pale-pink pearl.\nPure cosmetic: no stats. Works in accessory or vanity slots.",

        "Items.EventHorizonWings.DisplayName": "Wings of the Event Horizon",
        "Items.EventHorizonWings.Tooltip": "Crimson accretion arcs sprouting from two mini black holes on your back.\n100% procedural wings of light (crown technique).\nEnd-game flight: 200 ticks · speed 9.5 · accel x3.",
        "Items.PhotonRingWings.DisplayName": "Wings of the Photon Ring",
        "Items.PhotonRingWings.Tooltip": "Five blades of light with photon pulses traveling to the tips.\n100% procedural wings of light (crown technique).\nEnd-game flight: 200 ticks · speed 9 · accel x3.2.",
        "Items.SolarNovaWings.DisplayName": "Solar Nova Wings",
        "Items.SolarNovaWings.Tooltip": "Tongues of plasma: white-hot core, gold, orange and deep red.\nEnd-game flight: 190 ticks · speed 9.5.",
        "Items.QuantumPlasmaWings.DisplayName": "Quantum Plasma Wings",
        "Items.QuantumPlasmaWings.Tooltip": "Faceted cyan crystal shards with electric plasma inside.\nEnd-game flight: 180 ticks · speed 10 (set record).",
        "Items.EtherealVoidWings.DisplayName": "Ethereal Void Wings",
        "Items.EtherealVoidWings.Tooltip": "Translucent purple membrane with living fuchsia veins and inner stars.\nEnd-game flight: 180 ticks · speed 9.",
        "Items.GlacialEtherWings.DisplayName": "Glacial Ether Wings",
        "Items.GlacialEtherWings.Tooltip": "Sky-blue ether feathers with icicle tips.\nEnd-game flight: 180 ticks · extra slow glide.",
        "Items.GenesisFossilWings.DisplayName": "Genesis Fossil Wings",
        "Items.GenesisFossilWings.Tooltip": "Fossilized bone feathers with amber veins and sediment bands.\nEnd-game flight: 180 ticks · speed 9.",
        "Items.NebulaPillarWings.DisplayName": "Nebula Pillar Wings",
        "Items.NebulaPillarWings.Tooltip": "Translucent magenta nebula body with a bright cyan edge.\nEnd-game flight: 185 ticks · speed 9.",
        "Items.EclipseWings.DisplayName": "Eclipse Wings",
        "Items.EclipseWings.Tooltip": "Black eclipse discs with golden rims and white-gold corona rays.\nEnd-game flight: 190 ticks · speed 9.2.",
        "Items.SupernovaWings.DisplayName": "Supernova Wings",
        "Items.SupernovaWings.Tooltip": "Shockwave feathers from white-hot to violet with expanding wave rings.\nEnd-game flight: 185 ticks · speed 9.4.",

