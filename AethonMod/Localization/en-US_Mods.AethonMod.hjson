        "Items.SolRunico9Staff.DisplayName": "Runic Sun Staff IX",
        "Items.SolRunico10Staff.DisplayName": "Runic Sun Staff X",
        // v6.22: THE SECOND DECADE — suns 11..20 (the comet, the rune rain,
