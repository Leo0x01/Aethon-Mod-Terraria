{
        "Mods.AethonMod.DisplayName": "Aethon, the Primordial Light",

        "Items.GenesisShard.DisplayName": "Genesis Shard",
        "Items.GenesisShard.Tooltip": "Light weapon that fires homing particles.\nMaterial to craft the Grimoire of the Eternal.\nDrops from King Slime and Eye of Cthulhu.",

        "Items.AncientAltarItem.DisplayName": "Ancient Altar",
        "Items.ResonanceShard.DisplayName": "Resonance Shard",
        "Items.ResonanceShard.Tooltip": "Cosmic currency. Dropped by bosses.",

        "Items.GrimoireEternal.DisplayName": "Grimoire of the Eternal",
        "Items.GrimoireEternal.Tooltip": "Hybrid magic/summon weapon.\nLeft click: arcane bolt. Right click: summon minion.",

        "Items.BossSummonBag.DisplayName": "Summoner Bag",
        "Items.BossSummonBag.Tooltip": "Contains 999 of every boss summoner.\nTesting item — remove before release.",
        "Items.LevelUpTester.DisplayName": "Level Slayer",
        "Items.LevelUpTester.Tooltip": "Grants +10 levels to the Grimoire of the Eternal.\nSearches the whole inventory.\nTesting item — remove before release.",

        "Projectiles.ArcaneBolt.DisplayName": "Arcane Bolt",
        "Projectiles.GenesisLight.DisplayName": "Genesis Light",
        "Projectiles.CosmicOrbMinion.DisplayName": "Cosmic Orb",
        "Projectiles.CosmicOrbBolt.DisplayName": "Cosmic Bolt",
        "Projectiles.AnillosSingularesHalo.DisplayName": "Horizon Rings",

        "Buffs.CosmicOrbBuff.DisplayName": "Cosmic Orb",
        "Buffs.CosmicOrbBuff.Description": "A cosmic orb of light follows you and shoots at your enemies",

        "Items.MedusaNebularStaff.DisplayName": "Nebula Jellyfish Staff",
        "Items.MedusaNebularStaff.Tooltip": "Summons THE NEBULA JELLYFISH.\nA translucent bell holding a spiral galaxy, swimming on gravity pulses.\nIts stings leave the cold burn of the vacuum.",

        "Projectiles.NebulaJellyfishMinion.DisplayName": "Nebula Jellyfish",
        "Projectiles.NebulaLightning.DisplayName": "Nebular Lightning",

        "Buffs.NebulaJellyfishBuff.DisplayName": "Nebula Jellyfish",
        "Buffs.NebulaJellyfishBuff.Description": "A nebula jellyfish drifts at your side on gravity pulses",

        "Items.LivingCometStaff.DisplayName": "Living Comet Staff",
        "Items.LivingCometStaff.Tooltip": "Summons THE STELLAR COMET.\nA living comet with a crown of 8 star-points, orbiting you on an eccentric ellipse.\nIt DIVE-BOMBS enemies and bursts into a small nova.",

        "Projectiles.StellarCometMinion.DisplayName": "Stellar Comet",

        "Buffs.StellarCometBuff.DisplayName": "Stellar Comet",
        "Buffs.StellarCometBuff.Description": "A living comet orbits you and dive-bombs your enemies",

        "Items.LivingPulsarStaff.DisplayName": "Living Pulsar Staff",
        "Items.LivingPulsarStaff.Tooltip": "Summons THE LIVING PULSAR.\nA neutron star spinning at your side, sweeping the battlefield with two lighthouse beams of radiation.\nEverything they cross is ELECTRIFIED.",

        "Projectiles.LivingPulsarMinion.DisplayName": "Living Pulsar",

        "Buffs.LivingPulsarBuff.DisplayName": "Living Pulsar",
        "Buffs.LivingPulsarBuff.Description": "A neutron star spins at your side, its beams raking your enemies",
        "Buffs.QuemaduraCosmica.DisplayName": "Cosmic Burn",
        "Buffs.QuemaduraCosmica.Description": "The event horizon licks you: fire that burns inward",


        "Buffs.OcasoActivoBuff.DisplayName": "The Ocaso",
        "Buffs.OcasoActivoBuff.Description": "The ocaso burns: 8 seconds of star-deaths at ×3 damage with execute",
        "Buffs.SobrecalentadoBuff.DisplayName": "Overheated",
        "Buffs.SobrecalentadoBuff.Description": "The staff smokes and stays silent: it won't fire while it cools",

        "Items.BolsaProbador.DisplayName": "Tester's Bag",
        "Items.BolsaProbador.Tooltip": "Aethon's testing tools.\nRight-click to deploy them.\nOnly delivers what you're missing.\nThe bag is permanent: reopen it whenever you lose something.",
        "Items.BolsaFundacionales.DisplayName": "Founding Staves Bag",
        "Items.BolsaFundacionales.Tooltip": "The four staves that started it all.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaClasicosCosmicos.DisplayName": "Cosmic Classics Bag",
        "Items.BolsaClasicosCosmicos.Tooltip": "The primordial sun and its living creatures.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaAgujerosNegros.DisplayName": "Black Holes Bag",
        "Items.BolsaAgujerosNegros.Tooltip": "Ten ways to devour the light.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaSolesRunicos.DisplayName": "Runic Suns Bag",
        "Items.BolsaSolesRunicos.Tooltip": "From the one-ring sun to the Grand Seal (all 20).\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaEstrellasReales.DisplayName": "Real Stars Bag",
        "Items.BolsaEstrellasReales.Tooltip": "Real physics turned into weapons (all 7).\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaArmasLibrerias.DisplayName": "Library Weapons Bag",
        "Items.BolsaArmasLibrerias.Tooltip": "Each weapon is a concert of our VFX libraries (all 6).\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaBastonesCreativos.DisplayName": "Creative Staves Bag",
        "Items.BolsaBastonesCreativos.Tooltip": "The gauge, the pendulum, the choir and other oddities (all 6).\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaExhumados.DisplayName": "Exhumed Bag",
        "Items.BolsaExhumados.Tooltip": "The exhumed forms: the rancor and the eminence.\nThe arsenal's original exhumed forms.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaCosmeticos.DisplayName": "Cosmetics Bag",
        "Items.BolsaCosmeticos.Tooltip": "Crowns, seals and rings that sit upon your character.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaDosFormas.DisplayName": "Two Forms Bag",
        "Items.BolsaDosFormas.Tooltip": "The two-usage-form weapons: each one deploys its alternative form.\nThe four that learned to say two things at once.\nRight-click to deploy them.\nOnly delivers what you're missing.",
        "Items.BolsaDesgarros.DisplayName": "Tears Bag",
        "Items.BolsaDesgarros.Tooltip": "The staves that rip reality: suture, portal, fold, wound,\nheart, throat, threshold and leviathan. Each tear opens differently.\nRight-click to deploy them.\nOnly delivers what you're missing.",

        "Items.RencorPrimordialStaff.DisplayName": "The Primordial Rancor",
        "Items.RencorPrimordialStaff.Tooltip": "The arsenal's exhumed form: THE PRIMORDIAL RANCOR.\nPins a runic transmutation circle 380 px away.\n3 s of charge → THE CONTINUOUS white-core, pink-edged beam that pierces EVERYTHING.\nOn wall contact: spectral arms (x0.66) and cinders (x0.33).\nEnemies caught by the beam disintegrate into ash. No mana.",

        "Items.EminenciaAtrozStaff.DisplayName": "The Gruesome Eminence",
        "Items.EminenciaAtrozStaff.Tooltip": "The arsenal's exhumed form: THE GRUESOME EMINENCE.\nHold to channel: the spirit congregation hovers near your cursor.\n14 s of accumulation → THE ABOMINATION, full control.\nDamage climbs from 100% to 185% as it accumulates.\nRelease the channel and the mass decays and dissipates. No mana.",

        "Projectiles.RencorPrimordialProjectile.DisplayName": "Circle of Rancor",
        "Projectiles.EminenciaAtrozProjectile.DisplayName": "Spirit Congregation",

        "Items.OcasoAethonStaff.DisplayName": "Ocaso of Aethon Staff",
        "Items.OcasoAethonStaff.Tooltip": "The supreme gauge weapon: charge → burst → lockout.\nEvery fragment hit charges the halo over your head.\nFull halo: RIGHT-CLICK ignites THE OCASO (8 s of ×3 star-deaths).\nBelow 50% target health, death EXECUTES.\nAfterwards: 2 s overheat lockout. No mana.",

        "Projectiles.OcasoShardProjectile.DisplayName": "Ocaso Shard",
        "Projectiles.OcasoBurstProjectile.DisplayName": "Star-Death",

        "NPCs.HollowTitan.DisplayName": "The Hollow Titan",
        "NPCs.AethonBoss.DisplayName": "Aethon, the Primordial Light",
        "NPCs.TheWitness.DisplayName": "The Witness",
        "NPCs.EchoBlade.DisplayName": "Echo of the First Wielder",
        "NPCs.EchoArcher.DisplayName": "Echo of the Star-Archer",
        "NPCs.RiftKeeper.DisplayName": "The Rift-Keeper",

