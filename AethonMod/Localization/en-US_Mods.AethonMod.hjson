        "Projectiles.BlackHoleProjectile.DisplayName": "Black Hole",
                "Projectiles.SunProjectile.DisplayName": "Sun",
        "Projectiles.CosmicShockwaveProjectile.DisplayName": "Cosmic Shockwave",
        "Projectiles.SupernovaProjectile.DisplayName": "Supernova",
        "Projectiles.PlasmaStormProjectile.DisplayName": "Plasma Storm",
        "Projectiles.PhoenixNovaProjectile.DisplayName": "Phoenix Nova",
        "Projectiles.QuantumSplitProjectile.DisplayName": "Quantum Split",
        "Projectiles.CosmicBlackHoleProjectile.DisplayName": "Cosmic Black Hole",
        "Projectiles.UmbralBlackHoleProjectile.DisplayName": "Umbral Black Hole",
        "Projectiles.BrumaBlackHoleProjectile.DisplayName": "Bruma Black Hole",
        "Projectiles.OlvidoBlackHoleProjectile.DisplayName": "Olvido Black Hole",
        "Projectiles.SupremoBlackHoleProjectile.DisplayName": "Supreme Black Hole",
        "Projectiles.SupremoAuroraBlackHoleProjectile.DisplayName": "Aurora Supreme Black Hole",
