// v6.56.6 — LA RED DE SEGURIDAD DEL FALLBACK: copia AUTOMÁTICA del es-ES
// con EL MISMO TEXTO ESPAÑOL. tModLoader cae al en-US cuando la cultura
// activa del juego no tiene una clave del mod: sin este archivo, un juego
// en inglés mostraba CLAVES CRUDAS («Mods.AethonMod.HUD.Nivel» en vez de
// «Grimorio · Nv X»). NO es un idioma del mod — es el mismo español
// viajando en la maleta del fallback. Editar SOLO el es-ES y correr
// tools/sync_es_mx_v6564.py.
Mods.AethonMod.DisplayName: Aethon, el Grimorio Eterno

Items: {
	LibroCorrupto: {
		DisplayName: Libro Consagrado
		Tooltip:
			'''
			✦ Un libro con la misma forma que los de la mazmorra… pero NEGRO.
			· Se consigue: 1% rompiendo libros en la mazmorra · 1% abriendo sus cofres · 50% la Muralla de Carne
			· Solo 1 en el inventario — y el grimorio lo quiere EN EL SUELO
			· Sin usarlo te pueden caer más — dejan de salir cuando lo USAS y tu grimorio llega al despertar 20
			· Devorado por debajo del despertar 20: la puerta del 20 queda paga PARA SIEMPRE
			'''
	}

	AltarOfrendasItem: {
		DisplayName: Altar de Ofrendas
		Tooltip:
			'''
			✦ El altar de la consagración del Eterno
			· Colócalo y hazle clic derecho: CONSAGRA la ofrenda por el Eterno (arma o material)
			· El arma consagrada gana +5% a TODO y su etiqueta · el material solo su etiqueta — el grimorio SOLO devora lo consagrado
			'''
	}

	LibroAzul: {
		DisplayName: Libro Azul
		Tooltip:
			'''
			El arma del árbol de habilidades.
			Clic derecho: abre el ÁRBOL DE HABILIDADES (los puntos nacen del nivel de ESTE arma: 3 + nivel/5).
			Clic izquierdo: la descarga azul (daño 12 + nivel·2).
			Sube de nivel con las bajas de su portador (8 por nivel, tope 100).
			Nada que ver con el grimorio: el árbol es del LIBRO.
			'''
	}

	// v6.50.117 — GENESIS PURGE: Items.GenesisShard and
	// Items.AncientAltarItem died with the shard and the altar
	// (THE FALL is the only way to the Grimoire of the Eternal).
	
	ResonanceShard: {
		DisplayName: Fragmento de Resonancia
		Tooltip: Moneda cósmica. Se obtiene de jefes.
	}

	GrimoireEternal: {
		DisplayName: Grimorio del Eterno
		Tooltip:
			'''
			   Un libro viejo que devora lo que su portador mata.
			   Mantén sus páginas llenas... o será tu alma la que llene la siguiente.
			'''
	}

	BossSummonBag: {
		DisplayName: Bolsa de Invocadores
		Tooltip:
			'''
			Contiene 999 invocadores de cada jefe.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	LevelUpTester: {
		DisplayName: Verdugo de Niveles
		Tooltip:
			'''
			Da +10 niveles al Grimorio del Eterno.
			Reutilizable — no se consume.
			Busca en todo el inventario.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	CarnadaDelGrimorio: {
		DisplayName: La Carnada del Grimorio
		Tooltip:
			'''
			Provoca LAS OLEADAS DEL HAMBRE sin esperar.
			Clic izq: desata la furia (las oleadas preparadas).
			Clic der: prepara 1..11 oleadas (11 = EL JUICIO: los 6 guardianes ×15).
			Todo lo que muera en la oleada k paga XP ×(k+1); la especial, ×15.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	EsenciaHambre: {
		DisplayName: Esencia de Hambre
		Tooltip:
			'''
			Sube el hambre del Grimorio del Eterno +5% por uso.
			El probador del reloj nervioso — sin esperar una hora.
			Reutilizable — no se consume.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	PaginaEnBlanco: {
		DisplayName: Página en Blanco
		Tooltip:
			'''
			Borra la memoria de festines del Grimorio del Eterno.
			Cada tipo de jefe volverá a estrenar SU PRIMERA CENA.
			También borra la marca del cielo: LA CAÍDA volverá a cruzar
			la primera noche del portador.
			Reutilizable — no se consume.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	// v6.50.75 — THE SCRIBE'S HOURGLASS: one click swaps day for night
	// and night for day (the user's request: "one click and it's day,
	// another click and it's night").
	
	RelojDeArenaDelEscriba: {
		DisplayName: El Reloj de Arena del Escriba
		Tooltip:
			'''
			Un clic: si es de día, cae la noche; si es de noche, amanece.
			La arena es tinta: con ella el escriba escribió el alba y el ocaso.
			Funciona incluso a media oleada: el cielo del festín cruza suave.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	// v6.50.82 — THE HUNGRY GRIMOIRE: the Living Codex DEMO weapon.
	// User's letter: the hunger cycle compressed to 60 s.
	GrimorioHambriento: {
		DisplayName: Grimorio Hambriento
		Tooltip:
			'''
			El ojo del Códice Vivo: te mira, parpadea y pasa hambre.
			Su apetito crece de cero a TOTAL en un minuto (tasa
			de prueba): el parpadeo se acelera (de 10-20 s a
			cada 2 s), la mirada se agita y el iris dorado se
			enciende ROJO.
			Clic izq: abre LA GRIETA DE TINTA — la descarga
			perseguidora PROPIA del libro (pruebas, sin maná).
			Clic der: reinicia el apetito.
			Objeto de pruebas — eliminar antes de publicar.
			'''
	}

	// v6.50.92 — THE FAMILY SHRINKS TO TWO (the user's letter:
	// "delete the unstable and the erratic hungry grimoire, keep
	// the original and the nervous one"): the Erratic (.87) and
	// the Unstable (.89) are DELETED; the Nervous one lives its
	// TWO LIVES from .91.
	GrimorioHambrientoNervioso: {
		DisplayName: Grimorio Hambriento Nervioso
		Tooltip:
			'''
			La copia HAMBRIENTA — el mismo ojo, pero este libro
			es APETITO CON CUERPO: intranquilo, enojado, con
			hambre. Su hambre sube SIEMPRE (tasa de prueba; la
			versión real irá más lenta): sólo la presa comida la
			baja (−1%) y el clic derecho la reinicia.
			Desde el 25% sale a cazar POR SU CUENTA si te ausentas
			(AFK 5 s, o 30 s sin atacar criaturas con el libro):
			flota cerca de ti y su Sombra de la Página devora a
			la criatura que se mueva cerca — ataca cuando QUIERE:
			en cuanto termina con una presa, sale tras la
			siguiente que se mueva.
			El festín es EGOÍSTA: se come a la presa ENTERA, botín
			incluido — la XP es de ESTE libro (sube su nivel);
			tú no recibes nada. Mientras está fuera, sus ataques
			salen DEL LIBRO (tu mano ataca vacía).
			NUNCA se escapa: al 100% se queda flotando cerca de
			ti, cazando por sí mismo.
			Clic izq: abre LA GRIETA DE TINTA — la descarga
			perseguidora PROPIA del libro (pruebas, sin maná).
			Clic der: reinicia el apetito.
			Objeto de pruebas — comparar con el original.
			'''
	}

	// v6.50.62 — THE GRIMOIRE'S MAWS: the three shadow-devouring
	// weapons (test — the book is NOT touched). The shadow's power (the reference anime).
	// v6.50.64 — the TWIN-HEAD pincer + the BLACK MIST on all three
	// ("the gif doubled at the tip, one per corner, so it behaves like
	// teeth" + "black mist on every tentacle and mouth").
	
	
	
	SombraDeLaPagina: {
		DisplayName: La Sombra de la Página
		Tooltip:
			'''
			«Escrita con tinta de la Puerta: ojos y dientes.»
			La misma fauce del tentáculo, pero 100% ESCRITA POR CÓDIGO —
			ni un sprite: la masa muscular, los ojos que se abren de
			golpe, la carne que fluye, TODO dibujado por el motor.
			Nace DE TU CUERPO — vueles o camines, la sombra va CONTIGO —,
			caza a cualquier distancia, muerde y drena: la punta se
			disuelve en BRUMA NEGRA y al clavarse, EL DEVORADOR — la masa
			que CUBRE ENTERO al jefe — traga con pulso mientras las almas
			vuelven a ti por el cuerpo. A 1 de vida: el festín.
			(Arma de prueba de las fauces — v2.)
			'''
	}

	SombraPagina2: {
		DisplayName: La Sombra de la Página II
		Tooltip:
			'''
			«La página aprendió a DOBLARSE en dos — y a abrir los ojos.»
			EL SEGUNDO TOMO de la Sombra de la Página: el mismo festín
			(caza a cualquier distancia, muerde, drena y a 1 de vida
			DEVORA), con el cuerpo MÁS detallado de la casa — la DOBLE
			HÉLICE de tinta trenzada alrededor de su espina, LOS OJOS
			REALES DEL ESCUADRÓN (con su iris que MIRA y sus párpados)
			repartidos por las dos hebras, LOS RAYOS PERLIN chispeando
			entre ellas y la BOCA DE GARRAS que se abre y CIERRA DE
			GOLPE. Al morder: EL DEVORADOR con la CORONA DE 9 GARRAS
			mordiendo el plano entero.
			SIN COSTE DE MANÁ — arma de prueba: úsala sin miedo.
			(Arma de prueba de las fauces — tomo 2.)
			'''
	}

	// v6.50.91 — THE LIVING CODEX WAS DELETED ENTIRELY (the user's word:
	// "El Codice Vivo lo puedes borrar por completo ya no es necesario").
	// Its levitation — the book that leaves your hands and hovers — now
	// lives in the NERVOUS GRIMOIRE's spirit (hunt — the escape died
	// in .94: the book never runs away).
	
	// v6.50.61 — THE PURGE: the FOUR wardens' summon items died with
	// their bosses (Hollow Titan Crystal, Rift Seal, Archer's Feather,
	// Bearer's Shadow).
	
	NombreDeAethon: {
		DisplayName: Fragmentos de un recuerdo lejano - Aethon
		Tooltip:
			'''
			«No todo lo que un libro recuerda cabe en sus páginas.
			Lo que se cayó de ellas… sigue teniendo hambre.»
			Convoca a LOS FRAGMENTOS DE UN RECUERDO LEJANO: la luz
			y la oscuridad de un dios muerto, cayendo JUNTAS sobre
			el mundo. Mientras vivan, el mediodía no se acaba.
			Derríbalos a los dos… y EL RECUERDO COMPLETO recordará
			quién era.
			'''
	}

	AethonMenorItem: {
		DisplayName: El Aethon Menor
		Tooltip:
			'''
			Una chispa viva del propio grimorio.
			Invoca al AETHON MENOR — la mascota de luz: una página
			del libro hecha criatura, flotando a tu hombro, coronada
			de perlas y alumbrando con el arcoíris del tomo.
			Se EQUIPA en la ranura de mascota de LUZ del equipo.
			'''
	}

	BolsaDeLaCria: {
		DisplayName: Bolsa de la Cría
		Tooltip:
			'''
			Las DOS mascotas de la casa duermen dentro: la PAREJA
			del recuerdo (la cría de LUZ y su gemela de OSCURIDAD
			— la miniatura del JEFE) y el GRIMORIO MENOR (la
			miniatura del LIBRO, con sus mini minions). Ábrela
			(clic derecho) y despiertan las dos.
			'''
		Abierta: Las dos mascotas despiertan — la pareja del recuerdo y el mini grimorio te siguen.
	}

	VastagoDelEternoItem: {
		DisplayName: El Vástago del Eterno
		Tooltip:
			'''
			✦ El librito alado que nació del Taller: respira, parpadea y
			vuela a tu lado (idle y vuelo animados, nacidos en el Taller).
			· Se EQUIPA en la ranura de mascota — y la tecla B lo despierta SOLO equipado
			'''
	}

	GrimorioMenorItem: {
		DisplayName: Grimorio Menor
		Tooltip:
			'''
			El Grimorio del Eterno… EN MINIATURA (la OTRA mascota:
			la miniatura del LIBRO, no del jefe de luz).
			Flota a tu hombro con su ojo despierto; si te quedas
			quieto, se aburre y vuela a MOLESTAR a los vecinos con
			sus 3 mini minions y su sombrilla de página (1 de daño,
			tope 10 golpes… y luego se aburre).
			Se EQUIPA en la ranura de mascota del equipo (y su
			ojo vive hasta en el icono).
			'''
	}

	TintaDelCometa: {
		DisplayName: Tinta de la Llegada
		Tooltip:
			'''
			EL ACTIVADOR DE LA LLEGADA (item de pruebas — la Bolsa de la Cría lo trae).
			Rompe el frasco y el mundo RECUERDA: la bruma del Grimorio
			del Eterno nace otra vez frente a ti — de día o de noche.
			Los caminos automáticos siguen su ley (la primera noche de
			cada jugador en cada mundo + el primer vecino que no sea el
			Guía); ESTA tinta es el camino MANUAL: el evento NUNCA se
			pierde… y jamás duplica tu grimorio (si ya te espera o su
			bruma ya nació, el cielo no insiste).
			'''
	}

	EcoDelDespertar: {
		DisplayName: Eco del Despertar
		Tooltip:
			'''
			LA LLAVE DE PRUEBAS DE EL DESPERTAR (no consumible): cada uso
			despierta al grimorio UN NIVEL MÁS (con toda la ceremonia — y en
			el 20, la película de la mascota).
			El camino real son las tres ofrendas: esencias corruptas,
			dinero y el arma corrupta del peldaño… pero el probador es del
			probador.
			'''
		Paso: The Echo will strike with force {0} (right click to toggle)
	}

	OjoDelCieloItem: {
		DisplayName: El Ojo del Cielo
		Tooltip:
			'''
			EL CIELO DEL DESPERTAR — la ventana de misiones del grimorio.
			Ábrelo (clic) y verás el CHECKLIST del camino: los jefes de la
			caza (marcados si ya cayeron — aunque los mataras hace años),
			las armas y los lingotes de cada peldaño (y si ya los llevas
			en la bolsa), las esencias y el dinero del peldaño vivo, y los
			hitos y micropoderes de los 50 niveles.
			El cielo no se consume: vigila.
			'''
	}

	MedusaNebularStaff: {
		DisplayName: Báculo de la Medusa Nebular
		Tooltip:
			'''
			Invoca LA MEDUSA NEBULAR.
			Una campana translúcida con una galaxia espiral dentro, nadando a pulsos de gravedad.
			Su campana dispara LÁTIGOS ELÉCTRICOS que salen de ella misma, dejando la quemadura fría del vacío.
			'''
	}

	LivingCometStaff: {
		DisplayName: Báculo del Cometa Estelar
		Tooltip:
			'''
			Invoca EL COMETA ESTELAR.
			Un cometa vivo con corona de 8 puntas estelares, orbitándote en una elipse excéntrica.
			CAE EN PICADO sobre tus enemigos y estalla en una pequeña nova.
			'''
	}

	LivingPulsarStaff: {
		DisplayName: Báculo del Púlsar Vivo
		Tooltip:
			'''
			Invoca EL PÚLSAR VIVO.
			Una estrella de neutrones girando a tu lado, barriendo el campo con dos haces de faro de radiación.
			Todo lo que cruzan queda ELECTRIFICADO.
			'''
	}

	BolsaProbador: {
		DisplayName: Bolsa del Probador
		Tooltip:
			'''
			Las herramientas de pruebas de Aethon.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			La bolsa es permanente: reábrela cuando pierdas algo.
			'''
	}

	BolsaFundacionales: {
		DisplayName: Bolsa de los Bastones Fundacionales
		Tooltip:
			'''
			Los cuatro bastones que empezaron todo.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaClasicosCosmicos: {
		DisplayName: Bolsa de los Clásicos Cósmicos
		Tooltip:
			'''
			El sol primordial y sus criaturas vivas.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaAgujerosNegros: {
		DisplayName: Bolsa de los Agujeros Negros
		Tooltip:
			'''
			Diez formas de devorar la luz.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaSolesRunicos: {
		DisplayName: Bolsa de los Soles Rúnicos
		Tooltip:
			'''
			Del sol de un anillo al Gran Sellado (los 20).
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaEstrellasReales: {
		DisplayName: Bolsa de las Estrellas Reales
		Tooltip:
			'''
			Física de verdad convertida en armas (las 7).
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaArmasLibrerias: {
		DisplayName: Bolsa de las Armas de las Librerías
		Tooltip:
			'''
			Cada arma es un concierto de nuestras librerías VFX (las 7).
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaBastonesCreativos: {
		DisplayName: Bolsa de los Bastones Creativos
		Tooltip:
			'''
			El medidor, el péndulo, el coro y demás rarezas (los 6).
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaExhumados: {
		DisplayName: Bolsa de los Exhumados
		Tooltip:
			'''
			Las formas exhumadas: el rencor y la eminencia.
			Las formas exhumadas originales del arsenal.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaCosmeticos: {
		DisplayName: Bolsa de los Cosméticos
		Tooltip:
			'''
			Coronas, sellos y anillos que se ciñen a tu personaje.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaDosFormas: {
		DisplayName: Bolsa de las Dos Formas
		Tooltip:
			'''
			Las armas de las dos formas de uso: cada una despliega su forma alternativa.
			Las cuatro que aprendieron a decir dos cosas a la vez.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaDesgarros: {
		DisplayName: Bolsa de los Desgarros
		Tooltip:
			'''
			Los bastones que rajan la realidad: sutura, portal, pliegue, herida,
			corazón, garganta, umbral y leviatán. Cada desgarro se abre distinto.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	RencorPrimordialStaff: {
		DisplayName: El Rencor Primordial
		Tooltip:
			'''
			La forma exhumada del arsenal: EL RENCOR PRIMORDIAL.
			Clava un círculo de transmutación rúnico a 380 px.
			3 s de carga → EL HAZ CONTINUO carmesí-ámbar que perfora TODO.
			Al tocar pared: brazos espectrales (×0.66) y ascuas (×0.33).
			Los enemigos del haz se desintegran en ceniza. Sin maná.
			'''
	}

	EminenciaAtrozStaff: {
		DisplayName: La Eminencia Atroz
		Tooltip:
			'''
			La forma exhumada del arsenal: LA EMINENCIA ATROZ.
			Sostén el uso: la congregación de espíritus canaliza cerca del cursor.
			14 s de acumulación → LA ABOMINACIÓN, control total.
			El daño crece del 100% al 185% mientras se acumula.
			Si sueltas el canal, la masa decae y se disipa. Sin maná.
			'''
	}

	OcasoAethonStaff: {
		DisplayName: Bastón del Ocaso de Aethon
		Tooltip:
			'''
			El arma suprema del medidor: carga → estallido → bloqueo.
			Cada impacto de un fragmento carga el aro de tu cabeza.
			Aro lleno: CLIC DERECHO enciende EL OCASO (8 s de muertes de estrella ×3).
			Bajo el 50% de vida del objetivo, la muerte EJECUTA.
			Después: 2 s de sobrecalentada. Sin maná.
			'''
	}

