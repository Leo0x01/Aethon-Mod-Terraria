	BolsaExhumados: {
		DisplayName: Exhumed Bag
		Tooltip:
			'''
			The exhumed forms: the rancor and the eminence.
			The arsenal's original exhumed forms.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaCosmeticos: {
		DisplayName: Cosmetics Bag
		Tooltip:
			'''
			Crowns, seals and rings that sit upon your character.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaDosFormas: {
		DisplayName: Two Forms Bag
		Tooltip:
			'''
			The two-usage-form weapons: each one deploys its alternative form.
			The four that learned to say two things at once.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	BolsaDesgarros: {
		DisplayName: Tears Bag
		Tooltip:
			'''
			The staves that rip reality: suture, portal, fold, wound,
			heart, throat, threshold and leviathan. Each tear opens differently.
			Right-click to deploy them.
			Only delivers what you're missing.
			'''
	}

	RencorPrimordialStaff: {
		DisplayName: The Primordial Rancor
		Tooltip:
			'''
			The arsenal's exhumed form: THE PRIMORDIAL RANCOR.
			Pins a runic transmutation circle 380 px away.
			3 s of charge → THE CONTINUOUS white-core, pink-edged beam that pierces EVERYTHING.
			On wall contact: spectral arms (x0.66) and cinders (x0.33).
			Enemies caught by the beam disintegrate into ash. No mana.
			'''
	}

	EminenciaAtrozStaff: {
		DisplayName: The Gruesome Eminence
		Tooltip:
			'''
			The arsenal's exhumed form: THE GRUESOME EMINENCE.
			Hold to channel: the spirit congregation hovers near your cursor.
			14 s of accumulation → THE ABOMINATION, full control.
			Damage climbs from 100% to 185% as it accumulates.
			Release the channel and the mass decays and dissipates. No mana.
			'''
	}

	OcasoAethonStaff: {
		DisplayName: Ocaso of Aethon Staff
		Tooltip:
			'''
			The supreme gauge weapon: charge → burst → lockout.
			Every fragment hit charges the halo over your head.
			Full halo: RIGHT-CLICK ignites THE OCASO (8 s of ×3 star-deaths).
			Below 50% target health, death EXECUTES.
			Afterwards: 2 s overheat lockout. No mana.
			'''
	}

