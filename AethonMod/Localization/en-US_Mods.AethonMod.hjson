        // v6.22: THE PRIMORDIAL ECLIPSE
        "Projectiles.EclipsePrimordialProjectile.DisplayName": "Primordial Eclipse",

        // v6.19: the runic suns and the scepter's lightning bolt
        "Projectiles.RuneSunProjectile.DisplayName": "Runic Sun",
        "Projectiles.RunicLightning.DisplayName": "Runic Thunder",


        // v6.26 — The new arsenal: the reality tear, the real stars,
        // the stellar life cycle and the five creative staves
        "Items.DesgarroRealityStaff.DisplayName": "Reality Tear Staff",
        "Items.DesgarroRealityStaff.Tooltip": "Fires a TEAR in reality.\nThe rift pierces walls and damages along its line.\nWhen it closes it leaves a lingering rift that drains.\nWhile it lives, the wounded world darkens.",

        // v6.31 — THE SOWER: the anchoring pulsar of the stellar graveyard
        "Items.SembradorCementeralStaff.DisplayName": "Stellar Graveyard Sower",
        "Items.SembradorCementeralStaff.Tooltip": "Sows PULSARS that brake hard and anchor where you aim.\nEach pulsar spins up and sweeps with two opposite lighthouse beams.\nFull-power anchor strike; the beams bite without rest.\nMax 3 pulsars: the newest sowing eats the oldest.",

        // v6.31 — THE COLLAPSE: the star that brakes, trembles and bursts
        "Items.ColapsoMagnetarStaff.DisplayName": "Magnetar Collapse",
        "Items.ColapsoMagnetarStaff.Tooltip": "Fires a magnetar star that brakes until it nearly stops.\nThe harder the brake holds, the deadlier the STARQUAKE.\nThe ring only strikes with its FRONT and pierces armor.\nThe survivor enters overclock and dies in a final flash.",

        // v6.31 — THE TEARS: the orbital tear shotgun of the dying sun
        "Items.LagrimasSolMoribundoStaff.DisplayName": "Tears of the Dying Sun",
        "Items.LagrimasSolMoribundoStaff.Tooltip": "Sheds THREE TEARS from a dying sun.\nEach tear orbits for 2.5 s, kindling from charred to gold.\nThen it hunts without rest: up to 18 bites with cosmic burn.\nIt bursts into molten metal as it fades.",

        // v6.31 — THE DECREE: the eclipse circle that grows and executes
        "Items.DecretoEclipseStaff.DisplayName": "The Eclipse Decree",
        "Items.DecretoEclipseStaff.Tooltip": "Nails an ECLIPSE CIRCLE at the cursor.\nIt grows up to 660 px while alive and executes every 15 ticks:\nthe wave rides to the border and EVERYTHING inside is cut.\nClosest to the center pays ×4.8 · the eye contracts before the slash.",

        // v6.32 — W2-a: FOUR NEW COSMIC WEAPONS (comet, nova, quasar, loom)
        "Items.CometaErranteStaff.DisplayName": "The Wandering Comet",
        "Items.CometaErranteStaff.Tooltip": "Captures a comet in an ELLIPTICAL ORBIT around you for 6 laps.\nThe ice-fire core strikes at full power; the dust tail nips at ×0.4.\nThe tail ALWAYS points away from the orbit, like real comets.\nAfter 420 ticks it launches into the hunt and bursts into ice-fire.",
        "Items.NovaEncadenadaStaff.DisplayName": "The Chained Nova",
        "Items.NovaEncadenadaStaff.Tooltip": "A slow nova sphere that bursts on touching foe or ground.\nEach nova chains 3 daughters ×0.65 and 2 granddaughters ×0.42 — up to 3 generations.\nThe ring's FRONT is what strikes · zero chance: prey by distance.",
        "Items.VozCuasarStaff.DisplayName": "The Voice of the Quasar",
        "Items.VozCuasarStaff.Tooltip": "Summons a quasar that charges 40 ticks then unleashes a 460 px CONTINUOUS BEAM.\nThe beam PIERCES EVERYTHING · DOPPLER: leading edge blue, tail red.\nIt bounces once off walls · it dies with a flash.",
        "Items.TelarConstelacionesStaff.DisplayName": "The Constellation Loom",
        "Items.TelarConstelacionesStaff.Tooltip": "Each use nails a LITTLE STAR where your cursor was.\nThey connect themselves with threads of light: the constellation draws itself.\nWith 4 or more, every 30 ticks the FIGURE IGNITES:\nevery enemy inside the polygon takes ×2.2 per star.",

        // v6.33 — W2-b: FOUR MORE COSMIC WEAPONS (meteor shower, nebula, horizon, gamma ray)
        "Items.LluviaMeteorosStaff.DisplayName": "The Meteor Shower",
        "Items.LluviaMeteorosStaff.Tooltip": "Marks the cursor zone with a 30-tick amber telegraph.\nThen 8 meteors fall in staggered waves, one every 4 ticks, diagonal with fire trails.\nEach impact bursts ×1.0 in a 70 px radius and burns with cosmic burn for 3 s.",
        "Items.AbrazoNebulosaStaff.DisplayName": "The Nebula's Embrace",
        "Items.AbrazoNebulosaStaff.Tooltip": "Installs a nebula at the cursor: a magenta-cyan-violet cloud lasting 300 ticks.\nThose inside take ×0.06 every 3 ticks and are left SLOWED.\nBaby stars are born in its bosom and burst into ×0.8 mini-pops.\nOn death it dissipates into stardust.",
        "Items.FiloHorizonteStaff.DisplayName": "The Horizon's Edge",
        "Items.FiloHorizonteStaff.Tooltip": "Throws a black disc — an event horizon — with a photon line at its equator.\nIt pierces through enemies losing speed and returns like a boomerang.\nEvery hit leaves a mark that implodes 30 ticks later: ×0.7 + a pull.",
        "Items.RayoGammaStaff.DisplayName": "The Gamma Ray",
        "Items.RayoGammaStaff.Tooltip": "A thin 700 px beam crosses EVERYTHING instantly... but deals no damage yet.\nEvery enemy touched is marked with a glowing outline.\nAfter 30 ticks, ALL marks settle at once:\nclang, flash, ×1.0 damage and cosmic burn for 5 s.",

        "Items.NeutronStarStaff.DisplayName": "Neutron Star Staff",
        "Items.NeutronStarStaff.Tooltip": "A 12 px ultradense core.\n60 px aura with tripled damage.\nPeriodic starquakes shake the ground.\nGravity pulls it toward its prey.",
        "Items.PulsarStaff.DisplayName": "Pulsar Staff",
        "Items.PulsarStaff.Tooltip": "The cosmic lighthouse: two polar beams sweeping at 1 rev/s.\nEvery sweep that touches an enemy strikes hard.\nLight pulses synced to the spin.",
        "Items.WhiteDwarfStaff.DisplayName": "White Dwarf Staff",
        "Items.WhiteDwarfStaff.Tooltip": "The crystalline ember of an old star.\nSeven facets of cold light turning slowly.\nAn accretion ring that steals shine from nearby enemies.",
        "Items.DeadStarStaff.DisplayName": "Dead Star Staff",
        "Items.DeadStarStaff.Tooltip": "The black dwarf: what remains when all goes out.\nDark mass that devours light.\nConstant entropy around it.\nRune echoes at 0.2 Hz: the life it was.",
        "Items.RedSupergiantStaff.DisplayName": "Red Supergiant Staff",
        "Items.RedSupergiantStaff.Tooltip": "The dying 90 px colossus.\nConvection cells beating slowly.\nOn death it COLLAPSES and then erupts in a nova.",
        "Items.MagnetarStaff.DisplayName": "Magnetar Staff",
        "Items.MagnetarStaff.Tooltip": "The EXTREME neutron star.\nViolet magnetic field with twisted field lines.\nAutomatic lightning chains to enemies.\nIts heartbeat is a deterministic arrhythmia.",

        "Items.CicloEstelarStaff.DisplayName": "Stellar Cycle Staff",
        "Items.CicloEstelarStaff.Tooltip": "A star that LIVES a full life:\ncontracting nebula → ignition → red giant\n→ collapse and SUPERNOVA → neutron star.\nThe trail tells the story in five colors.",

        "Items.RelojArenaStaff.DisplayName": "Cosmic Hourglass Staff",
        "Items.RelojArenaStaff.Tooltip": "A living hourglass floating in the air.\nThe sand is light motes that fall and sting.\nWhen the chamber empties, time flips over.",
        "Items.MareaGravitatoriaStaff.DisplayName": "Gravitational Tide Staff",
        "Items.MareaGravitatoriaStaff.Tooltip": "A wave of light that rides the terrain.\nDrags enemies with the current.\nIf it hits a wall it breaks into three lesser waves.",
        "Items.EnjambrePrismaticoStaff.DisplayName": "Prismatic Swarm Staff",
        "Items.EnjambrePrismaticoStaff.Tooltip": "A core that bursts into twelve light wasps.\nThe swarm orbits and migrates from prey to prey.\nEach wasp stings with its own prismatic color.",
        "Items.PenduloJuicioStaff.DisplayName": "Pendulum of Judgment Staff",
        "Items.PenduloJuicioStaff.Tooltip": "A pendulum of light with real physics hanging in the air.\nEvery swing widens the arc of judgment.\nWhen released, the mace flies and explodes.",
        "Items.CoroEspectralStaff.DisplayName": "Spectral Choir Staff",
        "Items.CoroEspectralStaff.Tooltip": "Six notes of light singing in slow orbit.\nEach note emits its wave ring in turn.\nThe choir bids farewell going dark one by one.",

        "Projectiles.SembradorPulsarProjectile.DisplayName": "Graveyard Pulsar",
        "Projectiles.LagrimaSolarProjectile.DisplayName": "Solar Tear",
        "Projectiles.ColapsoMagnetarProjectile.DisplayName": "Collapsing Magnetar",
        "Projectiles.DecretoEclipseProjectile.DisplayName": "Eclipse Circle",
        "Projectiles.CometaErranteProjectile.DisplayName": "Wandering Comet",
        "Projectiles.NovaEncadenadaProjectile.DisplayName": "Chained Nova",
        "Projectiles.VozCuasarProjectile.DisplayName": "Voice of the Quasar",
        "Projectiles.TelarEstrellaProjectile.DisplayName": "Loom Star",
        "Projectiles.LluviaMeteorosProjectile.DisplayName": "Meteor Shower",
        "Projectiles.MeteoroProjectile.DisplayName": "Meteor",
        "Projectiles.AbrazoNebulosaProjectile.DisplayName": "Nebula's Embrace",
        "Projectiles.FiloHorizonteProjectile.DisplayName": "Horizon's Edge",
        "Projectiles.RayoGammaProjectile.DisplayName": "Gamma Ray",
        "Projectiles.NeutronStarProjectile.DisplayName": "Neutron Star",
        "Projectiles.PulsarProjectile.DisplayName": "Pulsar",
        "Projectiles.WhiteDwarfProjectile.DisplayName": "White Dwarf",
        "Projectiles.DeadStarProjectile.DisplayName": "Dead Star",
        "Projectiles.RedSupergiantProjectile.DisplayName": "Red Supergiant",
        "Projectiles.MagnetarProjectile.DisplayName": "Magnetar",
        "Projectiles.CicloEstelarProjectile.DisplayName": "Stellar Cycle",
        "Projectiles.RelojArenaProjectile.DisplayName": "Cosmic Hourglass",
        "Projectiles.MareaGravitatoriaProjectile.DisplayName": "Gravitational Tide",
        "Projectiles.MareaChicaProjectile.DisplayName": "Lesser Wave",
        "Projectiles.EnjambrePrismaticoProjectile.DisplayName": "Prismatic Swarm",
        "Projectiles.PenduloJuicioProjectile.DisplayName": "Pendulum of Judgment",
        "Projectiles.CoroEspectralProjectile.DisplayName": "Spectral Choir",
        "Projectiles.LanzaAlbaProjectile.DisplayName": "Dawn Lance",
        "Projectiles.RealityTearProjectile.DisplayName": "Reality Tear",
        "Projectiles.SinfoniaPrimordialProjectile.DisplayName": "Primordial Symphony",
        "Projectiles.TormentaNebularProjectile.DisplayName": "Nebular Storm",

        "Items.SuturaCuanticaStaff.DisplayName": "The Quantum Suture",
        "Items.SuturaCuanticaStaff.Tooltip": "Opens a GLITCH TEAR where you aim.\nCorrupts every enemy inside the circle.\nEvery 45 ticks fires quantum bolts at the 3 nearest.",
        "Items.PortalDimensionalStaff.DisplayName": "The Dimensional Portal",
        "Items.PortalDimensionalStaff.Tooltip": "Opens the ring gate where you aim.\nGentle pull within 300 px: whoever crosses the white core is shredded.\nThe portal breathes for 6 seconds.",
        "Items.PliegueEspacioStaff.DisplayName": "The Fold of Space",
        "Items.PliegueEspacioStaff.Tooltip": "Opens the EYE where you aim: the double ellipse with the black core.\nFolds space within 350 px and drags enemies in.\nWhoever touches the core is compressed.",
        "Items.HeridaElectricaStaff.DisplayName": "The Electric Wound",
        "Items.HeridaElectricaStaff.Tooltip": "Opens THE CRACK toward where you aim.\nStings in a line and applies ELECTRIFIED.\nThe current never cuts out.",

        // v6.35: THE FOUR NEW TEARS (second batch of references).
        "Items.CorazonColapsoStaff.DisplayName": "The Heart of the Collapse",
        "Items.CorazonColapsoStaff.Tooltip": "Ignites the FOUR-POINTED STAR of stellar fire.\nBurns every enemy inside the heart.\nEvery 30 ticks the filaments flare at the 2 closest.",

        "Items.GargantaVacioStaff.DisplayName": "The Throat of the Void",
        "Items.GargantaVacioStaff.Tooltip": "Opens the devouring vortex: absolute black core and magenta ring.\nThe lens bends the background and the pull drags within 320 px.\nWhoever touches the black core is devoured.",

        "Items.UmbralRotoStaff.DisplayName": "The Broken Threshold",
        "Items.UmbralRotoStaff.Tooltip": "Splits reality with a perfect horizontal cut.\nAbove, the void with the spectral skeleton; below, the world.\nStings in a line and every 60 ticks the other reality bites.",

        "Items.LeviatanEspectralStaff.DisplayName": "The Spectral Leviathan",
        "Items.LeviatanEspectralStaff.Tooltip": "Launches the ethereal bone creature: fourteen vertebrae swimming in S.\nPierces everything it touches and turns toward the nearest enemy.\n4 seconds of spectral swimming.",

        "Projectiles.DesgarroCuanticoProjectile.DisplayName": "Quantum Suture",
        "Projectiles.PortalDimensionalProjectile.DisplayName": "Dimensional Portal",
        "Projectiles.PliegueEspacioProjectile.DisplayName": "Fold of Space",
        "Projectiles.HeridaElectricaProjectile.DisplayName": "Electric Wound",
        "Projectiles.CorazonColapsoProjectile.DisplayName": "Heart of the Collapse",
        "Projectiles.GargantaVacioProjectile.DisplayName": "Throat of the Void",
        "Projectiles.UmbralRotoProjectile.DisplayName": "Broken Threshold",
        "Projectiles.LeviatanEspectralProjectile.DisplayName": "Spectral Leviathan",

        // v6.36: THE FOUR LIVING CODES (the image codes turned into
        // weapons) + THE RUNIC BACK RING.
        "Items.DanzaOrbesStaff.DisplayName": "The Dance of the Orbs",
        "Items.DanzaOrbesStaff.Tooltip": "Summons the living code of the chain: a miniature solar system orbiting you.\nEvery orb burns what it touches: sun x1.0, planets x0.7, moons x0.5.\n12 seconds of dance · one system at a time · no mana cost.",

        "Items.LenteAbismoStaff.DisplayName": "The Lens of the Abyss",
        "Items.LenteAbismoStaff.Tooltip": "Plants the living code of the black hole: a twenty-band disk,\na black horizon and bent stars falling in a spiral.\nThe lens bends the background · pull in 300 px · devours x1.2 · focuses and bites x0.6.",

        "Items.SolVivoStaff.DisplayName": "The Living Sun",
        "Items.SolVivoStaff.Tooltip": "Lights the living code of the sun: beating with the original's exact pulse.\nThe aura burns x0.55 · every pulse peak THUMPS x0.7 · prominences lash x0.85.\n5 seconds of sun · one sun at a time · no mana cost.",

        "Items.SierpeEstelarStaff.DisplayName": "The Star Serpent",
        "Items.SierpeEstelarStaff.Tooltip": "Releases the living code of the creature: sixteen segments — head,\ntwin fins and spine — swimming laps around your cursor.\nThe head pierces everything · the spine burns x0.4 · one serpent at a time.",

        "Items.AnilloRunicoDorsalItem.DisplayName": "The Runic Back Ring",
        "Items.AnilloRunicoDorsalItem.Tooltip": "The black hole's circle of conjuring hangs from your back:\nthe vortices' LITERAL runic triple crown — gold, counter-rotating\nviolet and intimate white beside the photon ring.\nPurely cosmetic: zero stats.",

        "Items.BolsaCodigosVivos.DisplayName": "Bag of Living Codes",
        "Items.BolsaCodigosVivos.Tooltip": "The image codes turned into weapons: the dance of the orbs,\nthe lens of the abyss, the living sun and the star serpent.\nEvery code learned to live here. Right-click to unfold them.\nOnly delivers what you are missing.",

        "Projectiles.DanzaOrbesProjectile.DisplayName": "Dance of the Orbs",
        "Projectiles.LenteAbismoProjectile.DisplayName": "Lens of the Abyss",
        "Projectiles.SolVivoProjectile.DisplayName": "Living Sun",
        "Projectiles.SierpeEstelarProjectile.DisplayName": "Star Serpent",

        // v6.38: THE SERPENT BROOD (10 new ways to move the same chain
        // + the hatchling minion — the original UNTOUCHED).
        "Items.OuroborosAstralStaff.DisplayName": "The Astral Ouroboros",
        "Items.OuroborosAstralStaff.Tooltip": "Twelve beads chase each other in a circle aiming ahead — nobody leads.\nEach bead sweeps x0.55; at expiry the spiral closes and DETONATES x2.0.\n10 seconds of ring · no mana cost.",

        "Items.CaravanaEspectralStaff.DisplayName": "The Spectral Caravan",
        "Items.CaravanaEspectralStaff.Tooltip": "The body repeats the lantern's EXACT trajectory: the path-memory.\nThe trail cleans the corridor x0.35 — with turns you draw S walls.\n9 seconds of caravan · no mana cost.",

        "Items.AnguilaSolarStaff.DisplayName": "The Solar Eel",
        "Items.AnguilaSolarStaff.Tooltip": "The body IS a formula: the eel's traveling wave, lambda ~= body length.\nCRESTS bite x1.0, troughs only x0.30 — graze with the crest.\n8 seconds of S-swimming · no mana cost.",

        "Items.CienpiesRunicoStaff.DisplayName": "The Runic Centipede",
        "Items.CienpiesRunicoStaff.Tooltip": "Twelve plates hugging the ground with a leg phase-shifted 45° each.\nPlanted legs leave their RUNE: the rune stings x0.40.\nThe gait raises its frequency far from prey · no mana cost.",

        "Items.FlageloEstelarStaff.DisplayName": "The Stellar Flagellum",
        "Items.FlageloEstelarStaff.Tooltip": "The Verlet whip with mass-weighted constraint: energy runs to the tip.\nThe tip strikes proportional to its speed (x0.5 -> x1.5); past 26 px/tick,\nTHE CRACK: x2.2 + screenshake. 8 seconds · no mana cost.",

        "Items.ViboraGenesiacaStaff.DisplayName": "The Genesis Viper",
        "Items.ViboraGenesiacaStaff.Tooltip": "One skeleton, two bodies: the serpent's spine and TWO braided strands.\nThe pearls burn x0.45; when the heading coils the helix compresses x1.6.\n9 seconds of viper · no mana cost.",

        "Items.BoaEclipseStaff.DisplayName": "The Eclipse Boa",
        "Items.BoaEclipseStaff.Tooltip": "The head draws the servo-spiral over the prey and the body wraps it.\nEach complete turn is a SQUEEZE stack: x0.5 -> x4.0.\nThe prey falls and it seeks the next. 10 seconds · no mana cost.",

        "Items.FarolGuardianStaff.DisplayName": "The Guardian Lantern",
        "Items.FarolGuardianStaff.Tooltip": "The base is a hanging lantern and the TIP chases the prey (FABRIK).\nThe hand bites x1.0 and the chain burns x0.40 — the body TENSES.\n12 seconds of guardian · no mana cost.",

        "Items.CintaAuroraStaff.DisplayName": "The Aurora Ribbon",
        "Items.CintaAuroraStaff.Tooltip": "The living banner: a spine anchored to your back and two incommensurable sines.\nThe ribbon cuts x0.5; the amplitude is YOUR SPEED — run and it whips.\n12 seconds of banner · no mana cost.",

        "Items.ManadaAstralStaff.DisplayName": "The Astral Pack",
        "Items.ManadaAstralStaff.Tooltip": "Six hunters with ELASTIC spacing and leadership that JUMPS.\nEach hunter strikes with ITS OWN speed: x0.55 -> x1.4.\n10 seconds of hunt · no mana cost.",

        "Items.CriaEstelarStaff.DisplayName": "The Star Hatchling",
        "Items.CriaEstelarStaff.Tooltip": "The star serpent's baby daughter: the SAME DNA, small and awake.\nAt rest she swims around you; on the hunt she charges (minion bite).\nTakes 1 minion slot · never expires · no mana cost.",

        "Items.BolsaSierpes.DisplayName": "Bag of Serpents",
        "Items.BolsaSierpes.Tooltip": "The star serpent and her eleven descendants: each swims differently.\nThe ring, the caravan, the eel, the centipede, the whip, the viper,\nthe boa, the lantern, the ribbon, the pack and the hatchling.\nOnly delivers what you are missing.",

        "Projectiles.OuroborosAstralProjectile.DisplayName": "Astral Ouroboros",
        "Projectiles.CaravanaEspectralProjectile.DisplayName": "Spectral Caravan",
        "Projectiles.AnguilaSolarProjectile.DisplayName": "Solar Eel",
        "Projectiles.CienpiesRunicoProjectile.DisplayName": "Runic Centipede",
        "Projectiles.FlageloEstelarProjectile.DisplayName": "Stellar Flagellum",
        "Projectiles.ViboraGenesiacaProjectile.DisplayName": "Genesis Viper",
        "Projectiles.BoaEclipseProjectile.DisplayName": "Eclipse Boa",
        "Projectiles.FarolGuardianProjectile.DisplayName": "Guardian Lantern",
        "Projectiles.CintaAuroraProjectile.DisplayName": "Aurora Ribbon",
        "Projectiles.ManadaAstralProjectile.DisplayName": "Astral Pack",
        "Projectiles.CriaEstelarMinion.DisplayName": "Star Hatchling",

        "Buffs.CriaEstelarBuff.DisplayName": "Star Hatchling",
        "Buffs.CriaEstelarBuff.Description": "A star serpent hatchling swims by your side and hunts your enemies",

        "Items.TajosAstralesStaff.DisplayName": "Staff of the Astral Cuts",
        "Items.TajosAstralesStaff.Tooltip": "Marks where you aim — ten ticks later THE CUT BLOOMS:\nseven white crescents in every direction, growing tip to tip.\nThe wound arrives when the slash appears (delayed causality).\nEach arc cuts its curved band once · no mana cost.",

        "Projectiles.TajoAstralProjectile.DisplayName": "Astral Slash",

        "Projectiles.AnillosSolaresHalo.DisplayName": "Solar Rings",
        "Projectiles.SelloGenesisHalo.DisplayName": "Genesis Seal",
        "Projectiles.AnilloRunicoDorsalHalo.DisplayName": "Dorsal Rune Ring",

        "Items.TomoApatiaNula.DisplayName": "Tome of Null Apathy",
        "Items.TomoApatiaNula.Tooltip": "The tome that feels nothing spits void tentacles:\nthey gestate for 2 seconds without harming (imploding pulses),\nthen lash out in three curves toward your cursor, teleporting\nbetween curves. Hits everything it touches (90×90) · each\nsuccessive hit weighs less.\nTEST WEAPON (exact replica of its study source).",

        "Projectiles.TentaculoCosmicoProjectile.DisplayName": "Void Tentacle",

        "Items.FragmentoSupernovaStaff.DisplayName": "Supernova Fragment",
        "Items.FragmentoSupernovaStaff.Tooltip": "The winged singularity made servant: the winged eye with\nafterimages orbiting and breathing around it (its signature).\nVOLLEY of 5 nova bursts in a fan · TELEGRAPHED beam of 900px (×2.5)\n· fire flower when each burst dies · no mana cost.\nMINION: takes 1 minion slot · never expires.\nTEST WEAPON (replica of the winged singularity boss).",

        "Projectiles.FragmentoSupernovaMinion.DisplayName": "Supernova Fragment",
        "Projectiles.RafagaNovaProjectile.DisplayName": "Nova Burst",

        "Buffs.FragmentoSupernovaBuff.DisplayName": "Supernova Fragment",
        "Buffs.FragmentoSupernovaBuff.Description": "A winged singularity hovers at your shoulder, firing bursts and beams at your enemies",

        "Items.BolsaHuespedes.DisplayName": "Bag of Guests",
        "Items.BolsaHuespedes.Tooltip": "The test replicas: the void tentacle, the supernova\nfragment and the astral cuts. Right click.\nOnly delivers what you're missing.",

        "Items.MetronomoPulsar.DisplayName": "The Pulsar Metronome",
        "Items.MetronomoPulsar.Tooltip": "The weapon that fires ON BEAT: the pulsar above your head ticks every 0.5s.\nPERFECT (±0.05s): guaranteed crit + double fan.\nGOOD (±0.1s): guaranteed crit. Off beat: the combo resets.\n8 hits in a row: THE LIGHTHOUSE — 3s of sweeping 900px beam.\nTEST WEAPON — no mana cost.",
        "Projectiles.MetronomoPulsarHalo.DisplayName": "Pulsar Metronome",
        "Projectiles.PulsoPulsarProjectile.DisplayName": "Pulsar Pulse",

        "Items.VelaSolar.DisplayName": "The Solar Sail",
        "Items.VelaSolar.Tooltip": "Hold: the photon sail unfurls and fire rate climbs\nfrom 12 to 30 shots/s with heat (damage ×1 → ×1.6).\nAt full heat: FUSION — 1.5s of ×2 plasma, then the sail melts (3s).\nReleasing in time keeps ~70% of the heat.\nTEST WEAPON — no mana cost.",
        "Projectiles.VelaSolarProjectile.DisplayName": "Solar Sail",
        "Projectiles.RafagaSolarProjectile.DisplayName": "Solar Burst",

        "Items.GuadanaDesgarro.DisplayName": "The Rend Reaper",
        "Items.GuadanaDesgarro.Tooltip": "The slash flies 220px and where it dies it opens A VERTICAL REALITY FISSURE (2s):\neverything crossing it bleeds, and enemy projectiles that touch it\nVANISH — it devours them and their damage joins YOUR NEXT SLASH.\nRight click: the fissure opens right at your cursor (≤480px).\nTEST WEAPON — no mana cost.",
        "Projectiles.TajoGuadanaProjectile.DisplayName": "Reaper Slash",
        "Projectiles.FisuraDesgarroProjectile.DisplayName": "Reality Fissure",

        "Items.EgidaNova.DisplayName": "The Nova Aegis",
        "Items.EgidaNova.Tooltip": "Left click: THE BASH — shield strike with knockback 9.\nRight click: RAISE GUARD (0.3s): a hit inside the perfect window\nDOES NOT EXIST — it detonates THE NOVA (3× + burn + 1s invulnerable).\nA guard that expires without a parry stuns you 0.5s. 8s cooldown (visible ring).\nTEST WEAPON — no mana cost.",
        "Projectiles.GuardiaNovaProjectile.DisplayName": "Nova Guard",
        "Projectiles.AnilloEnfriamientoProjectile.DisplayName": "Cooldown Ring",
        "Projectiles.NovaParryProjectile.DisplayName": "Parry Nova",
        "Projectiles.EmbestidaNovaProjectile.DisplayName": "Nova Bash",

        "Items.EcoCuantico.DisplayName": "The Quantum Echo",
        "Items.EcoCuantico.Tooltip": "Each pulse flies and decoheres into a seed that re-emits as an ECHO\nagainst the nearest enemy (60% · 36% · 21.6%: 2.17× per full chain).\nRight click: THE RESONANCE — all live seeds fire AT ONCE (5s cooldown).\nTEST WEAPON — no mana cost.",
        "Projectiles.PulsoEcoProjectile.DisplayName": "Quantum Pulse",

        "Items.VerboPrimordialStaff.DisplayName": "The Primordial Word",
        "Items.VerboPrimordialStaff.Tooltip": "The word that spoke the first light — SEVEN MOVEMENTS:\nI THE PULSE · II THE SEAL · III THE CROWN · IV THE STORM\nV THE FIRE · VI THE REND · VII THE SYMPHONY\nEach movement speaks with the libraries of the house; damage climbs ×1.0 → ×1.4\nand at the seventh second: THE DETONATION (2.5× + burn).\nTEST WEAPON — no mana cost.",
        "Projectiles.VerboPrimordialProjectile.DisplayName": "The Primordial Word",
        "Projectiles.VerboDetonacionProjectile.DisplayName": "Word Detonation",

        "Items.BolsaApuestas.DisplayName": "Bag of Bets",
        "Items.BolsaApuestas.Tooltip": "The five bets of the house (rhythm, cadence, zone,\nparry and echo) and THE PRIMORDIAL WORD that binds them. Right click.\nOnly delivers what you are missing.",

        "Common.LevelUp": "Your weapon has reached level {0}!",
        "Common.Milestone": "Milestone reached: {0}",

        "Items.PrismaDePaisajesItem.DisplayName": "The Landscape Prism",
        "Items.PrismaDePaisajesItem.Tooltip": "The sky library tester: each use unfurls AN ENTIRE LANDSCAPE\nover the world's background — layers with their own parallax, drift,\ndepth and their sky, light and brightness tints.\nCycle: Umbral Eclipse → Starfall Rain → Primordial Dawn → Violet Sanctum → clear sky.\nTHE VIOLET SANCTUM: the place's landscape, unfurled wherever you stand.\nTEST WEAPON — no mana cost.",

        "Eco.VozJefe.KingSlime1": "The crown rolls across the floor. The grimoire slurps the King Slime's essence: sweet, hollow, from a throne that was never his.",
        "Eco.VozJefe.KingSlime2": "A king of gelatin: all the kingdom, none of the bone. The grimoire drinks him in one gulp and burps a blue thunder.",
        "Eco.VozJefe.KingSlime3": "The slime king dissolves into the grass. The grimoire chews the crown separately — metal tastes of nothing, but it keeps it out of politeness.",
        "Eco.VozJefe.EyeofCthulhu1": "The eye closes forever. The grimoire devours its hungry vigil — now it knows how to dream of what you see.",
        "Eco.VozJefe.EyeofCthulhu2": "The great eye goes dark without closing its eyelids — it never had any. The grimoire crumbles it and learns to weep inward.",
        "Eco.VozJefe.EyeofCthulhu3": "Cthulhu lost everything but his sight. The grimoire keeps the sight: now it watches what YOU watch, whenever it wants.",
        "Eco.VozJefe.Deerclops1": "The walking winter falls to its knees. The grimoire drinks its ancestral frost and the pages crackle, frozen, for a single breath.",
        "Eco.VozJefe.Deerclops2": "The one-eyed stag will never see the blizzard again. The grimoire sips its winter and the letters of the index grow frost.",
        "Eco.VozJefe.Deerclops3": "The forest guardian falls like a tree. The grimoire counts its rings of frost — a century's dinner in one winter's swallow.",
        "Eco.VozJefe.EaterofWorlds1": "The Eater of Worlds has been eaten. The essence of a hundred corrupted maws pours into the grimoire… and it asks for more.",
        "Eco.VozJefe.EaterofWorlds2": "A hundred maws and not a single word. The grimoire devours it segment by segment, like peeling a bitter fruit.",
        "Eco.VozJefe.EaterofWorlds3": "The devourer, devoured: that is how guilt tastes. The grimoire licks the corruption from the plate and leaves the fork clean.",
        "Eco.VozJefe.BrainofCthulhu1": "The crimson brain falls silent. The grimoire bites into its reflections and learns to scream in red.",
        "Eco.VozJefe.BrainofCthulhu2": "The crimson brain thought it could take everything. The grimoire does its thinking now — and thinks it HUNGRY.",
        "Eco.VozJefe.BrainofCthulhu3": "The thinking mass dissolves into pink reflections. The grimoire copies its nerves into the margin: calligraphic, taut, alive.",
        "Eco.VozJefe.QueenBee1": "The hive mourns. The grimoire licks the royal honey from the Queen Bee — sweetness with a sting: its favorite flavor.",
        "Eco.VozJefe.QueenBee2": "The queen dies and the hive forgets her name. The grimoire takes notes for her: 'sweet, with anger, brief as summer.'",
        "Eco.VozJefe.QueenBee3": "The royal bee's last hum. The grimoire keeps the stinger as a clasp — it closes the chapter and pricks the next one.",
        "Eco.VozJefe.Skeletron1": "The guardian's bones crumble back to dust. The grimoire copies his curse by hand — the next door won't stop it.",
        "Eco.VozJefe.Skeletron2": "The gate guardian bites the dust he was. The grimoire picks up the skull: light to carry, heavy with promises.",
        "Eco.VozJefe.Skeletron3": "Curse fulfilled, bones paid. The grimoire signs the receipt with the old man's hand — the handwriting trembles, the account is settled.",
        "Eco.VozJefe.WallofFlesh1": "The wall between worlds burns down to ash. The grimoire swallows its ancient hunger and AWAKENS: from today, everything that dies is worth double.",
        "Eco.VozJefe.WallofFlesh2": "The wall burned with old hunger, and the old hunger burned. The grimoire swallows THE LIMIT and opens its eyes wide.",
        "Eco.VozJefe.WallofFlesh3": "The wall fell and the world took its first deep breath. The grimoire too: now it knows what dawn tastes like.",
        "Eco.VozJefe.QueenSlime1": "The crystal queen melts into sugar. The grimoire tastes her fleeting essence — so light it nearly slips between the pages.",
        "Eco.VozJefe.QueenSlime2": "Sugar and crystal: the queen melts into her own carnival. The grimoire quietly asks for a second dessert.",
        "Eco.VozJefe.QueenSlime3": "The bouncing queen deflates into confetti. The grimoire sweeps it ALL up with its tongue — the confetti included.",
        "Eco.VozJefe.Twins1": "The twins fall from the sky like broken stars. The grimoire plucks their burning lenses and, at last, sees double.",
        "Eco.VozJefe.Twins2": "Two eyes, a single way of looking: yours, burning. The grimoire keeps them on facing pages and makes them compete.",
        "Eco.VozJefe.Twins3": "Retinazer and Spazmatism, extinguished together. The grimoire blinks with both and sees twice the future.",
        "Eco.VozJefe.Destroyer1": "The steel serpent roars and goes dark; a thousand probes fall with it. The grimoire winds its metal soul like thread and harvests it.",
        "Eco.VozJefe.Destroyer2": "A thousand red eyes go dark in a row, like a city at night. The grimoire drinks the light of each one: a toast per probe.",
        "Eco.VozJefe.Destroyer3": "The steel serpent no longer pierces the sky. The grimoire spins its metal soul into thread and stitches the tome's spine with it.",
        "Eco.VozJefe.SkeletronPrime1": "The Prime returns to its tomb, headless. The grimoire takes its four arms apart and signs with the saw.",
        "Eco.VozJefe.SkeletronPrime2": "Four arms and not one head to drive them. The grimoire inherits the tools and gets to work.",
        "Eco.VozJefe.SkeletronPrime3": "The Prime fits its pieces together one last time. The grimoire scribbles over its tomb with the drill — the final underline.",
        "Eco.VozJefe.Plantera1": "The jungle breathes its last. The grimoire crushes Plantera's petals and drinks her chloro-fury.",
        "Eco.VozJefe.Plantera2": "The green fury wilts all at once. The grimoire inhales the pollen of defeat — it goes to its head, it loves it.",
        "Eco.VozJefe.Plantera3": "Plantera falls and the jungle goes still. The grimoire presses her chloro-fury between two leaves: living ink for the next map.",
        "Eco.VozJefe.Golem1": "The stone guardian crumbles in the temple. The grimoire extracts its solar core and uses it as a bookmark.",
        "Eco.VozJefe.Golem2": "The stone guardian stops burning. The grimoire drinks the core like a sip of sun — and burps warm sand.",
        "Eco.VozJefe.Golem3": "Stone that walked, sun it kept. The grimoire takes the sun, leaves the stone — it is learning to choose.",
        "Eco.VozJefe.DukeFishron1": "The Duke dies far from his storm. The grimoire savors his salty essence — pig, dragon and hurricane in a single bite.",
        "Eco.VozJefe.DukeFishron2": "The Duke dies with the storm far from home. The grimoire serves him in three courses: pig, dragon, cold tornado.",
        "Eco.VozJefe.DukeFishron3": "Shark-boar of the winds: a rare recipe. The grimoire files it among the delicacies — 'cook with rage,' it notes.",
        "Eco.VozJefe.EmpressOfLight1": "The Empress dissolves into a flash. The grimoire cannot devour pure light — so it PRESSES it between two pages, forever.",
        "Eco.VozJefe.EmpressOfLight2": "The Empress of Light did not fall: she surrendered to the prism. The grimoire keeps a gleam of her gown as the cover illustration.",
        "Eco.VozJefe.EmpressOfLight3": "Pure light cannot be digested — only respected. The grimoire folds it in four and files it beside the definition of 'beauty.'",
        "Eco.VozJefe.LunaticCultist1": "The cult falls voiceless. The grimoire dons his ritual mask and rehearses, in whispers, the summoning of the end.",
        "Eco.VozJefe.LunaticCultist2": "The last cultist dies mid-sentence. The grimoire finishes the sentence for him — and the sentence was the end of the world.",
        "Eco.VozJefe.LunaticCultist3": "The mask rolls across the altar. The grimoire picks it up and tries it on: too loose, but the hatred is its size.",
        "Eco.VozJefe.MoonLord1": "The Lord of the Moon exhales his last light. The grimoire stays silent, for once… then writes: 'thanks for the food.'",
        "Eco.VozJefe.MoonLord2": "The Lord of the Moon lets go of the last light and everything goes still. The grimoire closes the menu: 'feast over — will reopen at dawn.'",
        "Eco.VozJefe.MoonLord3": "He who watched through three falls. The grimoire keeps all three gazes — one for the past, one for you, the last for what comes.",
        "Eco.VozJefe.Desconocido1": "A greater power has fallen. The grimoire devours its essence without asking for a name.",
        "Eco.VozJefe.Desconocido2": "Something enormous died here and nobody wrote down the name. The grimoire eats the essence anyway — anonymity feeds too.",
        "Eco.VozJefe.Desconocido3": "An unlabeled power falls from the sky. The grimoire devours it blind and files it under 'D': for delicious.",

        "Eco.VozJefe.Aethon1": "The Primordial Light dims by its own will. The grimoire keeps a blank page — for once, it eats in silence.",
        "Eco.VozJefe.Aethon2": "The Primordial Light chooses its own shadow. The grimoire reserves a blank page for it — some meals are digested praying.",
        "Eco.VozJefe.Aethon3": "Aethon goes out like a classroom at the end of the lesson. The grimoire copies the last lesson BY HEART — and signs it with fear.",
        "Eco.VozJefe.HollowTitan1": "The crystal colossus collapses in chimes. The grimoire slurps its hollow echo: the resonance of a guardian with nothing left to guard.",
        "Eco.VozJefe.HollowTitan2": "The colossus rings inside one last time: a broken bell. The grimoire drinks the resonance, and now the tome's spine tolls with every step.",
        "Eco.VozJefe.HollowTitan3": "The hollow guardian empties completely. The grimoire moves into the hollow — some places are inherited by chewing.",
        "Eco.VozJefe.RiftKeeper1": "The keeper folds into its own rift and vanishes. The grimoire learns the trick and files it between chapters.",
        "Eco.VozJefe.RiftKeeper2": "The keeper closes like the door he was. The grimoire learns the lock's blueprint: the tome's TEETH change shape.",
        "Eco.VozJefe.RiftKeeper3": "The sentinel folds onto its own seam of the world. The grimoire copies it into the margin — page torn, knowledge whole.",
        "Eco.VozJefe.LosEcos1": "The previous bearers return to the stardust they always were. The grimoire closes their files — and leafs through YOURS.",
        "Eco.VozJefe.LosEcos2": "Archer and duelist return to the dust they were. The grimoire leafs through THEIR lines and erases the previous bearer's name — you know which one.",
        "Eco.VozJefe.LosEcos3": "The bearers you were fall together: the house gets cleaned. The grimoire opens YOUR file at the middle page and clicks its tongue.",

        "Eco.VozCincoEstrellas": "The rarest thing it has ever eaten. The grimoire keeps the recipe — in case luck strikes twice.",

        "Eco.Hambre.Susurro1": "The grimoire is hungry…",
        "Eco.Hambre.Susurro2": "The grimoire is hungry… the pages lick themselves…",
        "Eco.Hambre.Susurro3": "The grimoire is HUNGRY… the clasps are creaking…",
        "Eco.Hambre.Susurro4": "…hungry… HUNGRY… HUNGRY…",

        "Eco.Furia.Ira": "The grimoire is FURIOUS for going so long without eating…",
        "Eco.Furia.Llamada": "The grimoire calls its food…",
        "Eco.Furia.Saciado": "The grimoire is sated… for now.",

        "Furia.Oleada": "Wave {0} of {1} — the grimoire spits out its food. XP ×{2} this wave.",
        "Furia.OleadaFinal": "FINAL WAVE {0} of {1} — the book is black with rage. The aura rots: black-gray, red edges.",
        "Furia.Jefe": "The hunger summons a guardian: {0} (XP ×{1})",
        "Furia.JefeHuido": "{0} sinks away, unsatisfied…",

        "Llamado.SoloDia": "The call only answers BY DAY — the night belongs to eyes and the dead.",
        "Llamado.YaVive": "One already lives. The call does not double.",

        "Carnada.Preparadas": "The bait will serve {0} waves. (Right click to change)",
        "Bolsa.Abierta": "Bag opened: {0} types of summoners received (999 each).",
        "Carnada.YaActivo": "The fury is ALREADY unleashed — feed it or survive.",
        "Carnada.Ocupado": "The world is busy (a boss or an invasion). The bait waits its turn.",

        "Altar.Solicitando": "Requesting the Genesis Shard from the altar...",
        "Altar.Reclamado": "You have claimed the Genesis Shard.",
        "Altar.YaPosees": "You already own the Genesis Shard.",
        "Tiles.AncientAltar.MapEntry": "Ancient Altar",
        "LevelUpTester.Subida": "✦ {0} gained +{1} levels (now level {2}).",
        "LevelUpTester.SinGrimorio": "No Grimoire of the Eternal found in the inventory.",
        "TestingPlayer.Bolsas": "The arsenal bags arrive with you (one per category): right click to open each one.",
        "TestingPlayer.Dummies": "Also: {0} test dummies for the training field.",
        "Configs.AethonConfigServidor.DisplayName": "Aethon (server)",

        "Testigo.Ambiente1": "I watched you before you had a name.",
        "Testigo.Ambiente2": "The book you carry… I saw the first one being born.",
        "Testigo.Ambiente3": "Every bearer ends up as a page. Yours is still being written.",

        "Conditions.TiendaEsencias": "Survive wave 10 of the grimoire's fury",

        "Projectiles.AtaqueJefeProjectile.DisplayName": "Warden's Fang",

        "Jefe.Resonancia": "You absorbed {1} resonance shards from {0}!",

        "Jefe.Titan.Furia": "THE HOLLOW TITAN DOUBLES DOWN — the crystal crackles with fury. The choir comes in fast mode.",
        "Jefe.Rift.Sello": "THE KEEPER SEALS THE RIFTS — the between-worlds closes around you.",
        "Jefe.Rift.Paredes": "The TEAR WALLS advance — the arena is narrowing.",
        "Jefe.Arquera.Furia": "THE ARCHER DOES NOT FORGET — the bow draws double and the mines rain down.",
        "Jefe.Arquera.Lluvia": "The Archer calls the STARFALL — watch the ground markers.",
        "Jefe.Portador.Furia": "THE FIRST BEARER UNSHEATHES REALITY — his weapon is no longer just the blade.",
        "Jefe.Aethon.Fase": "Aethon — PHASE {0}: {1}",
        "Jefe.Aethon.Nombre1": "The Stardust",
        "Jefe.Aethon.Nombre2": "The Nebula",
        "Jefe.Aethon.Nombre3": "The Gravity",
        "Jefe.Aethon.Nombre4": "The Black Hole",
        "Jefe.Aethon.Nombre5": "The Acknowledgment",
        "Jefe.Aethon.Gravedad": "Aethon bends gravity — THE FLOOR IS NO LONGER YOURS!",
        "Jefe.Aethon.Recordar": "AETHON REMEMBERS — the runes he memorized from you return to their owner.",
        "Jefe.Aethon.Reconocimiento": "Aethon acknowledges you as an equal. THE ASCENDED FORM falls at your feet.",

        "Testigo.Chat.SinLibro": "I have watched you. You have not yet claimed the Genesis Shard. Look for the Hollow Sanctum underground.",
        "Testigo.Chat.Debil": "Your shard glows at level {0}. Still weak. Keep fighting.",
        "Testigo.Chat.Recuerda": "Level {0}… The shard begins to remember its origin. The Starlight Rain approaches.",
        "Testigo.Chat.Sagrario": "Level {0}. The Hollow Sanctum answers your power. Dimensional rifts lurk.",
        "Testigo.Chat.Ecos": "Level {0}. Aethon stirs in his dreams. The Echoes of former bearers will come for you.",
        "Testigo.Chat.Despierta": "Level {0}. Aethon is about to wake. Prepare for the acknowledgment.",
        "Testigo.Chat.Espera": "Level {0}. Aethon awaits you. Go to the Hollow Sanctum and call his name.",
        "Testigo.BotonResonancia": "Buy Resonance (10 coins)",
        "Testigo.BotonEsencias": "Wardens' Essences",
        "Testigo.EsenciasBloqueadas": "The Witness keeps the drawer shut: essences belong only to those who SURVIVED wave 10 of the fury.",
        "Testigo.ResonanciaEntregada": "The Witness hands you a Resonance Shard.",
        "Testigo.ResonanciaBloqueada": "The Witness only shares resonance with bearers of level 50+.",

        "Testigo.Cronica.KingSlime": "Chronicle of King Slime: he rolled after his crown until the very end. Nobody told him crowns are not food.",
        "Testigo.Cronica.EyeofCthulhu": "Chronicle of the Eye: it closed its lid one last time. I saw what it watched — it watched YOU.",
        "Testigo.Cronica.Deerclops": "Chronicle of Deerclops: the walking winter knelt. Beneath its breath there was frost… and relief.",
        "Testigo.Cronica.QueenBee": "Chronicle of the Queen: she shed her stinger and with it the whole hive. Royal honey tastes of farewell.",
        "Testigo.Cronica.EaterofWorlds": "Chronicle of the Eater: every segment died believing it was the head. The book thought the same.",
        "Testigo.Cronica.BrainofCthulhu": "Chronicle of the Brain: its reflections screamed red as it fell. The echo outlived it.",
        "Testigo.Cronica.Skeletron": "Chronicle of Skeletron: the curse released him at last. He spoke your name with the Old Man's mouth.",
        "Testigo.Cronica.WallofFlesh": "Chronicle of the Wall: the night of hunger that opened hardmode. The book does not tell doors from food.",
        "Testigo.Cronica.QueenSlime": "Chronicle of Queen Slime: the sugar melted in the rain. She hopped to the end — she liked to play.",
        "Testigo.Cronica.Twins": "Chronicle of the Twins: they fell watching each other. Two eyes, a single defeat.",
        "Testigo.Cronica.Destroyer": "Chronicle of the Destroyer: the machine came apart in a spiral. Its drones kept firing a while — loyalty cannot read life.",
        "Testigo.Cronica.SkeletronPrime": "Chronicle of Prime: the four arms fell each on its own side. The head took its time accepting it.",
        "Testigo.Cronica.Plantera": "Chronicle of Plantera: the jungle went silent. Bulbs that never opened.",
        "Testigo.Cronica.Golem": "Chronicle of the Golem: the temple lost its guardian. His fists finally rested.",
        "Testigo.Cronica.DukeFishron": "Chronicle of the Duke: the pig-fish fell with honor intact. He asked for a clean fight and got it.",
        "Testigo.Cronica.EmpressOfLight": "Chronicle of the Empress: light bowed before light. Elegant even in death.",
        "Testigo.Cronica.LunaticCultist": "Chronicle of the Cultist: the ritual stayed half-done. He thought he summoned the Moon; he summoned his end.",
        "Testigo.Cronica.MoonLord": "Chronicle of the Moon Lord: three eyes and a core, all closing at once. I was there — nobody else saw him whole.",
        "Testigo.Cronica.Aethon": "Chronicle of Aethon: the Primordial Light went out ACKNOWLEDGING you. I saw his first light being born — it honors me to have seen his last.",
        "Testigo.Cronica.HollowTitan": "Chronicle of the Titan: the colossus crumbled into the Sanctum's crystal. He was the oldest guardian… and the first to fall.",
        "Testigo.Cronica.RiftKeeper": "Chronicle of the Keeper: he withdrew through his own tear. He chose the void over the page.",
        "Testigo.Cronica.LosEcos": "Chronicle of the Echoes: the Archer and the Bearer went out together. They were people, you know? Before the first book.",
        "Testigo.Cronica.Desconocido": "Nameless chronicle: something died and the book ate it. I saw it… but my pages do not remember it.",

        "Esencia.SinLibro": "The soul looks for an Eternal Grimoire in your hotbar — the book is the one who tastes it.",
        "Esencia.Sabor1": "A whole soul… it tastes of victory and distant sulfur.",
        "Esencia.Sabor2": "The warden's soul goes down clean — one more level on the spine.",
        "Esencia.Sabor3": "Warden digested. His story is my page now.",

        "Items.EsenciaDelReyGelatina.DisplayName": "Essence of King Slime",
        "Items.EsenciaDelReyGelatina.Tooltip": "The sweet soul of the rolling throne.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDelOjoDeCthulhu.DisplayName": "Essence of the Eye of Cthulhu",
        "Items.EsenciaDelOjoDeCthulhu.Tooltip": "The hungry vigil, dreaming of you.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDeDeerclops.DisplayName": "Essence of Deerclops",
        "Items.EsenciaDeDeerclops.Tooltip": "The ancestral frost of the walking winter.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDeLaAbejaReina.DisplayName": "Essence of the Queen Bee",
        "Items.EsenciaDeLaAbejaReina.Tooltip": "Royal honey with a sting.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDelDevoradorDeMundos.DisplayName": "Essence of the Eater of Worlds",
        "Items.EsenciaDelDevoradorDeMundos.Tooltip": "A hundred corrupted maws on one thread.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDelCerebroDeCthulhu.DisplayName": "Essence of the Brain of Cthulhu",
        "Items.EsenciaDelCerebroDeCthulhu.Tooltip": "The reflections that scream in red.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",
        "Items.EsenciaDeSkeletron.DisplayName": "Essence of Skeletron",
        "Items.EsenciaDeSkeletron.Tooltip": "The curse copied freehand.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.",

        "Items.EsenciaDelTitanHueco.DisplayName": "Essence of the Hollow Titan",
        "Items.EsenciaDelTitanHueco.Tooltip": "The soul of the Sanctum's crystal colossus.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.\nOnly drops 10 times per world: crystal doesn't repeat itself.",
        "Items.EsenciaDelGuardianDelRift.DisplayName": "Essence of the Rift Keeper",
        "Items.EsenciaDelGuardianDelRift.Tooltip": "The soul of the between-worlds sentinel.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.\nOnly drops 10 times per world: the threshold repeats no guests.",
        "Items.EsenciaDeLaArqueraEstelar.DisplayName": "Essence of the Stellar Archer",
        "Items.EsenciaDeLaArqueraEstelar.Tooltip": "The soul of the echo who never dropped the bow.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.\nOnly drops 10 times per world: echoes aren't cloned.",
        "Items.EsenciaDelPrimerPortador.DisplayName": "Essence of the First Bearer",
        "Items.EsenciaDelPrimerPortador.Tooltip": "The soul of the echo who never dropped the blade.\nRaises the Eternal Grimoire ONE WHOLE LEVEL.\nOnly drops 10 times per world: the blade isn't inherited.",
        "Items.EsenciaDeAethon.DisplayName": "Essence of Aethon",
        "Items.EsenciaDeAethon.Tooltip": "The soul of the Primordial Light — the one\nwho acknowledged you as an equal. Raises the Eternal\nGrimoire ONE WHOLE LEVEL. Only 10 per world: not even light gives twice.",

        "Items.CoronaRunicoAuraItem.DisplayName": "The Runic Aura Crown",
        "Items.CoronaRunicoAuraItem.Tooltip": "AURALIB's rune pentagon: a five-sided cage\nspinning around you — the Sanctum's violet at the\ncenter, the grimoire's GOLD on the edges.\nPure cosmetic (drawn by the additive BEARER).",
        "Items.FormaAscendidaItem.DisplayName": "The Ascended Form",
        "Items.FormaAscendidaItem.Tooltip": "The Primordial Light's aura breathing around you.\nAethon dropped it upon acknowledging you as an equal.\nPure cosmetic — the crown of one who no longer needs to summon it.",

        "Eco.Celos.Melee1": "Does that kill too?… It looks heavy.",
        "Eco.Celos.Melee2": "A sword? I have a THOUSAND sharpened pages.",
        "Eco.Celos.Melee3": "Bring it closer… and I'll tell you what it tastes like.",
        "Eco.Celos.Magia1": "Magic? I AM magic with covers.",
        "Eco.Celos.Magia2": "That staff whispers. Whispers are MY territory.",
        "Eco.Celos.Magia3": "Mana spent on borrowed light… I EAT light.",
        "Eco.Celos.Invocacion1": "You summon OTHERS? In front of ME?",
        "Eco.Celos.Invocacion2": "Those slaves won't read you bedtime stories.",
        "Eco.Celos.Invocacion3": "Minions. Plural. While I've waited centuries for my turn.",
        "Eco.Celos.Arrojadiza1": "Throwing things… that's how it all started, you know?",
        "Eco.Celos.Arrojadiza2": "Boomerangs. I already ate the guy who invented them.",
        "Eco.Celos.Arrojadiza3": "You waste arm and style. I only have hunger.",
        "Eco.Celos.Arco1": "A bow? The Archer used one. She ended up as a page.",
        "Eco.Celos.Arco2": "Arrows… the liquid diet of poor weapons.",
        "Eco.Celos.Arco3": "Draw that string all you want. I'm already drawn.",
        "Eco.Celos.Bala1": "Noise and metal. No taste.",
        "Eco.Celos.Bala2": "Bullets leave no SOUL. Only holes.",
        "Eco.Celos.Bala3": "Gunpowder at dusk… and then, nothing. I eat the then.",

        "Eco.Bioma.Infierno1": "The grimoire is hungry… and down here everything tastes of sulfur.",
        "Eco.Bioma.Infierno2": "Fire-flesh. Plenty. It burns the page.",
        "Eco.Bioma.Infierno3": "Hell-salt on the edge of my mouth.",
        "Eco.Bioma.Mazmorra1": "Old bones: the dungeon tastes of mold and broken promises.",
        "Eco.Bioma.Mazmorra2": "This tower's curse no longer feeds even its owners.",
        "Eco.Bioma.Mazmorra3": "Centuries-old skulls. Vintage, yes… but vintage.",
        "Eco.Bioma.Corrupcion1": "Corrupted flesh… bitter, but NOURISHING.",
        "Eco.Bioma.Corrupcion2": "This land bleeds purple. My favorite sauce.",
        "Eco.Bioma.Corrupcion3": "The eaters here taste of themselves. Food circle.",
        "Eco.Bioma.Carmesi1": "The crimson seeps. Better drunk than chewed.",
        "Eco.Bioma.Carmesi2": "Even the walls have a pulse here. Fresh.",
        "Eco.Bioma.Carmesi3": "They call this rain blood. I call it WEATHER.",
        "Eco.Bioma.Nieve1": "The snow is quiet. Even the food is silent here.",
        "Eco.Bioma.Nieve2": "Frost on the palate: cold, slow, patient.",
        "Eco.Bioma.Nieve3": "The walking winter passed by here. Smells of Deerclops.",
        "Eco.Bioma.Jungla1": "Jungle flesh: green, juicy, full of thorns.",
        "Eco.Bioma.Jungla2": "The Queen's honey drips nearby. I can HEAR it.",
        "Eco.Bioma.Jungla3": "Spores, leaves, frenzy. This is eaten with both covers open.",
        "Eco.Bioma.Desierto1": "The desert only has dry bones and rattles.",
        "Eco.Bioma.Desierto2": "Sand between the pages. At least it CRUNCHES.",
        "Eco.Bioma.Desierto3": "The worms here bite back. Seasoning.",
        "Eco.Bioma.Playa1": "Salt, sand and crabs. A poor menu, but fresh.",
        "Eco.Bioma.Playa2": "The sea spits the food onto the shore. Table service.",
        "Eco.Bioma.Playa3": "Smells of fish and other people's treasures. Both are eaten.",
        "Eco.Bioma.Sagrado1": "Crystal sweetness… the hallow leaves an aftertaste of rainbow.",
        "Eco.Bioma.Sagrado2": "Even the light here is EDIBLE. Floating desserts.",
        "Eco.Bioma.Sagrado3": "Unicorns: the smuggest meat on the menu.",
        "Eco.Bioma.Subsuelo1": "Down here the food is gray, but plentiful.",
        "Eco.Bioma.Subsuelo2": "Damp caves: mushrooms, bats, echoes. I know about echoes.",
        "Eco.Bioma.Subsuelo3": "Stone keeps warmth and corpses. Both feed.",
        "Eco.Bioma.Cielo1": "The sky is light food. Barely fills a page.",
        "Eco.Bioma.Cielo2": "Floating islands: harpies with a view. MENU WITH A VIEW.",
        "Eco.Bioma.Cielo3": "Eating at altitude makes you dizzy… and hungry.",
        "Eco.Bioma.Superficie1": "The grimoire is hungry… and the surface is the buffet.",
        "Eco.Bioma.Superficie2": "Grass, bandits and night eyes. An everyday menu.",
        "Eco.Bioma.Superficie3": "The sun warms the meat up there. Come, let me taste it.",

        "Eco.Furia.Juicio": "THE FINAL WAVE: ALL THE WARDENS AT ONCE. The book's judgment begins…",
        "Eco.Furia.JuicioFin1": "Sated… for now. The judgment has been PAID.",
        "Eco.Furia.JuicioFin2": "The seven fell. The judgment's last page is written.",
        "Eco.Furia.JuicioFin3": "Full feast. The book closes its mouth… and smiles.",
        "Eco.Furia.Venganza1": "You let me starve. I WILL REMEMBER.",
        "Eco.Furia.Venganza2": "The bearer fell… and the feast was left without an owner. What WASTE.",
        "Eco.Furia.Venganza3": "You died BEFORE feeding me. Double insult.",
        "Eco.Furia.Venganza4": "One more page that begins with your name.",

        "Furia.DerechoEsencias": "The Witness will open his DRAWER OF ESSENCES for you — wave 10 has been paid.",
        "Furia.OleadaEspecial": "THE JUDGMENT: all SEVEN wardens at once, ×15 on EVERYTHING. The final feast.",
        "Furia.MuertePortador": "The feast dies with its bearer. The book TAKES NOTE.",

        "Esencia.CofreSeco": "{0}'s chest of souls is DRY in this world — ten pages, story closed.",
        "Esencia.UltimaAlma": "{0}'s LAST soul fell. Its story in this world is complete.",

