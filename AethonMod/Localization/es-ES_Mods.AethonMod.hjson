        "Items.SolRunico18Staff.DisplayName": "Bastón del Sol Rúnico XVIII",
        "Items.SolRunico19Staff.DisplayName": "Bastón del Sol Rúnico XIX",
        "Items.SolRunico20Staff.DisplayName": "Bastón del Sol Rúnico XX",
        // v6.22: EL ECLIPSE PRIMORDIAL — el Sol de los 20 Anillos fundido
