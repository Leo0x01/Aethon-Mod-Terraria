        "Items.SolRunico12Staff.DisplayName": "Bastón del Sol Rúnico XII",
        "Items.SolRunico13Staff.DisplayName": "Bastón del Sol Rúnico XIII",
        "Items.SolRunico14Staff.DisplayName": "Bastón del Sol Rúnico XIV",
