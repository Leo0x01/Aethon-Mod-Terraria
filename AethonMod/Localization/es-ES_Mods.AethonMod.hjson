        // v6.19: EL CETRO DEL TRUENO — el arma de rayos (LightningCore)
        "Items.StormRuneStaff.DisplayName": "Cetro del Trueno Rúnico",

        // v6.18: LAS ALAS FUERON BORRADAS DEL MOD (petición del usuario).

        "Projectiles.BlackHoleProjectile.DisplayName": "Agujero Negro",
        "Projectiles.SunProjectile.DisplayName": "Sol",
        "Projectiles.CosmicShockwaveProjectile.DisplayName": "Onda de Choque Cósmica",
