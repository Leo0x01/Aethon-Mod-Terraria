{
        "Mods.AethonMod.DisplayName": "Aethon, la Luz Primordial",

        "Items.GenesisShard.DisplayName": "Fragmento Génesis",
        "Items.GenesisShard.Tooltip": "Arma de luz que dispara partículas autoguiadas.\nMaterial para craftear el Grimorio del Eterno.\nDropea de King Slime y Eye of Cthulhu.",

        "Items.AncientAltarItem.DisplayName": "Altar Antiguo",
        "Items.ResonanceShard.DisplayName": "Fragmento de Resonancia",
        "Items.ResonanceShard.Tooltip": "Moneda cósmica. Se obtiene de jefes.",

        "Items.GrimoireEternal.DisplayName": "Grimorio del Eterno",
        "Items.GrimoireEternal.Tooltip": "Arma híbrida mágica/de invocación.\nClick izq: bolt arcano. Click der: invoca minion.",

        "Items.BossSummonBag.DisplayName": "Bolsa de Invocadores",
        "Items.BossSummonBag.Tooltip": "Contiene 999 invocadores de cada jefe.\nItem de testing — eliminar antes de release.",
        "Items.LevelUpTester.DisplayName": "Verdugo de Niveles",
        "Items.LevelUpTester.Tooltip": "Da +10 niveles al Grimorio del Eterno.\nBusca en todo el inventario.\nItem de testing — eliminar antes de release.",

        "Projectiles.ArcaneBolt.DisplayName": "Bolt Arcano",
        "Projectiles.GenesisLight.DisplayName": "Luz del Génesis",
        "Projectiles.CosmicOrbMinion.DisplayName": "Orbe Cósmico",
        "Projectiles.CosmicOrbBolt.DisplayName": "Bolt Cósmico",
        "Projectiles.AnillosSingularesHalo.DisplayName": "Anillos del Horizonte",

        "Buffs.CosmicOrbBuff.DisplayName": "Orbe Cósmico",
        "Buffs.CosmicOrbBuff.Description": "Un orbe de luz cósmica te sigue y dispara a tus enemigos",

        "Items.MedusaNebularStaff.DisplayName": "Báculo de la Medusa Nebular",
        "Items.MedusaNebularStaff.Tooltip": "Invoca LA MEDUSA NEBULAR.\nUna campana translúcida con una galaxia espiral dentro, nadando a pulsos de gravedad.\nSu campana dispara LÁTIGOS ELÉCTRICOS que salen de ella misma, dejando la quemadura fría del vacío.",

        "Projectiles.NebulaJellyfishMinion.DisplayName": "Medusa Nebular",
        "Projectiles.NebulaLightning.DisplayName": "Rayo Nebular",

        "Buffs.NebulaJellyfishBuff.DisplayName": "Medusa Nebular",
        "Buffs.NebulaJellyfishBuff.Description": "Una medusa de nebulosa deriva a tu lado a pulsos de gravedad",

        "Items.LivingCometStaff.DisplayName": "Báculo del Cometa Estelar",
        "Items.LivingCometStaff.Tooltip": "Invoca EL COMETA ESTELAR.\nUn cometa vivo con corona de 8 puntas estelares, orbitándote en una elipse excéntrica.\nCAE EN PICADO sobre tus enemigos y estalla en una pequeña nova.",

        "Projectiles.StellarCometMinion.DisplayName": "Cometa Estelar",

        "Buffs.StellarCometBuff.DisplayName": "Cometa Estelar",
        "Buffs.StellarCometBuff.Description": "Un cometa vivo orbita a tu lado y cae en picado sobre tus enemigos",

        "Items.LivingPulsarStaff.DisplayName": "Báculo del Púlsar Vivo",
        "Items.LivingPulsarStaff.Tooltip": "Invoca EL PÚLSAR VIVO.\nUna estrella de neutrones girando a tu lado, barriendo el campo con dos haces de faro de radiación.\nTodo lo que cruzan queda ELECTRIFICADO.",

        "Projectiles.LivingPulsarMinion.DisplayName": "Púlsar Vivo",

        "Buffs.LivingPulsarBuff.DisplayName": "Púlsar Vivo",
        "Buffs.LivingPulsarBuff.Description": "Una estrella de neutrones gira a tu lado, sus haces rañando a tus enemigos",

        "Buffs.QuemaduraCosmica.DisplayName": "Quemadura cósmica",
        "Buffs.QuemaduraCosmica.Description": "El horizonte de eventos te lame: el fuego que arde hacia dentro",
        "Buffs.OcasoActivoBuff.DisplayName": "El Ocaso",
        "Buffs.OcasoActivoBuff.Description": "El ocaso arde: 8 segundos de muertes de estrella a daño ×3 con ejecución",
        "Buffs.SobrecalentadoBuff.DisplayName": "Sobrecalentada",
        "Buffs.SobrecalentadoBuff.Description": "El bastón humea y calla: no dispara mientras se enfría",

        "Items.BolsaProbador.DisplayName": "Bolsa del Probador",
        "Items.BolsaProbador.Tooltip": "Las herramientas de pruebas de Aethon.\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.\nLa bolsa es permanente: reábrela cuando pierdas algo.",
        "Items.BolsaFundacionales.DisplayName": "Bolsa de los Bastones Fundacionales",
        "Items.BolsaFundacionales.Tooltip": "Los cuatro bastones que empezaron todo.\nClic derecho para desplegarlos.\nSolo entrega lo que te falte.",
        "Items.BolsaClasicosCosmicos.DisplayName": "Bolsa de los Clásicos Cósmicos",
        "Items.BolsaClasicosCosmicos.Tooltip": "El sol primordial y sus criaturas vivas.\nClic derecho para desplegarlos.\nSolo entrega lo que te falte.",
        "Items.BolsaAgujerosNegros.DisplayName": "Bolsa de los Agujeros Negros",
        "Items.BolsaAgujerosNegros.Tooltip": "Diez formas de devorar la luz.\nClic derecho para desplegarlos.\nSolo entrega lo que te falte.",
        "Items.BolsaSolesRunicos.DisplayName": "Bolsa de los Soles Rúnicos",
        "Items.BolsaSolesRunicos.Tooltip": "Del sol de un anillo al Gran Sellado (los 20).\nClic derecho para desplegarlos.\nSolo entrega lo que te falte.",
        "Items.BolsaEstrellasReales.DisplayName": "Bolsa de las Estrellas Reales",
        "Items.BolsaEstrellasReales.Tooltip": "Física de verdad convertida en armas (las 7).\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",
        "Items.BolsaArmasLibrerias.DisplayName": "Bolsa de las Armas de las Librerías",
        "Items.BolsaArmasLibrerias.Tooltip": "Cada arma es un concierto de nuestras librerías VFX (las 6).\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",
        "Items.BolsaBastonesCreativos.DisplayName": "Bolsa de los Bastones Creativos",
        "Items.BolsaBastonesCreativos.Tooltip": "El gauge, el péndulo, el coro y demás rarezas (los 6).\nClic derecho para desplegarlos.\nSolo entrega lo que te falte.",
        "Items.BolsaExhumados.DisplayName": "Bolsa de los Exhumados",
        "Items.BolsaExhumados.Tooltip": "Las formas exhumadas: el rencor y la eminencia.\nLas formas exhumadas originales del arsenal.\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",
        "Items.BolsaCosmeticos.DisplayName": "Bolsa de los Cosméticos",
        "Items.BolsaCosmeticos.Tooltip": "Coronas, sellos y anillos que se ciñen a tu personaje.\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",
        "Items.BolsaDosFormas.DisplayName": "Bolsa de las Dos Formas",
        "Items.BolsaDosFormas.Tooltip": "Las armas de las dos formas de uso: cada una despliega su forma alternativa.\nLas cuatro que aprendieron a decir dos cosas a la vez.\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",
        "Items.BolsaDesgarros.DisplayName": "Bolsa de los Desgarros",
        "Items.BolsaDesgarros.Tooltip": "Los bastones que rajan la realidad: sutura, portal, pliegue, herida,\ncorazón, garganta, umbral y leviatán. Cada desgarro se abre distinto.\nClic derecho para desplegarlas.\nSolo entrega lo que te falte.",

        "Items.RencorPrimordialStaff.DisplayName": "El Rencor Primordial",
        "Items.RencorPrimordialStaff.Tooltip": "La forma exhumada del arsenal: EL RENCOR PRIMORDIAL.\nClava un círculo de transmutación rúnico a 380 px.\n3 s de carga → EL HAZ CONTINUO carmesí-ámbar que perfora TODO.\nAl tocar pared: brazos espectrales (×0.66) y ascuas (×0.33).\nLos enemigos del haz se desintegran en ceniza. Sin maná.",

        "Items.EminenciaAtrozStaff.DisplayName": "La Eminencia Atroz",
        "Items.EminenciaAtrozStaff.Tooltip": "La forma exhumada del arsenal: LA EMINENCIA ATROZ.\nSostén el uso: la congregación de espíritus canaliza cerca del cursor.\n14 s de acumulación → LA ABOMINACIÓN, control total.\nEl daño crece del 100% al 185% mientras se acumula.\nSi sueltas el canal, la masa decae y se disipa. Sin maná.",

        "Projectiles.RencorPrimordialProjectile.DisplayName": "Círculo del Rencor",
        "Projectiles.EminenciaAtrozProjectile.DisplayName": "Congregación de Espíritus",

        "Items.OcasoAethonStaff.DisplayName": "Bastón del Ocaso de Aethon",
        "Items.OcasoAethonStaff.Tooltip": "El arma suprema del medidor: carga → estallido → bloqueo.\nCada impacto de un fragmento carga el aro de tu cabeza.\nAro lleno: CLIC DERECHO enciende EL OCASO (8 s de muertes de estrella ×3).\nBajo el 50% de vida del objetivo, la muerte EJECUTA.\nDespués: 2 s de sobrecalentada. Sin maná.",

        "Projectiles.OcasoShardProjectile.DisplayName": "Fragmento del Ocaso",
        "Projectiles.OcasoBurstProjectile.DisplayName": "Muerte de Estrella",

        "NPCs.HollowTitan.DisplayName": "El Titán Hueco",
        "NPCs.AethonBoss.DisplayName": "Aethon, la Luz Primordial",
        "NPCs.TheWitness.DisplayName": "El Testigo",
        "NPCs.EchoBlade.DisplayName": "Eco del Primer Portador",
        "NPCs.EchoArcher.DisplayName": "Eco de la Arquera Estelar",
        "NPCs.RiftKeeper.DisplayName": "El Guardián del Rift",

        "Items.TestMagicRing.DisplayName": "Anillo Mágico de Prueba",
        "Items.TestSparkle.DisplayName": "Destello de Prueba",
        "Items.ProjBeam.DisplayName": "Rayo de Prueba",
        "Items.TestMagicRingV2.DisplayName": "Anillo Mágico de Prueba V2",
        "Items.SeerOrb.DisplayName": "Orbe del Vidente",
        "Items.BlackHoleStaff.DisplayName": "Agujero Negro",
        "Items.SunStaff.DisplayName": "Sol",
        "Items.SupernovaStaff.DisplayName": "Supernova",
        "Items.PlasmaStormStaff.DisplayName": "Tormenta de Plasma",
        "Items.PhoenixNovaStaff.DisplayName": "Nova del Fénix",
