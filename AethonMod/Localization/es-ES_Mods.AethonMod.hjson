	BolsaIdeasGrimorio: {
		// v6.50.19: THE SIX GRIMOIRE PROJECTILE IDEAS — bag 17
		DisplayName: Bolsa de las Ideas del Grimorio
		Tooltip:
			'''
			Los seis futuros del proyectil del grimorio.
			Cada idea EVOLUCIONA con el nivel del Grimorio del Eterno que lleves (6 · 12 · 20).
			Clic derecho para desplegarlas. Solo entrega lo que te falte.
			'''
	}

	IdeasFolioErrante: {
		DisplayName: El Folio Errante
		Tooltip:
			'''
			IDEA 1 para el proyectil del grimorio: LA PÁGINA.
			Una página que ondula y perfora (nivel 6: motas y más filo · nivel 12: se rompe en 3 mini-páginas homing · nivel 20: las rotas persiguen más duras).
			Sin maná — la evolución sigue al GRIMORIO que lleves encima.
			'''
	}

	IdeasPlumaPrimordial: {
		DisplayName: La Pluma Primordial
		Tooltip:
			'''
			IDEA 2: LA PLUMA QUE ESCRIBIÓ EL LIBRO.
			Dardo perforante (nivel 6: abanico de 3 · nivel 12: al clavar ESCRIBE una runa que arde · nivel 20: la pluma ORO escribe EL VERSO — seis glifos secuenciales).
			Sin maná.
			'''
	}

	IdeasSelloErrante: {
		DisplayName: El Sello Errante
		Tooltip:
			'''
			IDEA 3: EL SELLO QUE CAMINA.
			Un círculo lento que detona en aro (nivel 6: seis pernos radiales · nivel 12: ENCADENA — nace un sello junto al siguiente enemigo · nivel 20: TRES sellos).
			Sin maná.
			'''
	}

	IdeasLenguaTinta: {
		DisplayName: La Lengua de Tinta
		Tooltip:
			'''
			IDEA 4: LA SIERPE DE TINTA.
			Una lengua que serpentea hacia la presa (nivel 6: 14 segmentos y más rápida · nivel 12: al morder SE BIFURCA en dos · nivel 20: LA HYDRA — tres lenguas desde el arranque).
			Sin maná.
			'''
	}

	IdeasOjoTexto: {
		DisplayName: El Ojo del Texto
		Tooltip:
			'''
			IDEA 5: EL OJO QUE LEE — el sucesor conceptual del proyectil actual.
			Un ojo homing que mira a su presa (nivel 6: dos pupilas lo escoltan · nivel 12: cada 80 t dispara un glifo a lo que lee · nivel 20: LA MIRADA — lee a TRES presas a la vez).
			Sin maná.
			'''
	}

	IdeasVersoVivo: {
		DisplayName: El Verso Vivo
		Tooltip:
			'''
			IDEA 6: LA PALABRA HECHA PROYECTIL.
			Glifos en formación que golpean por letra (nivel 6: la ola de 5 · nivel 12: EL PALÍNDROMO — la palabra rebota y vuelve a golpear · nivel 20: LA SENTENCIA — 7 glifos en dos filas y EL PUNTO FINAL que detona).
			Sin maná.
			'''
	}

	DesgarroRealityStaff: {
		// v6.26 — The new arsenal: the reality tear, the real stars,
		// the stellar life cycle and the five creative staves
		DisplayName: Bastón del Desgarro en la Realidad
		Tooltip:
			'''
			Dispara un DESGARRO en la realidad.
			La grieta atraviesa paredes y daña con su línea.
			Al cerrarse deja una grieta persistente que drena.
			Mientras vive, el mundo se oscurece herido.
			'''
	}

	SembradorCementeralStaff: {
		// v6.31 — THE SOWER: the anchoring pulsar of the stellar graveyard
		DisplayName: Sembrador del Cementerio Estelar
		Tooltip:
			'''
			Siembra PÚLSARES que frenan en seco y se anclan donde apuntas.
			Cada púlsar gira acelerando y barre con dos haces-faro opuestos.
			Golpe de anclaje a plena potencia; los haces pican sin descanso.
			Máximo 3 púlsares: la nueva siembra se come a la más vieja.
			'''
	}

	ColapsoMagnetarStaff: {
		// v6.31 — THE COLLAPSE: the star that brakes, trembles and bursts
		DisplayName: El Colapso del Magnetar
		Tooltip:
			'''
			Dispara una estrella magnetar que frena hasta casi detenerse.
			Cuanto más aprieta el freno, más devasta el STARQUAKE.
			El anillo solo golpea con su FRENTE y perfora armaduras.
			La superviviente entra en overclock y muere en un destello.
			'''
	}

	LagrimasSolMoribundoStaff: {
		// v6.31 — THE TEARS: the orbital tear shotgun of the dying sun
		DisplayName: Las Lágrimas del Sol Moribundo
		Tooltip:
			'''
			Derrama TRES LÁGRIMAS de un sol moribundo.
			Cada lágrima orbita 2,5 s encendiéndose de chamuscado a oro.
			Luego caza sin descanso: hasta 18 mordiscos con quemadura cósmica.
			Al desvanecerse estalla en metal fundido.
			'''
	}

	DecretoEclipseStaff: {
		// v6.31 — THE DECREE: the eclipse circle that grows and executes
		DisplayName: El Decreto del Eclipse
		Tooltip:
			'''
			Clava un CÍRCULO DE ECLIPSE en el punto del cursor.
			Crece hasta 660 px mientras vive y ejecuta cada 15 ticks:
			la onda viaja al borde y TODO lo de dentro recibe el corte.
			El más cercano al centro paga ×4,8 · el ojo se contrae antes del tajo.
			'''
	}

	CometaErranteStaff: {
		// v6.32 — W2-a: FOUR NEW COSMIC WEAPONS (comet, nova, quasar, loom)
		DisplayName: El Cometa Errante
		Tooltip:
			'''
			Captura un cometa en ÓRBITA ELÍPTICA a tu alrededor durante 6 vueltas.
			El núcleo de hielo-fuego golpea a plena potencia; la cola de polvo pica a ×0.4.
			La cola apunta SIEMPRE hacia afuera de la órbita, como los cometas reales.
			Tras 420 ticks se lanza en cacería y estalla en hielo-fuego.
			'''
	}

	NovaEncadenadaStaff: {
		DisplayName: La Nova Encadenada
		Tooltip:
			'''
			Una esfera de nova lenta que estalla al tocar enemigo o suelo.
			Cada nova encadena 3 hijas ×0.65 y 2 nietas ×0.42 — hasta 3 generaciones.
			El frente del anillo es lo que golpea · cero azar: presas por distancia.
			'''
	}

	VozCuasarStaff: {
		DisplayName: La Voz del Cuásar
		Tooltip:
			'''
			Invoca un cuásar que carga 40 ticks y suelta un HAZ CONTINUO de 460 px.
			El haz PERFORA TODO · DOPPLER: el borde delantero azul, la cola roja.
			Rebota una vez en las paredes · muere con un destello.
			'''
	}

	TelarConstelacionesStaff: {
		DisplayName: El Telar de Constelaciones
		Tooltip:
			'''
			Cada uso clava una ESTRELLITA donde estaba tu cursor.
			Se conectan solas con hilos de luz: la constelación se dibuja sola.
			Con 4 o más, cada 30 ticks la FIGURA SE ENCIENDE:
			todo enemigo dentro del polígono recibe ×2.2 por estrella.
			'''
	}

	LluviaMeteorosStaff: {
		// v6.33 — W2-b: FOUR MORE COSMIC WEAPONS (meteor shower, nebula, horizon, gamma ray)
		DisplayName: La Lluvia de Meteoros
		Tooltip:
			'''
			Marca la zona del cursor con un telégrafo ámbar de 30 ticks.
			Luego caen 8 meteoros escalonados, uno cada 4 ticks, en diagonal con estela de fuego.
			Cada impacto estalla ×1.0 en radio 70 y quema con la quemadura cósmica 3 s.
			'''
	}

	AbrazoNebulosaStaff: {
		DisplayName: El Abrazo de la Nebulosa
		Tooltip:
			'''
			Instala una nebulosa en el cursor: nube magenta-cian-violeta de 300 ticks.
			Los de dentro reciben ×0.06 cada 3 ticks y quedan lentos.
			En su seno nacen estrellitas que revientan en mini-pops ×0.8.
			Al morir se disipa en polvo de estrellas.
			'''
	}

	FiloHorizonteStaff: {
		DisplayName: El Filo del Horizonte
		Tooltip:
			'''
			Lanza un disco negro — un horizonte de sucesos — con línea de fotón en el ecuador.
			Atraviesa a los enemigos perdiendo velocidad y vuelve como bumerán.
			Cada golpe deja una marca que implosiona 30 ticks después: ×0.7 + arrastre.
			'''
	}

	RayoGammaStaff: {
		DisplayName: El Rayo Gamma
		Tooltip:
			'''
			Un haz fino de 700 px cruza TODO al instante... pero aún no hace daño.
			Cada enemigo tocado queda marcado con un contorno brillante.
			Tras 30 ticks, todas las marcas liquidan a la vez:
			clang, destello, daño ×1.0 y quemadura cósmica 5 s.
			'''
	}

	NeutronStarStaff: {
		DisplayName: Bastón de la Estrella de Neutrones
		Tooltip:
			'''
			Un núcleo de 12 px ultradenso.
			Aura de 60 px con daño triplicado.
			Starquakes periódicos que sacuden el suelo.
			Gravita hacia sus presas.
			'''
	}

	PulsarStaff: {
		DisplayName: Bastón del Púlsar
		Tooltip:
			'''
			El faro cósmico: dos haces polares barriendo a 1 rev/s.
			Cada barrido que toca a un enemigo lo golpea con fuerza.
			Pulsos de luz sincronizados con el giro.
			'''
	}

	WhiteDwarfStaff: {
		DisplayName: Bastón de la Enana Blanca
		Tooltip:
			'''
			El rescoldo cristalino de una estrella vieja.
			Siete facetas de luz fría girando lento.
			Anillo de acreción que roba brillo a los enemigos cercanos.
			'''
	}

	DeadStarStaff: {
		DisplayName: Bastón de la Estrella Muerta
		Tooltip:
			'''
			La enana negra: lo que queda cuando todo se apaga.
			Masa oscura que devora la luz.
			Entropía constante en su alrededor.
			Ecos de runas a 0,2 Hz: la vida que fue.
			'''
	}

	RedSupergiantStaff: {
		DisplayName: Bastón de la Supergigante Roja
		Tooltip:
			'''
			El coloso moribundo de 90 px.
			Celdas de convección latiendo despacio.
			Al morir se COLAPSA y luego revienta en nova.
			'''
	}

	MagnetarStaff: {
		DisplayName: Bastón del Magnetar
		Tooltip:
			'''
			La estrella de neutrones EXTREMA.
			Campo magnético violeta con líneas retorcidas.
			Cadenas de rayo automáticas a los enemigos.
			El latido es una arritmia determinista.
			'''
	}

	CicloEstelarStaff: {
		DisplayName: Bastón del Ciclo Estelar
		Tooltip:
			'''
			Una estrella que VIVE una vida completa:
			nebulosa que se contrae → ignición → gigante roja
			→ colapso y SUPERNOVA → estrella de neutrones.
			La estela cuenta la historia en cinco colores.
			'''
	}

	RelojArenaStaff: {
		DisplayName: Bastón del Reloj de Arena Cósmico
		Tooltip:
			'''
			Un reloj de arena vivo flotando en el aire.
			La arena son motas de luz que caen y pican.
			Cuando la cámara se vacía, el tiempo se invierte.
			'''
	}

	MareaGravitatoriaStaff: {
		DisplayName: Bastón de la Marea Gravitatoria
		Tooltip:
			'''
			Una ola de luz que avanza pegada al terreno.
			Arrastra a los enemigos con la corriente.
			Si golpea una pared, se rompe en tres olas menores.
			'''
	}

	EnjambrePrismaticoStaff: {
		DisplayName: Bastón del Enjambre Prismático
		Tooltip:
			'''
			Un núcleo que revienta en doce avispas de luz.
			El enjambre orbita y migra de presa en presa.
			Cada avispa pica con su color del prisma.
			'''
	}

	PenduloJuicioStaff: {
		DisplayName: Bastón del Péndulo del Juicio
		Tooltip:
			'''
			Un péndulo de luz con física real colgado del aire.
			Cada vaivén amplía el arco del juicio.
			Al soltarse, la maza vuela y estalla.
			'''
	}

	CoroEspectralStaff: {
		DisplayName: Bastón del Coro Espectral
		Tooltip:
			'''
			Seis notas de luz cantando en órbita lenta.
			Cada nota emite su anillo de onda a su turno.
			El coro se despide apagándose de a una.
			'''
	}

	SuturaCuanticaStaff: {
		DisplayName: La Sutura Cuántica
		Tooltip:
			'''
			Abre un DESGARRO GLITCH donde apuntas.
			Corrompe a todo enemigo dentro del círculo.
			Cada 45 ticks dispara rayos cuánticos a los 3 más cercanos.
			'''
	}

	PortalDimensionalStaff: {
		DisplayName: El Portal Dimensional
		Tooltip:
			'''
			Abre la puerta de anillos donde apuntas.
			Succión suave en 300 px: el que cruza el núcleo blanco es triturado.
			El portal respira 6 segundos.
			'''
	}

	PliegueEspacioStaff: {
		DisplayName: El Pliegue del Espacio
		Tooltip:
			'''
			Abre el OJO donde apuntas: la doble elipse con el núcleo negro.
			Dobla el espacio en 350 px y arrastra a los enemigos.
			El que toca el núcleo es comprimido.
			'''
	}

	HeridaElectricaStaff: {
		DisplayName: La Herida Eléctrica
		Tooltip:
			'''
			Abre LA GRIETA hacia donde apuntas.
			Pica en línea y aplica ELECTRIFICADO.
			La corriente nunca se corta.
			'''
	}

	CorazonColapsoStaff: {
		// v6.35: THE FOUR NEW TEARS (second batch of references).
		DisplayName: El Corazón del Colapso
		Tooltip:
			'''
			Enciende la ESTRELLA DE CUATRO PUNTAS de fuego estelar.
			Quema a todo enemigo dentro del corazón.
			Cada 30 ticks los filamentos lanzan llamaradas a los 2 más cercanos.
			'''
	}

	GargantaVacioStaff: {
		DisplayName: La Garganta del Vacío
		Tooltip:
			'''
			Abre el vórtice devorador: núcleo negro absoluto y anillo magenta.
			La lente curva el fondo y la succión arrastra en 320 px.
			El que toca el núcleo negro es devorado.
			'''
	}

	UmbralRotoStaff: {
		DisplayName: El Umbral Roto
		Tooltip:
			'''
			Raja la realidad con un corte horizontal perfecto.
			Arriba el vacío con el esqueleto espectral; abajo, el mundo.
			Pica en línea y cada 60 ticks la otra realidad muerde.
			'''
	}

	LeviatanEspectralStaff: {
		DisplayName: El Leviatán Espectral
		Tooltip:
			'''
			Lanza a la criatura de hueso etéreo: catorce vértebras nadando en S.
			Atraviesa todo lo que toca y gira hacia el enemigo más cercano.
			4 segundos de nado espectral.
			'''
	}

	DanzaOrbesStaff: {
		// v6.36: THE FOUR LIVING CODES (the image codes turned into
		// weapons) + THE RUNIC BACK RING.
		DisplayName: La Danza de los Orbes
		Tooltip:
			'''
			Invoca el código vivo de la cadena: un minisistema solar orbitándote.
			Todo orbe quema al que toca: sol ×1.0, planetas ×0.7, lunas ×0.5.
			12 segundos de danza · un sistema a la vez · sin coste de maná.
			'''
	}

	LenteAbismoStaff: {
		DisplayName: La Lente del Abismo
		Tooltip:
			'''
			Planta el código vivo del agujero negro: disco de veinte bandas,
			horizonte negro y estrellas dobladas cayendo en espiral.
			La lente curva el fondo · succión en 300 px · devora ×1.2 · enfoca y muerde ×0.6.
			'''
	}

	SolVivoStaff: {
		DisplayName: El Sol Vivo
		Tooltip:
			'''
			Enciende el código vivo del sol: latiendo con el pulso exacto del original.
			El aura quema ×0.55 · cada pico del pulso LATE ×0.7 · las prominencias azotan ×0.85.
			5 segundos de sol · un sol a la vez · sin coste de maná.
			'''
	}

	SierpeEstelarStaff: {
		DisplayName: La Sierpe Estelar
		Tooltip:
			'''
			Libera el código vivo de la criatura: dieciséis segmentos — cabeza,
			aletas gemelas y espina — nadando en vueltas alrededor de tu cursor.
			La cabeza atraviesa todo · la espina quema ×0.4 · una sierpe a la vez.
			'''
	}

	AnilloRunicoDorsalItem: {
		DisplayName: El Anillo Rúnico Dorsal
		Tooltip:
			'''
			El círculo de conjuro del agujero negro cuelga de tu espalda:
			la triple corona rúnica LITERAL de los vórtices — dorada, violeta
			contrarrotante y blanca íntima junto al anillo de fotones.
			Puro cosmético: cero estadísticas.
			'''
		Titulo: "[c/FFC36B:═══ EL ANILLO RÚNICO DORSAL ═══]"
		Linea1:
			'''
			[c/FFE7B0:El círculo de conjuro del agujero negro cuelga de tu espalda: la triple
			corona rúnica LITERAL de los vórtices — ocho runas doradas girando con el conjunto]
			'''
		Linea2:
			'''
			[c/CDA8FF:seis runas violetas contrarrotando más afuera y el círculo blanco íntimo latiendo
			junto al anillo de fotones — runas de pie, respirando, con sus perlas]
			'''
		Linea3:
			'''
			[c/78788C:Puro cosmético: cero estadísticas. Equípalo en cualquier hueco
			de accesorio, funcional o de vanidad]
			'''
	}

	BolsaCodigosVivos: {
		DisplayName: Bolsa de los Códigos Vivos
		Tooltip:
			'''
			Los códigos de las imágenes hechos armas: la danza de los orbes,
			la lente del abismo, el sol vivo y la sierpe estelar.
			Cada código aprendió a vivir aquí. Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	OuroborosAstralStaff: {
		// v6.38: THE SERPENT BROOD (10 new ways to move the same chain
		// + the hatchling minion — the original UNTOUCHED).
		DisplayName: El Ouroboros Astral
		Tooltip:
			'''
			Doce cuentas se persiguen en círculo apuntando adelante — nadie manda.
			Cada cuenta barre ×0.55; al expirar la espiral se cierra y DETONA ×2.0.
			10 segundos de anillo · sin coste de maná.
			'''
	}

	CaravanaEspectralStaff: {
		DisplayName: La Caravana Espectral
		Tooltip:
			'''
			El cuerpo repite la trayectoria EXACTA del faro: el camino-memoria.
			El rastro limpia el pasillo ×0.35 — con giros dibujas muros en S.
			9 segundos de caravana · sin coste de maná.
			'''
	}

	AnguilaSolarStaff: {
		DisplayName: La Anguila Solar
		Tooltip:
			'''
			El cuerpo ES una fórmula: la onda viajera de la anguila, λ ≈ el cuerpo.
			Las CRESTAS muerden ×1.0, los valles solo ×0.30 — roza con la cresta.
			8 segundos de nado en S · sin coste de maná.
			'''
	}

	CienpiesRunicoStaff: {
		DisplayName: El Ciempiés Rúnico
		Tooltip:
			'''
			Doce placas pegadas al suelo con una pata desfasada Δφ=45° cada una.
			Las patas plantadas dejan su RUNA: la runa pica ×0.40.
			La marcha sube de frecuencia lejos de la presa · sin coste de maná.
			'''
	}

	FlageloEstelarStaff: {
		DisplayName: El Flagelo Estelar
		Tooltip:
			'''
			El látigo de Verlet con constraint por masa: la energía corre a la punta.
			La punta golpea ∝ su velocidad (×0.5 → ×1.5); sobre 26 px/tick,
			EL CHASQUIDO: ×2.2 + sacudida. 8 segundos · sin coste de maná.
			'''
	}

	ViboraGenesiacaStaff: {
		DisplayName: La Víbora Genesíaca
		Tooltip:
			'''
			Un esqueleto, dos cuerpos: la espina de la sierpe y DOS HEBRAS trenzadas.
			Las perlas queman ×0.45; al enroscar el rumbo la hélice se comprime ×1.6.
			9 segundos de víbora · sin coste de maná.
			'''
	}

	BoaEclipseStaff: {
		DisplayName: La Boa del Eclipse
		Tooltip:
			'''
			La cabeza hace la servo-espiral sobre la presa y el cuerpo la envuelve.
			Cada vuelta completa es un stack de APRIETE: ×0.5 → ×4.0.
			La presa cae y busca la siguiente. 10 segundos · sin coste de maná.
			'''
	}

	FarolGuardianStaff: {
		DisplayName: El Farol Guardián
		Tooltip:
			'''
			La base es un farol colgante y la PUNTA persigue a la presa (FABRIK).
			La mano muerde ×1.0 y la cadena quema ×0.40 — el cuerpo se TENSA.
			12 segundos de guardián · sin coste de maná.
			'''
	}

	CintaAuroraStaff: {
		DisplayName: La Cinta Aurora
		Tooltip:
			'''
			El estandarte vivo: la espina anclada a tu espalda y dos senos inconmensurables.
			La cinta corta ×0.5; la amplitud es TU VELOCIDAD — corre y se vuelve látigo.
			12 segundos de estandarte · sin coste de maná.
			'''
	}

	ManadaAstralStaff: {
		DisplayName: La Manada Astral
		Tooltip:
			'''
			Seis cazadores con distancia ELÁSTICA y liderazgo que SALTA.
			Cada cazador golpea con SU PROPIA velocidad: ×0.55 → ×1.4.
			10 segundos de cacería · sin coste de maná.
			'''
	}

	CriaEstelarStaff: {
		DisplayName: La Cría Estelar
		Tooltip:
			'''
			La hijita de la sierpe estelar: el MISMO ADN, pero cachorra y despierta.
			En reposo nada a tu alrededor; en caza embiste (mordida de minion).
			Ocupa 1 espacio de sirviente · nunca expira · sin coste de maná.
			'''
	}

	BolsaSierpes: {
		DisplayName: Bolsa de las Sierpes
		Tooltip:
			'''
			La sierpe estelar y sus once descendientes: cada una nada distinto.
			El anillo, la caravana, la anguila, el ciempiés, el látigo, la víbora,
			la boa, el farol, la cinta, la manada y la cría. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	TajosAstralesStaff: {
		DisplayName: El Bastón de los Tajos Astrales
		Tooltip:
			'''
			Marca el punto donde apuntas — y diez ticks después EL CORTE FLORECE:
			siete medias lunas blancas en todas direcciones, creciendo de punta a punta.
			La herida llega cuando el tajo aparece (causalidad retrasada).
			Cada arco corta una vez su banda curva · sin coste de maná.
			'''
	}

	TomoApatiaNula: {
		DisplayName: El Tomo de la Apatía Nula
		Tooltip:
			'''
			El tomo que ya no siente nada escupe tentáculos de vacío:
			gestan 2 segundos sin dañar (pulsos que imploden) y luego azotan
			en tres curvas hacia tu mira, teletransportándose entre curva y curva.
			Golpea todo lo que toca (90×90) · cada impacto sucesivo pesa menos.
			ARMA DE PRUEBAS (réplica exacta de su fuente de estudio).
			'''
	}

	FragmentoSupernovaStaff: {
		DisplayName: El Fragmento de Supernova
		Tooltip:
			'''
			La singularidad alada hecha sirviente: el ojo alado con sus
			afterimages orbitando y respirando a su alrededor (la firma).
			VOLEA de 5 ráfagas nova en abanico · BEAM telegrafiado de 900px (×2.5)
			· flor de fuego al morir cada ráfaga · sin coste de maná.
			MINION: ocupa 1 espacio de sirviente · nunca expira.
			ARMA DE PRUEBAS (réplica del jefe de la singularidad alada).
			'''
	}

	BolsaHuespedes: {
		DisplayName: Bolsa de los Huéspedes
		Tooltip:
			'''
			Las réplicas de prueba: el tentáculo del vacío, el fragmento
			de supernova y los tajos astrales. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	MetronomoPulsar: {
		DisplayName: El Metrónomo de Púlsar
		Tooltip:
			'''
			El arma que dispara AL COMPÁS: el púlsar sobre tu cabeza late cada 0,5 s.
			PERFECT (±0,05 s): crítico garantizado + abanico doble.
			GOOD (±0,1 s): crítico garantizado. Fuera de compás: el combo se pierde.
			8 aciertos seguidos: EL FARO — 3 s de haz giratorio de 900 px.
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	VelaSolar: {
		DisplayName: La Vela Solar
		Tooltip:
			'''
			Mantén pulsado: la vela de fotones se despliega y la cadencia sube
			de 12 a 30 disparos/s con el calor (daño ×1 → ×1,6).
			Al calor pleno: LA FUSIÓN — 1,5 s de plasma ×2 y luego la vela se funde (3 s).
			Soltar a tiempo conserva ~70% del calor.
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	GuadanaDesgarro: {
		DisplayName: La Guadaña del Desgarro
		Tooltip:
			'''
			El tajo vuela 220 px y donde muere abre UNA FISURA VERTICAL de realidad (2 s):
			todo lo que la cruza sangra, y los proyectiles enemigos que la tocan
			DESAPARECEN — los traga y su daño se suma AL PRÓXIMO Tajo (EL HAMBRE).
			Clic der: la fisura se abre directamente en tu mira (≤480 px).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	EgidaNova: {
		DisplayName: La Égida de Nova
		Tooltip:
			'''
			Clic izq: EL EMBESTÓN — golpe de escudo con empujón 9.
			Clic der: ALZAR LA GUARDIA (0,3 s): un golpe en la ventana perfecta
			NO EXISTE — detona LA NOVA (3× + quemadura + 1 s invulnerable).
			La guardia que expira sin parar te aturde 0,5 s. Enfriamiento 8 s (anillo visible).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	EcoCuantico: {
		DisplayName: El Eco Cuántico
		Tooltip:
			'''
			Cada pulso vuela y decohiere en una semilla que se re-emite como ECO
			contra el enemigo más cercano (60% · 36% · 21,6%: 2,17× por cadena completa).
			Clic der: LA RESONANCIA — todas las semillas disparan A LA VEZ (5 s de recarga).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	VerboPrimordialStaff: {
		DisplayName: El Verbo Primordial
		Tooltip:
			'''
			La palabra que pronunció la primera luz — SIETE MOVIMIENTOS:
			I EL PULSO · II EL SELLO · III LA CORONA · IV LA TORMENTA
			V EL FUEGO · VI EL DESGARRO · VII LA SINFONÍA
			Cada movimiento habla con las bibliotecas de la casa; el daño crece ×1,0 → ×1,4
			y al séptimo segundo: LA DETONACIÓN (2,5× + quemadura).
			ARMA DE PRUEBAS — sin coste de maná.
			'''
	}

	BolsaApuestas: {
		DisplayName: Bolsa de las Apuestas
		Tooltip:
			'''
			Las cinco apuestas de la casa (el ritmo, la cadencia, la zona,
			el parry y el eco) y EL VERBO PRIMORDIAL que las une. Clic derecho.
			Solo entrega lo que te falte.
			'''
	}

	PrismaDePaisajesItem: {
		DisplayName: El Prisma de Paisajes
		Tooltip:
			'''
			El probador de la librería del cielo: cada uso despliega UN PAISAJE
			entero sobre el fondo del mundo — capas con su parallax, su deriva,
			su profundidad y sus tintes de cielo, luz y brillo.
			Ciclo: Eclipse Umbral → Lluvia Estelar → Amanecer Primordial → Sagrario Violeta → cielo limpio.
			EL SAGRARIO VIOLETA: el paisaje del lugar, desplegable donde quieras.
			ARMA DE PRUEBAS — sin coste de maná.
			'''
		Titulo: "[c/BE8CFF:═══ EL PRISMA DE PAISAJES ═══]"
		Linea1:
			'''
			[c/78788C:El probador de la librería del cielo: despliega paisajes enteros
			sobre el fondo del mundo — capas con parallax, deriva y tintes
			(v6.44: incluye EL SAGRARIO VIOLETA, el lugar hecho escena)]
			'''
		MensajeApagado: El prisma se apaga: el cielo vuelve a su dueño.
		MensajeEscena: El prisma despliega: {0}.
	}

	EsenciaDelReyGelatina: {
		DisplayName: Esencia del Rey Gelatina
		Tooltip:
			'''
			El alma dulce del trono que rueda.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelOjoDeCthulhu: {
		DisplayName: Esencia del Ojo de Cthulhu
		Tooltip:
			'''
			La vigilia hambrienta, soñando contigo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeDeerclops: {
		DisplayName: Esencia de Deerclops
		Tooltip:
			'''
			La escarcha ancestral del invierno caminante.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeLaAbejaReina: {
		DisplayName: Esencia de la Abeja Reina
		Tooltip:
			'''
			La miel real con aguijón.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelDevoradorDeMundos: {
		DisplayName: Esencia del Devorador de Mundos
		Tooltip:
			'''
			Cien fauces corrompidas en un hilo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelCerebroDeCthulhu: {
		DisplayName: Esencia del Cerebro de Cthulhu
		Tooltip:
			'''
			Los reflejos que gritan en rojo.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDeSkeletron: {
		DisplayName: Esencia de Skeletron
		Tooltip:
			'''
			La maldición copiada a mano alzada.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			'''
	}

	EsenciaDelTitanHueco: {
		DisplayName: Esencia del Titán Hueco
		Tooltip:
			'''
			El alma del coloso de cristal del Sagrario.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			Solo cae 10 veces por mundo: el cristal no se repite.
			'''
	}

	EsenciaDelGuardianDelRift: {
		DisplayName: Esencia del Guardián del Rift
		Tooltip:
			'''
			El alma del centinela del entre-mundos.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			Solo cae 10 veces por mundo: el umbral no repite invitados.
			'''
	}

	EsenciaDeLaArqueraEstelar: {
		DisplayName: Esencia de la Arquera Estelar
		Tooltip:
			'''
			El alma del eco que nunca soltó el arco.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			Solo cae 10 veces por mundo: los ecos no se clonan.
			'''
	}

	EsenciaDelPrimerPortador: {
		DisplayName: Esencia del Primer Portador
		Tooltip:
			'''
			El alma del eco que nunca soltó la hoja.
			Sube UN NIVEL COMPLETO al Grimorio del Eterno.
			Solo cae 10 veces por mundo: la hoja no se hereda.
			'''
	}

	EsenciaDeAethon: {
		DisplayName: Esencia de Aethon
		Tooltip:
			'''
			El alma de la Luz Primordial — la que te
			reconoció como un par. Sube UN NIVEL COMPLETO al
			Grimorio del Eterno. Solo 10 por mundo: ni la luz se da dos veces.
			'''
	}

	CoronaRunicoAuraItem: {
		DisplayName: La Corona Rúnica de Aura
		Tooltip:
			'''
			El pentágono de runas de AURALIB: una jaula de
			cinco lados girando alrededor tuyo — el violeta del
			Sagrario al centro, el ORO del grimorio en las aristas.
			Cosmético puro (el dibuja el PORTADOR aditivo).
			'''
	}

	FormaAscendidaItem: {
		DisplayName: La Forma Ascendida
		Tooltip:
			'''
			El aura de la Luz Primordial respirando a tu alrededor.
			La dejó caer Aethon al reconocerte como un par.
			Cosmético puro — la corona del que ya no necesita invocarla.
			'''
	}

	BolsaCategoria: {
		Titulo: "[c/{0}:{1}]"
		Linea1: "[c/E6B0FF:Clic derecho para desplegar esta categoría del arsenal]"
		Linea2: "[c/FFD66B:Solo entrega lo que te falte — reábrela cuando pierdas un arma]"
		Nota: "[c/78788C:{0}]"
		Abierta: La {0} se abre: {1} objetos nuevos.
		Completa: La {0} ya está completa contigo.
	}
}

