        "Projectiles.RealityTearProjectile.DisplayName": "Desgarro de Realidad",
        "Projectiles.SinfoniaPrimordialProjectile.DisplayName": "Sinfonía Primordial",
        "Projectiles.TormentaNebularProjectile.DisplayName": "Tormenta Nebular",

        "Items.SuturaCuanticaStaff.DisplayName": "La Sutura Cuántica",
        "Items.SuturaCuanticaStaff.Tooltip": "Abre un DESGARRO GLITCH donde apuntas.\nCorrompe a todo enemigo dentro del círculo.\nCada 45 ticks dispara rayos cuánticos a los 3 más cercanos.",
        "Items.PortalDimensionalStaff.DisplayName": "El Portal Dimensional",
        "Items.PortalDimensionalStaff.Tooltip": "Abre la puerta de anillos donde apuntas.\nSucción suave en 300 px: el que cruza el núcleo blanco es triturado.\nEl portal respira 6 segundos.",
        "Items.PliegueEspacioStaff.DisplayName": "El Pliegue del Espacio",
        "Items.PliegueEspacioStaff.Tooltip": "Abre el OJO donde apuntas: la doble elipse con el núcleo negro.\nDobla el espacio en 350 px y arrastra a los enemigos.\nEl que toca el núcleo es comprimido.",
        "Items.HeridaElectricaStaff.DisplayName": "La Herida Eléctrica",
        "Items.HeridaElectricaStaff.Tooltip": "Abre LA GRIETA hacia donde apuntas.\nPica en línea y aplica ELECTRIFICADO.\nLa corriente nunca se corta.",

        // v6.35: LOS CUATRO DESGARROS NUEVOS (segunda tanda de referencias).
        "Items.CorazonColapsoStaff.DisplayName": "El Corazón del Colapso",
        "Items.CorazonColapsoStaff.Tooltip": "Enciende la ESTRELLA DE CUATRO PUNTAS de fuego estelar.\nQuema a todo enemigo dentro del corazón.\nCada 30 ticks los filamentos lanzan llamaradas a los 2 más cercanos.",

        "Items.GargantaVacioStaff.DisplayName": "La Garganta del Vacío",
        "Items.GargantaVacioStaff.Tooltip": "Abre el vórtice devorador: núcleo negro absoluto y anillo magenta.\nLa lente curva el fondo y la succión arrastra en 320 px.\nEl que toca el núcleo negro es devorado.",

        "Items.UmbralRotoStaff.DisplayName": "El Umbral Roto",
        "Items.UmbralRotoStaff.Tooltip": "Raja la realidad con un corte horizontal perfecto.\nArriba el vacío con el esqueleto espectral; abajo, el mundo.\nPica en línea y cada 60 ticks la otra realidad muerde.",

        "Items.LeviatanEspectralStaff.DisplayName": "El Leviatán Espectral",
        "Items.LeviatanEspectralStaff.Tooltip": "Lanza a la criatura de hueso etéreo: catorce vértebras nadando en S.\nAtraviesa todo lo que toca y gira hacia el enemigo más cercano.\n4 segundos de nado espectral.",

        "Projectiles.DesgarroCuanticoProjectile.DisplayName": "Sutura Cuántica",
        "Projectiles.PortalDimensionalProjectile.DisplayName": "Portal Dimensional",
        "Projectiles.PliegueEspacioProjectile.DisplayName": "Pliegue del Espacio",
        "Projectiles.HeridaElectricaProjectile.DisplayName": "Herida Eléctrica",
        "Projectiles.CorazonColapsoProjectile.DisplayName": "Corazón del Colapso",
        "Projectiles.GargantaVacioProjectile.DisplayName": "Garganta del Vacío",
        "Projectiles.UmbralRotoProjectile.DisplayName": "Umbral Roto",
        "Projectiles.LeviatanEspectralProjectile.DisplayName": "Leviatán Espectral",

        // v6.36: LOS CUATRO CÓDIGOS VIVOS (los códigos de las imágenes
        // del usuario traducidos a armas) + EL ANILLO RÚNICO DORSAL.
        "Items.DanzaOrbesStaff.DisplayName": "La Danza de los Orbes",
        "Items.DanzaOrbesStaff.Tooltip": "Invoca el código vivo de la cadena: un minisistema solar orbitándote.\nTodo orbe quema al que toca: sol ×1.0, planetas ×0.7, lunas ×0.5.\n12 segundos de danza · un sistema a la vez · sin coste de maná.",

        "Items.LenteAbismoStaff.DisplayName": "La Lente del Abismo",
        "Items.LenteAbismoStaff.Tooltip": "Planta el código vivo del agujero negro: disco de veinte bandas,\nhorizonte negro y estrellas dobladas cayendo en espiral.\nLa lente curva el fondo · succión en 300 px · devora ×1.2 · enfoca y muerde ×0.6.",

        "Items.SolVivoStaff.DisplayName": "El Sol Vivo",
        "Items.SolVivoStaff.Tooltip": "Enciende el código vivo del sol: latiendo con el pulso exacto del original.\nEl aura quema ×0.55 · cada pico del pulso LATE ×0.7 · las prominencias azotan ×0.85.\n5 segundos de sol · un sol a la vez · sin coste de maná.",

        "Items.SierpeEstelarStaff.DisplayName": "La Sierpe Estelar",
        "Items.SierpeEstelarStaff.Tooltip": "Libera el código vivo de la criatura: dieciséis segmentos — cabeza,\naletas gemelas y espina — nadando en vueltas alrededor de tu cursor.\nLa cabeza atraviesa todo · la espina quema ×0.4 · una sierpe a la vez.",

        "Items.AnilloRunicoDorsalItem.DisplayName": "El Anillo Rúnico Dorsal",
        "Items.AnilloRunicoDorsalItem.Tooltip": "El círculo de conjuro del agujero negro cuelga de tu espalda:\nla triple corona rúnica LITERAL de los vórtices — dorada, violeta\ncontrarrotante y blanca íntima junto al anillo de fotones.\nPuro cosmético: cero estadísticas.",

        "Items.BolsaCodigosVivos.DisplayName": "Bolsa de los Códigos Vivos",
        "Items.BolsaCodigosVivos.Tooltip": "Los códigos de las imágenes hechos armas: la danza de los orbes,\nla lente del abismo, el sol vivo y la sierpe estelar.\nCada código aprendió a vivir aquí. Clic derecho para desplegarlas.\nSolo entrega lo que te falte.",

        "Projectiles.DanzaOrbesProjectile.DisplayName": "Danza de los Orbes",
        "Projectiles.LenteAbismoProjectile.DisplayName": "Lente del Abismo",
        "Projectiles.SolVivoProjectile.DisplayName": "Sol Vivo",
        "Projectiles.SierpeEstelarProjectile.DisplayName": "Sierpe Estelar",

        // v6.38: LA CAMADA DE LAS SIERPES (10 formas nuevas de mover la
        // misma cadena + la cría, el minion — la original INTACTA).
        "Items.OuroborosAstralStaff.DisplayName": "El Ouroboros Astral",
        "Items.OuroborosAstralStaff.Tooltip": "Doce cuentas se persiguen en círculo apuntando adelante — nadie manda.\nCada cuenta barre ×0.55; al expirar la espiral se cierra y DETONA ×2.0.\n10 segundos de anillo · sin coste de maná.",

        "Items.CaravanaEspectralStaff.DisplayName": "La Caravana Espectral",
        "Items.CaravanaEspectralStaff.Tooltip": "El cuerpo repite la trayectoria EXACTA del faro: el camino-memoria.\nEl rastro limpia el pasillo ×0.35 — con giros dibujas muros en S.\n9 segundos de caravana · sin coste de maná.",

        "Items.AnguilaSolarStaff.DisplayName": "La Anguila Solar",
        "Items.AnguilaSolarStaff.Tooltip": "El cuerpo ES una fórmula: la onda viajera de la anguila, λ ≈ el cuerpo.\nLas CRESTAS muerden ×1.0, los valles solo ×0.30 — roza con la cresta.\n8 segundos de nado en S · sin coste de maná.",

        "Items.CienpiesRunicoStaff.DisplayName": "El Ciempiés Rúnico",
        "Items.CienpiesRunicoStaff.Tooltip": "Doce placas pegadas al suelo con una pata desfasada Δφ=45° cada una.\nLas patas plantadas dejan su RUNA: la runa pica ×0.40.\nLa marcha sube de frecuencia lejos de la presa · sin coste de maná.",

        "Items.FlageloEstelarStaff.DisplayName": "El Flagelo Estelar",
        "Items.FlageloEstelarStaff.Tooltip": "El látigo de Verlet con constraint por masa: la energía corre a la punta.\nLa punta golpea ∝ su velocidad (×0.5 → ×1.5); sobre 26 px/tick,\nEL CHASQUIDO: ×2.2 + sacudida. 8 segundos · sin coste de maná.",

        "Items.ViboraGenesiacaStaff.DisplayName": "La Víbora Genesíaca",
        "Items.ViboraGenesiacaStaff.Tooltip": "Un esqueleto, dos cuerpos: la espina de la sierpe y DOS HEBRAS trenzadas.\nLas perlas queman ×0.45; al enroscar el rumbo la hélice se comprime ×1.6.\n9 segundos de víbora · sin coste de maná.",

        "Items.BoaEclipseStaff.DisplayName": "La Boa del Eclipse",
        "Items.BoaEclipseStaff.Tooltip": "La cabeza hace la servo-espiral sobre la presa y el cuerpo la envuelve.\nCada vuelta completa es un stack de APRIETE: ×0.5 → ×4.0.\nLa presa cae y busca la siguiente. 10 segundos · sin coste de maná.",

        "Items.FarolGuardianStaff.DisplayName": "El Farol Guardián",
        "Items.FarolGuardianStaff.Tooltip": "La base es un farol colgante y la PUNTA persigue a la presa (FABRIK).\nLa mano muerde ×1.0 y la cadena quema ×0.40 — el cuerpo se TENSA.\n12 segundos de guardián · sin coste de maná.",

        "Items.CintaAuroraStaff.DisplayName": "La Cinta Aurora",
        "Items.CintaAuroraStaff.Tooltip": "El estandarte vivo: la espina anclada a tu espalda y dos senos inconmensurables.\nLa cinta corta ×0.5; la amplitud es TU VELOCIDAD — corre y se vuelve látigo.\n12 segundos de estandarte · sin coste de maná.",

        "Items.ManadaAstralStaff.DisplayName": "La Manada Astral",
        "Items.ManadaAstralStaff.Tooltip": "Seis cazadores con distancia ELÁSTICA y liderazgo que SALTA.\nCada cazador golpea con SU PROPIA velocidad: ×0.55 → ×1.4.\n10 segundos de cacería · sin coste de maná.",

        "Items.CriaEstelarStaff.DisplayName": "La Cría Estelar",
        "Items.CriaEstelarStaff.Tooltip": "La hijita de la sierpe estelar: el MISMO ADN, pero cachorra y despierta.\nEn reposo nada a tu alrededor; en caza embiste (mordida de minion).\nOcupa 1 espacio de sirviente · nunca expira · sin coste de maná.",

        "Items.BolsaSierpes.DisplayName": "Bolsa de las Sierpes",
        "Items.BolsaSierpes.Tooltip": "La sierpe estelar y sus once descendientes: cada una nada distinto.\nEl anillo, la caravana, la anguila, el ciempiés, el látigo, la víbora,\nla boa, el farol, la cinta, la manada y la cría. Clic derecho.\nSolo entrega lo que te falte.",

        "Projectiles.OuroborosAstralProjectile.DisplayName": "Ouroboros Astral",
        "Projectiles.CaravanaEspectralProjectile.DisplayName": "Caravana Espectral",
        "Projectiles.AnguilaSolarProjectile.DisplayName": "Anguila Solar",
        "Projectiles.CienpiesRunicoProjectile.DisplayName": "Ciempiés Rúnico",
        "Projectiles.FlageloEstelarProjectile.DisplayName": "Flagelo Estelar",
        "Projectiles.ViboraGenesiacaProjectile.DisplayName": "Víbora Genesíaca",
        "Projectiles.BoaEclipseProjectile.DisplayName": "Boa del Eclipse",
        "Projectiles.FarolGuardianProjectile.DisplayName": "Farol Guardián",
        "Projectiles.CintaAuroraProjectile.DisplayName": "Cinta Aurora",
        "Projectiles.ManadaAstralProjectile.DisplayName": "Manada Astral",
        "Projectiles.CriaEstelarMinion.DisplayName": "Cría Estelar",

        "Buffs.CriaEstelarBuff.DisplayName": "Cría Estelar",
        "Buffs.CriaEstelarBuff.Description": "Una cría de sierpe estelar nada a tu lado y caza a tus enemigos",

        "Items.TajosAstralesStaff.DisplayName": "El Bastón de los Tajos Astrales",
        "Items.TajosAstralesStaff.Tooltip": "Marca el punto donde apuntas — y diez ticks después EL CORTE FLORECE:\nsiete medias lunas blancas en todas direcciones, creciendo de punta a punta.\nLa herida llega cuando el tajo aparece (causalidad retrasada).\nCada arco corta una vez su banda curva · sin coste de maná.",

        "Projectiles.TajoAstralProjectile.DisplayName": "Tajo Astral",

        "Common.LevelUp": "Tu arma ha alcanzado el nivel {0}!",
        "Common.Milestone": "Hito alcanzado: {0}",
}
