        "Items.UmbralBlackHoleStaff.DisplayName": "Bastón del Agujero del Umbral",
        "Items.BrumaBlackHoleStaff.DisplayName": "Bastón del Agujero de la Bruma",
        "Items.OlvidoBlackHoleStaff.DisplayName": "Bastón del Agujero del Olvido",
        // v6.18: LOS CINCO NUEVOS — el Supremo y los 4 Ascendidos
        "Items.SupremoBlackHoleStaff.DisplayName": "Bastón del Agujero Negro Supremo",
        // v6.20: el hermano AURORA del Supremo (gradiente negro→morado→azul→dorado)
        "Items.SupremoAuroraBlackHoleStaff.DisplayName": "Bastón del Agujero Supremo Aurora",
        "Items.UmbralAscendidoBlackHoleStaff.DisplayName": "Bastón del Umbral Ascendido",
        "Items.BrumaAscendidoBlackHoleStaff.DisplayName": "Bastón de la Bruma Ascendida",
        "Items.CosmicAscendidoBlackHoleStaff.DisplayName": "Bastón del Cósmico Ascendido",
        "Items.OlvidoAscendidoBlackHoleStaff.DisplayName": "Bastón del Olvido Ascendido",
        "Items.VoidCrownItem.DisplayName": "Corona de la Reina del Vacío",
        "Items.VoidCrownItem.Tooltip": "La corona original del agujero negro carmesí, hoy cosmético portable.\nCinco arcos de neón carmesí con nudos naranjas arqueados JUSTO DETRÁS de tu cabeza.\nPuro cosmético: sin estadísticas. Vale en huecos de accesorio o vanidad.",

        "Items.RuneCrownItem.DisplayName": "Corona Rúnica Estelar",
        "Items.RuneCrownItem.Tooltip": "Una corona nueva diseñada desde cero: ocho glifos rúnicos de luz fucsia\nflotando en arco sobre tu cabeza, cada uno con su perla rosa pálido en la punta.\nPuro cosmético: sin estadísticas. Vale en huecos de accesorio o vanidad.",

        // v6.35: LOS TRES ACCESORIOS DE LAS LIBRERÍAS DE SIGNOS MÁGICOS —
        // los sellos y anillos que RODEAN AL JUGADOR (SigiloLib + OrbitaLib).
        "Items.SelloGenesisItem.DisplayName": "El Sello del Génesis",
        "Items.SelloGenesisItem.Tooltip": "Los signos mágicos del sol te rodean: el aro doble con las ocho runas girando,\ny dentro el sello azul-estelar contrarrotando con el glifo del astro.\n+40 de maná máximo, +8% de daño mágico y +4% de crítico mágico.\nVale en huecos de accesorio o de vanidad.",

        "Items.AnillosSolRunicoItem.DisplayName": "Los Anillos del Sol Rúnico",
        "Items.AnillosSolRunicoItem.Tooltip": "Siete aros rúnicos orbitan tu cuerpo en planos alternos:\npar horario, impar antihorario, precesando vivos con sus runas a lomos.\n+2 de regeneración de vida, +8% de daño melé, +3% de crítico melé y +3 de defensa.\nVale en huecos de accesorio o de vanidad.",

        "Items.AnillosHorizonteItem.DisplayName": "Los Anillos del Horizonte de Sucesos",
        "Items.AnillosHorizonteItem.Tooltip": "El disco de acreción te orbita: veinte bandas incandescentes viajando,\nlos fotones corriendo el vórtice y el aro fino del horizonte.\nLA LENTE: el fondo se curva a tu alrededor. LA SUCCIÓN: los enemigos cercanos se deslizan hacia ti.\n+10% de velocidad y +5% de daño universal. Vale en huecos de accesorio o de vanidad.",

        // v6.19: LA FAMILIA DE LOS SOLES RÚNICOS — 10 copias del Sol
        // (el Sol original queda INTACTO) con N anillos rúnicos en planos
        // orbitales de giros alternos, mejoras progresivas por copia.
        "Items.SolRunico1Staff.DisplayName": "Bastón del Sol Rúnico I",
        "Items.SolRunico2Staff.DisplayName": "Bastón del Sol Rúnico II",
        "Items.SolRunico3Staff.DisplayName": "Bastón del Sol Rúnico III",
        "Items.SolRunico4Staff.DisplayName": "Bastón del Sol Rúnico IV",
        "Items.SolRunico5Staff.DisplayName": "Bastón del Sol Rúnico V",
