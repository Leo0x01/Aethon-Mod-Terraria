        "Buffs.NebulaJellyfishBuff.DisplayName": "Medusa Nebular",
        "Buffs.NebulaJellyfishBuff.Description": "Una medusa de nebulosa deriva a tu lado a pulsos de gravedad",

        "Items.LivingCometStaff.DisplayName": "Báculo del Cometa Estelar",
        "Items.LivingCometStaff.Tooltip": "Invoca EL COMETA ESTELAR.\nUn cometa vivo con corona de 8 puntas estelares, orbitándote en una elipse excéntrica.\nCAE EN PICADO sobre tus enemigos y estalla en una pequeña nova.",

        "Projectiles.StellarCometMinion.DisplayName": "Cometa Estelar",

        "Buffs.StellarCometBuff.DisplayName": "Cometa Estelar",
        "Buffs.StellarCometBuff.Description": "Un cometa vivo orbita a tu lado y cae en picado sobre tus enemigos",

        "Items.LivingPulsarStaff.DisplayName": "Báculo del Púlsar Vivo",
        "Items.LivingPulsarStaff.Tooltip": "Invoca EL PÚLSAR VIVO.\nUna estrella de neutrones girando a tu lado, barriendo el campo con dos haces de faro de radiación.\nTodo lo que cruzan queda ELECTRIFICADO.",

        "Projectiles.LivingPulsarMinion.DisplayName": "Púlsar Vivo",

        "Buffs.LivingPulsarBuff.DisplayName": "Púlsar Vivo",
        "Buffs.LivingPulsarBuff.Description": "Una estrella de neutrones gira a tu lado, sus haces rañando a tus enemigos",

        "Buffs.OcasoActivoBuff.DisplayName": "El Ocaso",
        "Buffs.OcasoActivoBuff.Description": "El ocaso arde: 8 segundos de muertes de estrella a daño ×3 con ejecución",
