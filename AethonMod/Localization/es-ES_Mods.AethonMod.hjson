        "Items.SolRunico2Staff.DisplayName": "Bastón del Sol Rúnico II",
        "Items.SolRunico3Staff.DisplayName": "Bastón del Sol Rúnico III",
        "Items.SolRunico4Staff.DisplayName": "Bastón del Sol Rúnico IV",
        "Items.SolRunico5Staff.DisplayName": "Bastón del Sol Rúnico V",
