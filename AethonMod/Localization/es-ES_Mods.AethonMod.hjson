Mods.AethonMod.DisplayName: Aethon, la Luz Primordial

Items: {
	GenesisShard: {
		DisplayName: Fragmento Génesis
		Tooltip:
			'''
			Arma de luz que dispara partículas autoguiadas.
			Material para craftear el Grimorio del Eterno.
			Dropea de King Slime y Eye of Cthulhu.
			'''
	}

	AncientAltarItem: {
		DisplayName: Altar Antiguo
		// Tooltip: ""
	}

	ResonanceShard: {
		DisplayName: Fragmento de Resonancia
		Tooltip: Moneda cósmica. Se obtiene de jefes.
	}

	GrimoireEternal: {
		DisplayName: Grimorio del Eterno
		Tooltip:
			'''
			Arma híbrida mágica/de invocación.
			Click izq: bolt arcano. Click der: invoca minion.
			Gana XP REAL con cada baja: la rareza del bestiario (0–5 estrellas)
			mide su valor, la PRIMERA kill de cada especie paga ×3 y el hardmode
			duplica a las criaturas; los jefes pagan XP FIJA (base + 10% de su
			vida + estrellas + un término que crece con tu nivel).
			LOS TRES ESTADOS: sostenido = todo el poder; en la barra rápida =
			sigue comiendo XP, conserva los slots de minion y vida/maná (tope
			+100); guardado = nada (los minions ya invocados permanecen).
			Sin coste de maná (pruebas).
			'''
	}

	BossSummonBag: {
		DisplayName: Bolsa de Invocadores
		Tooltip:
			'''
			Contiene 999 invocadores de cada jefe.
			Item de testing — eliminar antes de release.
			'''
	}

	LevelUpTester: {
		DisplayName: Verdugo de Niveles
		Tooltip:
			'''
			Da +10 niveles al Grimorio del Eterno.
			Busca en todo el inventario.
			Item de testing — eliminar antes de release.
			'''
	}

	CarnadaDelGrimorio: {
		DisplayName: La Carnada del Grimorio
		Tooltip:
			'''
			Provoca LAS OLEADAS DEL HAMBRE sin esperar.
			Clic izq: desata la furia (las oleadas preparadas).
			Clic der: prepara 1..11 oleadas (11 = EL JUICIO: los 7 guardianes ×15).
			Todo lo que muera en la oleada k paga XP ×(k+1); la especial, ×15.
			Item de testing — eliminar antes de release.
			'''
	}

	CristalDelTitanHueco: {
		DisplayName: Cristal del Titán Hueco
		Tooltip:
			'''
			Fragmento del coloso cristalino del Sagrario.
			Convoca al TITÁN HUECO.
			SOLO FUNCIONA DE DÍA — la noche es de los muertos.
			'''
	}

	SelloDelRift: {
		DisplayName: Sello del Rift
		Tooltip:
			'''
			La llave del que existe mitad aquí, mitad entre mundos.
			Convoca al GUARDIÁN DEL RIFT.
			SOLO FUNCIONA DE DÍA.
			'''
	}

	PlumaDeLaArquera: {
		DisplayName: Pluma de la Arquera
		Tooltip:
			'''
			Cayó del cielo la vez que ella intentó derribar a Aethon.
			Convoca al ECO DE LA ARQUERA ESTELAR.
			SOLO FUNCIONA DE DÍA.
			'''
	}

	SombraDelPortador: {
		DisplayName: Sombra del Portador
		Tooltip:
			'''
			La silueta del primer alma que se ató a un fragmento.
			Convoca al ECO DEL PRIMER PORTADOR.
			SOLO FUNCIONA DE DÍA.
			'''
	}

	NombreDeAethon: {
		DisplayName: El Nombre de Aethon
		Tooltip:
			'''
			«Ve al Sagrario Hueco y llama su nombre.»
			Convoca a AETHON, LA LUZ PRIMORDIAL.
			SOLO FUNCIONA DE DÍA.
			Las cinco fases esperan — el reconocimiento final.
			'''
	}

	MedusaNebularStaff: {
		DisplayName: Báculo de la Medusa Nebular
		Tooltip:
			'''
			Invoca LA MEDUSA NEBULAR.
			Una campana translúcida con una galaxia espiral dentro, nadando a pulsos de gravedad.
			Su campana dispara LÁTIGOS ELÉCTRICOS que salen de ella misma, dejando la quemadura fría del vacío.
			'''
	}

	LivingCometStaff: {
		DisplayName: Báculo del Cometa Estelar
		Tooltip:
			'''
			Invoca EL COMETA ESTELAR.
			Un cometa vivo con corona de 8 puntas estelares, orbitándote en una elipse excéntrica.
			CAE EN PICADO sobre tus enemigos y estalla en una pequeña nova.
			'''
	}

	LivingPulsarStaff: {
		DisplayName: Báculo del Púlsar Vivo
		Tooltip:
			'''
			Invoca EL PÚLSAR VIVO.
			Una estrella de neutrones girando a tu lado, barriendo el campo con dos haces de faro de radiación.
			Todo lo que cruzan queda ELECTRIFICADO.
			'''
	}

	BolsaProbador: {
		DisplayName: Bolsa del Probador
		Tooltip:
			'''
			Las herramientas de pruebas de Aethon.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			La bolsa es permanente: reábrela cuando pierdas algo.
			'''
	}

	BolsaFundacionales: {
		DisplayName: Bolsa de los Bastones Fundacionales
		Tooltip:
			'''
			Los cuatro bastones que empezaron todo.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaClasicosCosmicos: {
		DisplayName: Bolsa de los Clásicos Cósmicos
		Tooltip:
			'''
			El sol primordial y sus criaturas vivas.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaAgujerosNegros: {
		DisplayName: Bolsa de los Agujeros Negros
		Tooltip:
			'''
			Diez formas de devorar la luz.
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaSolesRunicos: {
		DisplayName: Bolsa de los Soles Rúnicos
		Tooltip:
			'''
			Del sol de un anillo al Gran Sellado (los 20).
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaEstrellasReales: {
		DisplayName: Bolsa de las Estrellas Reales
		Tooltip:
			'''
			Física de verdad convertida en armas (las 7).
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaArmasLibrerias: {
		DisplayName: Bolsa de las Armas de las Librerías
		Tooltip:
			'''
			Cada arma es un concierto de nuestras librerías VFX (las 7).
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaBastonesCreativos: {
		DisplayName: Bolsa de los Bastones Creativos
		Tooltip:
			'''
			El gauge, el péndulo, el coro y demás rarezas (los 6).
			Clic derecho para desplegarlos.
			Solo entrega lo que te falte.
			'''
	}

	BolsaExhumados: {
		DisplayName: Bolsa de los Exhumados
		Tooltip:
			'''
			Las formas exhumadas: el rencor y la eminencia.
			Las formas exhumadas originales del arsenal.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaCosmeticos: {
		DisplayName: Bolsa de los Cosméticos
		Tooltip:
			'''
			Coronas, sellos y anillos que se ciñen a tu personaje.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaDosFormas: {
		DisplayName: Bolsa de las Dos Formas
		Tooltip:
			'''
			Las armas de las dos formas de uso: cada una despliega su forma alternativa.
			Las cuatro que aprendieron a decir dos cosas a la vez.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	BolsaDesgarros: {
		DisplayName: Bolsa de los Desgarros
		Tooltip:
			'''
			Los bastones que rajan la realidad: sutura, portal, pliegue, herida,
			corazón, garganta, umbral y leviatán. Cada desgarro se abre distinto.
			Clic derecho para desplegarlas.
			Solo entrega lo que te falte.
			'''
	}

	RencorPrimordialStaff: {
		DisplayName: El Rencor Primordial
		Tooltip:
			'''
			La forma exhumada del arsenal: EL RENCOR PRIMORDIAL.
			Clava un círculo de transmutación rúnico a 380 px.
			3 s de carga → EL HAZ CONTINUO carmesí-ámbar que perfora TODO.
			Al tocar pared: brazos espectrales (×0.66) y ascuas (×0.33).
			Los enemigos del haz se desintegran en ceniza. Sin maná.
			'''
	}

	EminenciaAtrozStaff: {
		DisplayName: La Eminencia Atroz
		Tooltip:
			'''
			La forma exhumada del arsenal: LA EMINENCIA ATROZ.
			Sostén el uso: la congregación de espíritus canaliza cerca del cursor.
			14 s de acumulación → LA ABOMINACIÓN, control total.
			El daño crece del 100% al 185% mientras se acumula.
			Si sueltas el canal, la masa decae y se disipa. Sin maná.
			'''
	}

	OcasoAethonStaff: {
		DisplayName: Bastón del Ocaso de Aethon
		Tooltip:
			'''
			El arma suprema del medidor: carga → estallido → bloqueo.
			Cada impacto de un fragmento carga el aro de tu cabeza.
			Aro lleno: CLIC DERECHO enciende EL OCASO (8 s de muertes de estrella ×3).
			Bajo el 50% de vida del objetivo, la muerte EJECUTA.
			Después: 2 s de sobrecalentada. Sin maná.
			'''
	}

