        "Projectiles.PhoenixNovaProjectile.DisplayName": "Nova del Fénix",
        "Projectiles.QuantumSplitProjectile.DisplayName": "División Cuántica",
        "Projectiles.CosmicBlackHoleProjectile.DisplayName": "Agujero Cósmico",
        "Projectiles.UmbralBlackHoleProjectile.DisplayName": "Agujero del Umbral",
        "Projectiles.BrumaBlackHoleProjectile.DisplayName": "Agujero de la Bruma",
