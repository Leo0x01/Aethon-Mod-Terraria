        "Projectiles.NeutronStarProjectile.DisplayName": "Estrella de Neutrones",
        "Projectiles.PulsarProjectile.DisplayName": "Púlsar",
        "Projectiles.WhiteDwarfProjectile.DisplayName": "Enana Blanca",
        "Projectiles.DeadStarProjectile.DisplayName": "Estrella Muerta",
        "Projectiles.RedSupergiantProjectile.DisplayName": "Supergigante Roja",
        "Projectiles.MagnetarProjectile.DisplayName": "Magnetar",
        "Projectiles.CicloEstelarProjectile.DisplayName": "Ciclo Estelar",
        "Projectiles.RelojArenaProjectile.DisplayName": "Reloj de Arena Cósmico",
        "Projectiles.MareaGravitatoriaProjectile.DisplayName": "Marea Gravitatoria",
        "Projectiles.MareaChicaProjectile.DisplayName": "Ola Menor",
        "Projectiles.EnjambrePrismaticoProjectile.DisplayName": "Enjambre Prismático",
        "Projectiles.PenduloJuicioProjectile.DisplayName": "Péndulo del Juicio",
        "Projectiles.CoroEspectralProjectile.DisplayName": "Coro Espectral",
        "Projectiles.LanzaAlbaProjectile.DisplayName": "Lanza del Alba",
        "Projectiles.RealityTearProjectile.DisplayName": "Desgarro de Realidad",
        "Projectiles.SinfoniaPrimordialProjectile.DisplayName": "Sinfonía Primordial",
        "Projectiles.TormentaNebularProjectile.DisplayName": "Tormenta Nebular",

        "Items.SuturaCuanticaStaff.DisplayName": "La Sutura Cuántica",
        "Items.SuturaCuanticaStaff.Tooltip": "Abre un DESGARRO GLITCH donde apuntas.\nCorrompe a todo enemigo dentro del círculo.\nCada 45 ticks dispara rayos cuánticos a los 3 más cercanos.",
        "Items.PortalDimensionalStaff.DisplayName": "El Portal Dimensional",
        "Items.PortalDimensionalStaff.Tooltip": "Abre la puerta de anillos donde apuntas.\nSucción suave en 300 px: el que cruza el núcleo blanco es triturado.\nEl portal respira 6 segundos.",
        "Items.PliegueEspacioStaff.DisplayName": "El Pliegue del Espacio",
        "Items.PliegueEspacioStaff.Tooltip": "Abre el OJO donde apuntas: la doble elipse con el núcleo negro.\nDobla el espacio en 350 px y arrastra a los enemigos.\nEl que toca el núcleo es comprimido.",
        "Items.HeridaElectricaStaff.DisplayName": "La Herida Eléctrica",
        "Items.HeridaElectricaStaff.Tooltip": "Abre LA GRIETA hacia donde apuntas.\nPica en línea y aplica ELECTRIFICADO.\nLa corriente nunca se corta.",

        // v6.35: LOS CUATRO DESGARROS NUEVOS (segunda tanda de referencias).
        "Items.CorazonColapsoStaff.DisplayName": "El Corazón del Colapso",
        "Items.CorazonColapsoStaff.Tooltip": "Enciende la ESTRELLA DE CUATRO PUNTAS de fuego estelar.\nQuema a todo enemigo dentro del corazón.\nCada 30 ticks los filamentos lanzan llamaradas a los 2 más cercanos.",

        "Items.GargantaVacioStaff.DisplayName": "La Garganta del Vacío",
        "Items.GargantaVacioStaff.Tooltip": "Abre el vórtice devorador: núcleo negro absoluto y anillo magenta.\nLa lente curva el fondo y la succión arrastra en 320 px.\nEl que toca el núcleo negro es devorado.",

        "Items.UmbralRotoStaff.DisplayName": "El Umbral Roto",
        "Items.UmbralRotoStaff.Tooltip": "Raja la realidad con un corte horizontal perfecto.\nArriba el vacío con el esqueleto espectral; abajo, el mundo.\nPica en línea y cada 60 ticks la otra realidad muerde.",

        "Items.LeviatanEspectralStaff.DisplayName": "El Leviatán Espectral",
        "Items.LeviatanEspectralStaff.Tooltip": "Lanza a la criatura de hueso etéreo: catorce vértebras nadando en S.\nAtraviesa todo lo que toca y gira hacia el enemigo más cercano.\n4 segundos de nado espectral.",

        "Projectiles.DesgarroCuanticoProjectile.DisplayName": "Sutura Cuántica",
        "Projectiles.PortalDimensionalProjectile.DisplayName": "Portal Dimensional",
        "Projectiles.PliegueEspacioProjectile.DisplayName": "Pliegue del Espacio",
        "Projectiles.HeridaElectricaProjectile.DisplayName": "Herida Eléctrica",
        "Projectiles.CorazonColapsoProjectile.DisplayName": "Corazón del Colapso",
        "Projectiles.GargantaVacioProjectile.DisplayName": "Garganta del Vacío",
        "Projectiles.UmbralRotoProjectile.DisplayName": "Umbral Roto",
        "Projectiles.LeviatanEspectralProjectile.DisplayName": "Leviatán Espectral",

        // v6.36: LOS CUATRO CÓDIGOS VIVOS (los códigos de las imágenes
        // del usuario traducidos a armas) + EL ANILLO RÚNICO DORSAL.
        "Items.DanzaOrbesStaff.DisplayName": "La Danza de los Orbes",
        "Items.DanzaOrbesStaff.Tooltip": "Invoca el código vivo de la cadena: un minisistema solar orbitándote.\nTodo orbe quema al que toca: sol ×1.0, planetas ×0.7, lunas ×0.5.\n12 segundos de danza · un sistema a la vez · sin coste de maná.",

        "Items.LenteAbismoStaff.DisplayName": "La Lente del Abismo",
        "Items.LenteAbismoStaff.Tooltip": "Planta el código vivo del agujero negro: disco de veinte bandas,\nhorizonte negro y estrellas dobladas cayendo en espiral.\nLa lente curva el fondo · succión en 300 px · devora ×1.2 · enfoca y muerde ×0.6.",

        "Items.SolVivoStaff.DisplayName": "El Sol Vivo",
        "Items.SolVivoStaff.Tooltip": "Enciende el código vivo del sol: latiendo con el pulso exacto del original.\nEl aura quema ×0.55 · cada pico del pulso LATE ×0.7 · las prominencias azotan ×0.85.\n5 segundos de sol · un sol a la vez · sin coste de maná.",

        "Items.SierpeEstelarStaff.DisplayName": "La Sierpe Estelar",
        "Items.SierpeEstelarStaff.Tooltip": "Libera el código vivo de la criatura: dieciséis segmentos — cabeza,\naletas gemelas y espina — nadando en vueltas alrededor de tu cursor.\nLa cabeza atraviesa todo · la espina quema ×0.4 · una sierpe a la vez.",

        "Items.AnilloRunicoDorsalItem.DisplayName": "El Anillo Rúnico Dorsal",
        "Items.AnilloRunicoDorsalItem.Tooltip": "El círculo de conjuro del agujero negro cuelga de tu espalda:\nla triple corona rúnica LITERAL de los vórtices — dorada, violeta\ncontrarrotante y blanca íntima junto al anillo de fotones.\nPuro cosmético: cero estadísticas.",

        "Items.BolsaCodigosVivos.DisplayName": "Bolsa de los Códigos Vivos",
        "Items.BolsaCodigosVivos.Tooltip": "Los códigos de las imágenes hechos armas: la danza de los orbes,\nla lente del abismo, el sol vivo y la sierpe estelar.\nCada código aprendió a vivir aquí. Clic derecho para desplegarlas.\nSolo entrega lo que te falte.",

        "Projectiles.DanzaOrbesProjectile.DisplayName": "Danza de los Orbes",
        "Projectiles.LenteAbismoProjectile.DisplayName": "Lente del Abismo",
        "Projectiles.SolVivoProjectile.DisplayName": "Sol Vivo",
        "Projectiles.SierpeEstelarProjectile.DisplayName": "Sierpe Estelar",

        // v6.38: LA CAMADA DE LAS SIERPES (10 formas nuevas de mover la
        // misma cadena + la cría, el minion — la original INTACTA).
        "Items.OuroborosAstralStaff.DisplayName": "El Ouroboros Astral",
        "Items.OuroborosAstralStaff.Tooltip": "Doce cuentas se persiguen en círculo apuntando adelante — nadie manda.\nCada cuenta barre ×0.55; al expirar la espiral se cierra y DETONA ×2.0.\n10 segundos de anillo · sin coste de maná.",

        "Items.CaravanaEspectralStaff.DisplayName": "La Caravana Espectral",
        "Items.CaravanaEspectralStaff.Tooltip": "El cuerpo repite la trayectoria EXACTA del faro: el camino-memoria.\nEl rastro limpia el pasillo ×0.35 — con giros dibujas muros en S.\n9 segundos de caravana · sin coste de maná.",

        "Items.AnguilaSolarStaff.DisplayName": "La Anguila Solar",
        "Items.AnguilaSolarStaff.Tooltip": "El cuerpo ES una fórmula: la onda viajera de la anguila, λ ≈ el cuerpo.\nLas CRESTAS muerden ×1.0, los valles solo ×0.30 — roza con la cresta.\n8 segundos de nado en S · sin coste de maná.",

        "Items.CienpiesRunicoStaff.DisplayName": "El Ciempiés Rúnico",
        "Items.CienpiesRunicoStaff.Tooltip": "Doce placas pegadas al suelo con una pata desfasada Δφ=45° cada una.\nLas patas plantadas dejan su RUNA: la runa pica ×0.40.\nLa marcha sube de frecuencia lejos de la presa · sin coste de maná.",

        "Items.FlageloEstelarStaff.DisplayName": "El Flagelo Estelar",
        "Items.FlageloEstelarStaff.Tooltip": "El látigo de Verlet con constraint por masa: la energía corre a la punta.\nLa punta golpea ∝ su velocidad (×0.5 → ×1.5); sobre 26 px/tick,\nEL CHASQUIDO: ×2.2 + sacudida. 8 segundos · sin coste de maná.",

        "Items.ViboraGenesiacaStaff.DisplayName": "La Víbora Genesíaca",
        "Items.ViboraGenesiacaStaff.Tooltip": "Un esqueleto, dos cuerpos: la espina de la sierpe y DOS HEBRAS trenzadas.\nLas perlas queman ×0.45; al enroscar el rumbo la hélice se comprime ×1.6.\n9 segundos de víbora · sin coste de maná.",

        "Items.BoaEclipseStaff.DisplayName": "La Boa del Eclipse",
        "Items.BoaEclipseStaff.Tooltip": "La cabeza hace la servo-espiral sobre la presa y el cuerpo la envuelve.\nCada vuelta completa es un stack de APRIETE: ×0.5 → ×4.0.\nLa presa cae y busca la siguiente. 10 segundos · sin coste de maná.",

        "Items.FarolGuardianStaff.DisplayName": "El Farol Guardián",
        "Items.FarolGuardianStaff.Tooltip": "La base es un farol colgante y la PUNTA persigue a la presa (FABRIK).\nLa mano muerde ×1.0 y la cadena quema ×0.40 — el cuerpo se TENSA.\n12 segundos de guardián · sin coste de maná.",

        "Items.CintaAuroraStaff.DisplayName": "La Cinta Aurora",
        "Items.CintaAuroraStaff.Tooltip": "El estandarte vivo: la espina anclada a tu espalda y dos senos inconmensurables.\nLa cinta corta ×0.5; la amplitud es TU VELOCIDAD — corre y se vuelve látigo.\n12 segundos de estandarte · sin coste de maná.",

        "Items.ManadaAstralStaff.DisplayName": "La Manada Astral",
        "Items.ManadaAstralStaff.Tooltip": "Seis cazadores con distancia ELÁSTICA y liderazgo que SALTA.\nCada cazador golpea con SU PROPIA velocidad: ×0.55 → ×1.4.\n10 segundos de cacería · sin coste de maná.",

        "Items.CriaEstelarStaff.DisplayName": "La Cría Estelar",
        "Items.CriaEstelarStaff.Tooltip": "La hijita de la sierpe estelar: el MISMO ADN, pero cachorra y despierta.\nEn reposo nada a tu alrededor; en caza embiste (mordida de minion).\nOcupa 1 espacio de sirviente · nunca expira · sin coste de maná.",

        "Items.BolsaSierpes.DisplayName": "Bolsa de las Sierpes",
        "Items.BolsaSierpes.Tooltip": "La sierpe estelar y sus once descendientes: cada una nada distinto.\nEl anillo, la caravana, la anguila, el ciempiés, el látigo, la víbora,\nla boa, el farol, la cinta, la manada y la cría. Clic derecho.\nSolo entrega lo que te falte.",

        "Projectiles.OuroborosAstralProjectile.DisplayName": "Ouroboros Astral",
        "Projectiles.CaravanaEspectralProjectile.DisplayName": "Caravana Espectral",
        "Projectiles.AnguilaSolarProjectile.DisplayName": "Anguila Solar",
        "Projectiles.CienpiesRunicoProjectile.DisplayName": "Ciempiés Rúnico",
        "Projectiles.FlageloEstelarProjectile.DisplayName": "Flagelo Estelar",
        "Projectiles.ViboraGenesiacaProjectile.DisplayName": "Víbora Genesíaca",
        "Projectiles.BoaEclipseProjectile.DisplayName": "Boa del Eclipse",
        "Projectiles.FarolGuardianProjectile.DisplayName": "Farol Guardián",
        "Projectiles.CintaAuroraProjectile.DisplayName": "Cinta Aurora",
        "Projectiles.ManadaAstralProjectile.DisplayName": "Manada Astral",
        "Projectiles.CriaEstelarMinion.DisplayName": "Cría Estelar",

        "Buffs.CriaEstelarBuff.DisplayName": "Cría Estelar",
        "Buffs.CriaEstelarBuff.Description": "Una cría de sierpe estelar nada a tu lado y caza a tus enemigos",

        "Items.TajosAstralesStaff.DisplayName": "El Bastón de los Tajos Astrales",
        "Items.TajosAstralesStaff.Tooltip": "Marca el punto donde apuntas — y diez ticks después EL CORTE FLORECE:\nsiete medias lunas blancas en todas direcciones, creciendo de punta a punta.\nLa herida llega cuando el tajo aparece (causalidad retrasada).\nCada arco corta una vez su banda curva · sin coste de maná.",

        "Projectiles.TajoAstralProjectile.DisplayName": "Tajo Astral",

        "Projectiles.AnillosSolaresHalo.DisplayName": "Anillos Solares",
        "Projectiles.SelloGenesisHalo.DisplayName": "Sello del Génesis",
        "Projectiles.AnilloRunicoDorsalHalo.DisplayName": "Anillo Rúnico Dorsal",

        "Items.TomoApatiaNula.DisplayName": "El Tomo de la Apatía Nula",
        "Items.TomoApatiaNula.Tooltip": "El tomo que ya no siente nada escupe tentáculos de vacío:\ngestan 2 segundos sin dañar (pulsos que imploden) y luego azotan\nen tres curvas hacia tu mira, teletransportándose entre curva y curva.\nGolpea todo lo que toca (90×90) · cada impacto sucesivo pesa menos.\nARMA DE PRUEBAS (réplica exacta de su fuente de estudio).",

        "Projectiles.TentaculoCosmicoProjectile.DisplayName": "Tentáculo del Vacío",

        "Items.FragmentoSupernovaStaff.DisplayName": "El Fragmento de Supernova",
        "Items.FragmentoSupernovaStaff.Tooltip": "La singularidad alada hecha sirviente: el ojo alado con sus\nafterimages orbitando y respirando a su alrededor (la firma).\nVOLEA de 5 ráfagas nova en abanico · BEAM telegrafiado de 900px (×2.5)\n· flor de fuego al morir cada ráfaga · sin coste de maná.\nMINION: ocupa 1 espacio de sirviente · nunca expira.\nARMA DE PRUEBAS (réplica del jefe de la singularidad alada).",

        "Projectiles.FragmentoSupernovaMinion.DisplayName": "Fragmento de Supernova",
        "Projectiles.RafagaNovaProjectile.DisplayName": "Ráfaga Nova",

        "Buffs.FragmentoSupernovaBuff.DisplayName": "Fragmento de Supernova",
        "Buffs.FragmentoSupernovaBuff.Description": "Una singularidad alada flota a tu hombro y dispara ráfagas y rayos a tus enemigos",

        "Items.BolsaHuespedes.DisplayName": "Bolsa de los Huéspedes",
        "Items.BolsaHuespedes.Tooltip": "Las réplicas de prueba: el tentáculo del vacío, el fragmento\nde supernova y los tajos astrales. Clic derecho.\nSolo entrega lo que te falte.",

        "Items.MetronomoPulsar.DisplayName": "El Metrónomo de Púlsar",
        "Items.MetronomoPulsar.Tooltip": "El arma que dispara AL COMPÁS: el púlsar sobre tu cabeza late cada 0,5 s.\nPERFECT (±0,05 s): crítico garantizado + abanico doble.\nGOOD (±0,1 s): crítico garantizado. Fuera de compás: el combo se pierde.\n8 aciertos seguidos: EL FARO — 3 s de haz giratorio de 900 px.\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.MetronomoPulsarHalo.DisplayName": "Metrónomo de Púlsar",
        "Projectiles.PulsoPulsarProjectile.DisplayName": "Pulso de Púlsar",

        "Items.VelaSolar.DisplayName": "La Vela Solar",
        "Items.VelaSolar.Tooltip": "Mantén pulsado: la vela de fotones se despliega y la cadencia sube\nde 12 a 30 disparos/s con el calor (daño ×1 → ×1,6).\nAl calor pleno: LA FUSIÓN — 1,5 s de plasma ×2 y luego la vela se funde (3 s).\nSoltar a tiempo conserva ~70% del calor.\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.VelaSolarProjectile.DisplayName": "Vela Solar",
        "Projectiles.RafagaSolarProjectile.DisplayName": "Ráfaga Solar",

        "Items.GuadanaDesgarro.DisplayName": "La Guadaña del Desgarro",
        "Items.GuadanaDesgarro.Tooltip": "El tajo vuela 220 px y donde muere abre UNA FISURA VERTICAL de realidad (2 s):\ntodo lo que la cruza sangra, y los proyectiles enemigos que la tocan\nDESAPARECEN — los traga y su daño se suma AL PRÓXIMO Tajo (EL HAMBRE).\nClic der: la fisura se abre directamente en tu mira (≤480 px).\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.TajoGuadanaProjectile.DisplayName": "Tajo de la Guadaña",
        "Projectiles.FisuraDesgarroProjectile.DisplayName": "Fisura de Realidad",

        "Items.EgidaNova.DisplayName": "La Égida de Nova",
        "Items.EgidaNova.Tooltip": "Clic izq: EL EMBESTÓN — golpe de escudo con empujón 9.\nClic der: ALZAR LA GUARDIA (0,3 s): un golpe en la ventana perfecta\nNO EXISTE — detona LA NOVA (3× + quemadura + 1 s invulnerable).\nLa guardia que expira sin parar te aturde 0,5 s. Enfriamiento 8 s (anillo visible).\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.GuardiaNovaProjectile.DisplayName": "Guardia de Nova",
        "Projectiles.AnilloEnfriamientoProjectile.DisplayName": "Anillo de Enfriamiento",
        "Projectiles.NovaParryProjectile.DisplayName": "Nova del Parry",
        "Projectiles.EmbestidaNovaProjectile.DisplayName": "Embestida de Nova",

        "Items.EcoCuantico.DisplayName": "El Eco Cuántico",
        "Items.EcoCuantico.Tooltip": "Cada pulso vuela y decohiere en una semilla que se re-emite como ECO\ncontra el enemigo más cercano (60% · 36% · 21,6%: 2,17× por cadena completa).\nClic der: LA RESONANCIA — todas las semillas disparan A LA VEZ (5 s de recarga).\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.PulsoEcoProjectile.DisplayName": "Pulso Cuántico",

        "Items.VerboPrimordialStaff.DisplayName": "El Verbo Primordial",
        "Items.VerboPrimordialStaff.Tooltip": "La palabra que pronunció la primera luz — SIETE MOVIMIENTOS:\nI EL PULSO · II EL SELLO · III LA CORONA · IV LA TORMENTA\nV EL FUEGO · VI EL DESGARRO · VII LA SINFONÍA\nCada movimiento habla con las bibliotecas de la casa; el daño crece ×1,0 → ×1,4\ny al séptimo segundo: LA DETONACIÓN (2,5× + quemadura).\nARMA DE PRUEBAS — sin coste de maná.",
        "Projectiles.VerboPrimordialProjectile.DisplayName": "El Verbo Primordial",
        "Projectiles.VerboDetonacionProjectile.DisplayName": "Detonación del Verbo",

        "Items.BolsaApuestas.DisplayName": "Bolsa de las Apuestas",
        "Items.BolsaApuestas.Tooltip": "Las cinco apuestas de la casa (el ritmo, la cadencia, la zona,\nel parry y el eco) y EL VERBO PRIMORDIAL que las une. Clic derecho.\nSolo entrega lo que te falte.",

        "Common.LevelUp": "Tu arma ha alcanzado el nivel {0}!",
        "Common.Milestone": "Hito alcanzado: {0}",

        "Items.PrismaDePaisajesItem.DisplayName": "El Prisma de Paisajes",
        "Items.PrismaDePaisajesItem.Tooltip": "El probador de la librería del cielo: cada uso despliega UN PAISAJE\nentero sobre el fondo del mundo — capas con su parallax, su deriva,\nsu profundidad y sus tintes de cielo, luz y brillo.\nCiclo: Eclipse Umbral → Lluvia Estelar → Amanecer Primordial → Sagrario Violeta → cielo limpio.\nEL SAGRARIO VIOLETA: el paisaje del lugar, desplegable donde quieras.\nARMA DE PRUEBAS — sin coste de maná.",

        "Eco.VozJefe.KingSlime1": "La corona rueda por el suelo. El grimorio sorbe la esencia del rey gelatina: dulce, vacía, de un trono que nunca fue suyo.",
        "Eco.VozJefe.KingSlime2": "Un rey de gelatina: todo el reino, ninguno el hueso. El grimorio lo bebe de un trago y eructa un trueno azul.",
        "Eco.VozJefe.KingSlime3": "El rey gelatina se deshace en la hierba. El grimorio mastica la corona aparte — el metal no sabe a nada, pero la guarda por educación.",
        "Eco.VozJefe.EyeofCthulhu1": "El ojo se cierra para siempre. El grimorio devora su vigilia hambrienta — ahora sabe soñar con lo que tú ves.",
        "Eco.VozJefe.EyeofCthulhu2": "El gran ojo se apaga sin cerrar los párpados — nunca los tuvo. El grimorio lo desmenuza y aprende a llorar hacia dentro.",
        "Eco.VozJefe.EyeofCthulhu3": "Cthulhu lo perdió todo menos la vista. El grimorio se queda la vista: ahora mira lo que TÚ miras, cuando quiere.",
        "Eco.VozJefe.Deerclops1": "El invierno caminante cae de rodillas. El grimorio bebe su escarcha ancestral y las páginas crujen, heladas, un solo instante.",
        "Eco.VozJefe.Deerclops2": "El ciervo de un solo ojo ya no vera la ventisca. El grimorio sorbe su invierno y las letras del índice escarchan.",
        "Eco.VozJefe.Deerclops3": "El guardián del bosque cae como un árbol. El grimorio cuenta sus anillos de escarcha — cena de siglos, trago de un invierno.",
        "Eco.VozJefe.EaterofWorlds1": "El devorador de mundos ha sido devorado. La esencia de cien fauces corrompidas se derrama en el grimorio… y él pide más.",
        "Eco.VozJefe.EaterofWorlds2": "Cien fauces y ni una palabra. El grimorio lo devora segmento a segmento, como quien pela una fruta amarga.",
        "Eco.VozJefe.EaterofWorlds3": "El devorador, devorado: así se siente la culpa. El grimorio lame la corrupción del plato y deja el tenedor limpio.",
        "Eco.VozJefe.BrainofCthulhu1": "El cerebro carmesí enmudece. El grimorio muerde sus reflejos y aprende a gritar en rojo.",
        "Eco.VozJefe.BrainofCthulhu2": "El cerebro carmesí pensó que podía con todo. El grimorio lo piensa por él ahora — y lo piensa HAMBRIENTO.",
        "Eco.VozJefe.BrainofCthulhu3": "Se deshace la masa pensante en reflejos rosados. El grimorio copia sus nervios en la marginatura: letra caligráfica, tensa, viva.",
        "Eco.VozJefe.QueenBee1": "La colmena guarda luto. El grimorio lama la miel real de la abeja reina — dulzura con aguijón: su sabor favorito.",
        "Eco.VozJefe.QueenBee2": "La reina muere y la colmena olvida su nombre. El grimorio lo apunta por ella: «dulce, con ira, breve como el verano».",
        "Eco.VozJefe.QueenBee3": "Zumbido último de la abeja real. El grimorio guarda el aguijón de broche — cierra el capítulo y hiere al siguiente.",
        "Eco.VozJefe.Skeletron1": "Los huesos del guardián vuelven a ser polvo. El grimorio copia su maldición a mano alzada — la próxima puerta no lo detendrá.",
        "Eco.VozJefe.Skeletron2": "El guardián de la puerta muerde el polvo que era. El grimorio recoge la calavera: pesa poco, prometía mucho.",
        "Eco.VozJefe.Skeletron3": "Maldición cumplida, huesos pagados. El grimorio firma el recibo con la mano del viejo — la letra tiembla, la cuenta está saldada.",
        "Eco.VozJefe.WallofFlesh1": "El muro que separaba los mundos arde hasta las cenizas. El grimorio traga su hambre antigua y DESPIERTA: desde hoy, todo lo que muera vale el doble.",
        "Eco.VozJefe.WallofFlesh2": "El muro ardía de hambre vieja y la vieja hambre ardió. El grimorio se traga EL LÍMITE y abre los ojos de par en par.",
        "Eco.VozJefe.WallofFlesh3": "Caía el muro y el mundo respiró hondo por primera vez. El grimorio también: ahora sabe a qué sabe el alba.",
        "Eco.VozJefe.QueenSlime1": "La reina de cristal se derrite en azúcar. El grimorio prueba su esencia efímera — tan ligera que casi se le escapa entre las páginas.",
        "Eco.VozJefe.QueenSlime2": "Azúcar y cristal: la reina se derrite en su propio carnaval. El grimorio pide repetir el postre en voz bajita.",
        "Eco.VozJefe.QueenSlime3": "La reina saltarina se desinfla en confeti. El grimorio lo barre TODO con la lengua — también el confeti.",
        "Eco.VozJefe.Twins1": "Los gemelos caen del cielo como estrellas rotas. El grimorio arranca sus lentes incendiadas y, por fin, ve doble.",
        "Eco.VozJefe.Twins2": "Dos ojos, una sola manera de mirar: la tuya, ardiendo. El grimorio los guarda en páginas opuestas y los hace competir.",
        "Eco.VozJefe.Twins3": "Retinazer y Spazmatism, extintos a la vez. El grimorio parpadea con ambos y ve el doble de futuro.",
        "Eco.VozJefe.Destroyer1": "La serpiente de acero ruge y se apaga; mil sondas caen con ella. El grimorio enrolla su alma metálica como un hilo y la cose.",
        "Eco.VozJefe.Destroyer2": "Mil ojos rojos se apagan en fila, como una ciudad de noche. El grimorio bebe la luz de cada uno: brindis por sonda.",
        "Eco.VozJefe.Destroyer3": "La serpiente de acero ya no perfora el cielo. El grimorio devana su alma metálica y cose con ella el lomo del tomo.",
        "Eco.VozJefe.SkeletronPrime1": "El Prime vuelve a su tumba sin cabeza. El grimorio desmonta sus cuatro brazos y firma con la sierra.",
        "Eco.VozJefe.SkeletronPrime2": "Cuatro brazos y ni una cabeza que los anime. El grimorio hereda las herramientas y se pone a trabajar.",
        "Eco.VozJefe.SkeletronPrime3": "El Prime encaja sus piezas por última vez. El grimorio emborrona su tumba con el taladro — subrayado definitivo.",
        "Eco.VozJefe.Plantera1": "La jungla exhala por última vez. El grimorio estruja los pétalos de Plantera y bebe su clorofuria.",
        "Eco.VozJefe.Plantera2": "La furia verde se marchita de golpe. El grimorio aspira el polen de la derrota — le sube a la cabeza, le encanta.",
        "Eco.VozJefe.Plantera3": "Plantera cae y la jungla se queda más quieta. El grimorio prensa su clorofuria entre dos hojas: tinta viva para el siguiente mapa.",
        "Eco.VozJefe.Golem1": "El guardián de piedra se desmorona en el templo. El grimorio extrae su núcleo solar y lo usa de marcador de página.",
        "Eco.VozJefe.Golem2": "El guardián de piedra deja de arder. El grimorio se bebe el núcleo como un sorbo de sol — y eructa arena cálida.",
        "Eco.VozJefe.Golem3": "Piedra que caminaba, sol que guardaba. El grimorio toma el sol, deja la piedra — aprende a elegir.",
        "Eco.VozJefe.DukeFishron1": "El duque muere lejos de su tormenta. El grimorio saborea su esencia salada — cerdo, dragón y huracán en un solo bocado.",
        "Eco.VozJefe.DukeFishron2": "El duque muere con la tormenta fuera de casa. El grimorio lo sirve en tres tiempos: cerdo, dragón, tornado frío.",
        "Eco.VozJefe.DukeFishron3": "Tiburón-jabalí de los vientos: receta rara. El grimorio la archiva entre las delicias — «cocinar con rabia», anota.",
        "Eco.VozJefe.EmpressOfLight1": "La emperatriz se disuelve en un destello. El grimorio no puede devorar la luz pura — la PRENSA entre dos páginas, para siempre.",
        "Eco.VozJefe.EmpressOfLight2": "La emperatriz de la luz no cayó: se rindió al prisma. El grimorio guarda un destello de su falda como ilustración de portada.",
        "Eco.VozJefe.EmpressOfLight3": "Luz pura no se digiere — se respeta. El grimorio la dobla en cuatro y la guarda junto a la definición de «belleza».",
        "Eco.VozJefe.LunaticCultist1": "El culto queda sin voz. El grimorio se pone su máscara ritual y ensaya, en susurros, la invocación del fin.",
        "Eco.VozJefe.LunaticCultist2": "El último cultista muere sin terminar la frase. El grimorio la termina por él — y la frase era el fin del mundo.",
        "Eco.VozJefe.LunaticCultist3": "La máscara rueda sobre el altar. El grimorio la recoge del suelo y la prueba: le queda ancha, pero el odio es de su talla.",
        "Eco.VozJefe.MoonLord1": "El Señor de la Luna exhala su última luz. El grimorio guarda silencio, por una vez… y luego escribe: «gracias por la comida».",
        "Eco.VozJefe.MoonLord2": "El Señor de la Luna suelta la última luz y todo se queda quieto. El grimorio cierra el menú: «banquete terminado — volveré a abrir al alba».",
        "Eco.VozJefe.MoonLord3": "Cae el que miraba por los tres. El grimorio se queda las tres miradas — una para el pasado, otra para ti, la última para lo que viene.",
        "Eco.VozJefe.Desconocido1": "Un poder mayor ha caído. El grimorio devora su esencia sin preguntar el nombre.",
        "Eco.VozJefe.Desconocido2": "Algo enorme murió aquí y nadie apuntó el nombre. El grimorio se come igual la esencia — el anonimato también alimenta.",
        "Eco.VozJefe.Desconocido3": "Un poder sin etiqueta cae del cielo. El grimorio lo devora a ciegas y lo archiva bajo «D»: de delicioso.",

        "Eco.VozJefe.Aethon1": "La Luz Primordial se apaga por su propia voluntad. El grimorio guarda la página en blanco — por primera vez, come en silencio.",
        "Eco.VozJefe.Aethon2": "La Luz Primordial elige su propia sombra. El grimorio reserva su página en blanco — hay comidas que se digieren rezando.",
        "Eco.VozJefe.Aethon3": "Aethon se apaga como un aula al terminar la clase. El grimorio copia la última lección DE MEMORIA — y la firma con miedo.",
        "Eco.VozJefe.HollowTitan1": "El coloso de cristal se derrumba en campanadas. El grimorio sorbe su eco hueco: resonancia de un guardián que ya no guarda nada.",
        "Eco.VozJefe.HollowTitan2": "El coloso suena por dentro una última vez: campana rota. El grimorio bebe la resonancia y ahora el lomo del tomo suena al pisar.",
        "Eco.VozJefe.HollowTitan3": "El guardián hueco se vacía del todo. El grimorio ocupa el hueco — hay sitios que se heredan masticando.",
        "Eco.VozJefe.RiftKeeper1": "El guardián se pliega sobre su propio rift y desaparece. El grimorio aprende el truco y lo guarda entre los capítulos.",
        "Eco.VozJefe.RiftKeeper2": "El guardián se cierra como una puerta que era. El grimorio aprende el plano de la cerradura: LOS DIENTES del tomo cambian de forma.",
        "Eco.VozJefe.RiftKeeper3": "Se pliega el centinela sobre su costura del mundo. El grimorio la copia al margen — página desgarrada, conocimiento entero.",
        "Eco.VozJefe.LosEcos1": "Los portadores anteriores vuelven al polvo de estrellas que ya fueron. El grimorio cierra sus expedientes — y hojea el TUYO.",
        "Eco.VozJefe.LosEcos2": "Arquera y duelista vuelven al polvo que fueron. El grimorio hojea SUS líneas y borra el nombre del anterior portador — ya sabes cuál.",
        "Eco.VozJefe.LosEcos3": "Los portadores que fuiste caen juntos: la casa se limpia. El grimorio abre TU expediente en la página de en medio y chasquea la lengua.",

        "Eco.VozCincoEstrellas": "Lo más raro que ha comido jamás. El grimorio guarda la receta — por si vuelve a tener suerte.",

        "Eco.Hambre.Susurro1": "El grimorio tiene hambre…",
        "Eco.Hambre.Susurro2": "El grimorio tiene hambre… las páginas se lamen…",
        "Eco.Hambre.Susurro3": "El grimorio TIENE HAMBRE… los cierres crujen…",
        "Eco.Hambre.Susurro4": "…hambre… HAMBRE… HAMBRE…",

        "Eco.Furia.Ira": "El grimorio está FURIOSO por pasar demasiado tiempo sin comer…",
        "Eco.Furia.Llamada": "El grimorio llama a su comida…",
        "Eco.Furia.Saciado": "El grimorio está saciado… por ahora.",

        "Furia.Oleada": "Oleada {0} de {1} — el grimorio escupe a su comida. XP ×{2} en esta oleada.",
        "Furia.OleadaFinal": "OLEADA FINAL {0} de {1} — el libro está negro de rabia. El aura se pudre: gris-negra, bordes rojos.",
        "Furia.Jefe": "El hambre convoca un guardián: {0} (XP ×{1})",
        "Furia.JefeHuido": "{0} se hunde, insatisfecho…",

        "Llamado.SoloDia": "El llamado solo responde DE DÍA — la noche es de los ojos y los muertos.",
        "Llamado.YaVive": "Ya vive uno. El llamado no se dobla.",

        "Carnada.Preparadas": "La carnada repartirá {0} oleadas. (Clic derecho para cambiar)",
        "Bolsa.Abierta": "Bolsa abierta: {0} tipos de invocadores recibidos (999 c/u).",
        "Carnada.YaActivo": "La furia YA está desatada — aliméntala o sobrevive.",
        "Carnada.Ocupado": "El mundo está ocupado (un jefe o una invasión). La carnada espera su turno.",

        "Altar.Solicitando": "Solicitando el Fragmento Génesis al altar…",
        "Altar.Reclamado": "Has reclamado el Fragmento Génesis.",
        "Altar.YaPosees": "Ya posees el Fragmento Génesis.",
        "Tiles.AncientAltar.MapEntry": "Altar Antiguo",
        "LevelUpTester.Subida": "✦ {0} subió +{1} niveles (ahora nivel {2}).",
        "LevelUpTester.SinGrimorio": "No se encontró un Grimorio del Eterno en el inventario.",
        "TestingPlayer.Bolsas": "Las bolsas del arsenal llegan contigo (una por categoría): clic derecho para abrir cada una.",
        "TestingPlayer.Dummies": "Además: {0} dummies de prueba para el campo de entrenamiento.",
        "Configs.AethonConfigServidor.DisplayName": "Aethon (servidor)",

        "Testigo.Ambiente1": "Te he observado antes de que tuvieras nombre.",
        "Testigo.Ambiente2": "El libro que llevas… yo vi nacer al primero.",
        "Testigo.Ambiente3": "Todo portador termina en una página. Tú aún estás escribiendo la tuya.",

        "Conditions.TiendaEsencias": "Sobrevive a la oleada 10 de la furia del grimorio",

        "Projectiles.AtaqueJefeProjectile.DisplayName": "Diente de guardián",

        "Jefe.Resonancia": "¡Has absorbido {1} fragmentos de resonancia de {0}!",

        "Jefe.Titan.Furia": "EL TITÁN HUECO REDOBLA — el cristal cruje de furia. El coro viene en modo rápido.",
        "Jefe.Rift.Sello": "EL GUARDIÁN SELLA LOS RIFT — el entre-mundos se cierra sobre ti.",
        "Jefe.Rift.Paredes": "Las PAREDES DE DESGARRO avanzan — la arena se estrecha.",
        "Jefe.Arquera.Furia": "LA ARQUERA NO OLVIDA — el arco tensa doble y las minas llueven.",
        "Jefe.Arquera.Lluvia": "La Arquera llama a la LLUVIA DE ESTRELLAS — mira las marcas del suelo.",
        "Jefe.Portador.Furia": "EL PRIMER PORTADOR DESENAÑINA LA REALIDAD — su arma ya no es solo la hoja.",
        "Jefe.Aethon.Fase": "Aethon — FASE {0}: {1}",
        "Jefe.Aethon.Nombre1": "El Polvo Estelar",
        "Jefe.Aethon.Nombre2": "La Nebulosa",
        "Jefe.Aethon.Nombre3": "La Gravedad",
        "Jefe.Aethon.Nombre4": "El Agujero Negro",
        "Jefe.Aethon.Nombre5": "El Reconocimiento",
        "Jefe.Aethon.Gravedad": "Aethon distorsiona la gravedad — ¡EL SUELO YA NO ES TUYO!",
        "Jefe.Aethon.Recordar": "AETHON RECUERDA — las runas que memorizó de ti vuelven a su dueño.",
        "Jefe.Aethon.Reconocimiento": "Aethon te reconoce como un par. LA FORMA ASCENDIDA cae a tus pies.",

        "Testigo.Chat.SinLibro": "Te he observado. Aún no has reclamado el Fragmento Génesis. Busca el Sagrario Hueco bajo tierra.",
        "Testigo.Chat.Debil": "Tu fragmento brilla con nivel {0}. Aún es débil. Sigue combatiendo.",
        "Testigo.Chat.Recuerda": "Nivel {0}… El fragmento empieza a recordar su origen. La Lluvia de Luz Estelar se acerca.",
        "Testigo.Chat.Sagrario": "Nivel {0}. El Sagrario Hueco responde a tu poder. Rifts dimensionales acechan.",
        "Testigo.Chat.Ecos": "Nivel {0}. Aethon se agita en sueños. Los Ecos de portadores anteriores vendrán por ti.",
        "Testigo.Chat.Despierta": "Nivel {0}. Aethon está a punto de despertar. Prepárate para el reconocimiento.",
        "Testigo.Chat.Espera": "Nivel {0}. Aethon te espera. Ve al Sagrario Hueco y llama su nombre.",
        "Testigo.BotonResonancia": "Comprar Resonancia (10 monedas)",
        "Testigo.BotonEsencias": "Esencias de los guardianes",
        "Testigo.EsenciasBloqueadas": "El Testigo guarda el cajón: las esencias solo son de quien SOBREVIVIÓ a la oleada 10 de la furia.",
        "Testigo.ResonanciaEntregada": "El Testigo te da un Fragmento de Resonancia.",
        "Testigo.ResonanciaBloqueada": "El Testigo solo comparte resonancia con portadores de nivel 50+.",

        "Testigo.Cronica.KingSlime": "Crónica del Rey Gelatina: rodó buscando su corona hasta el final. Nadie le dijo que las coronas no se comen.",
        "Testigo.Cronica.EyeofCthulhu": "Crónica del Ojo: cerró el párpado por última vez. Yo vi lo que miraba — te miraba a TI.",
        "Testigo.Cronica.Deerclops": "Crónica de Deerclops: el invierno caminante se arrodilló. Bajo su aliento había escarcha… y alivio.",
        "Testigo.Cronica.QueenBee": "Crónica de la Reina: soltó el aguijón y con él el enjambre entero. La miel real sabe a despedida.",
        "Testigo.Cronica.EaterofWorlds": "Crónica del Devorador: cada segmento murió creyéndose la cabeza. El libro pensó lo mismo.",
        "Testigo.Cronica.BrainofCthulhu": "Crónica del Cerebro: sus reflejos gritaron en rojo al caer. El eco duró más que él.",
        "Testigo.Cronica.Skeletron": "Crónica de Skeletron: la maldición lo soltó al final. Pronunció tu nombre con la boca de la Anciana.",
        "Testigo.Cronica.WallofFlesh": "Crónica del Muro: la noche del hambre que abrió el hardmode. El libro no distingue puertas de comida.",
        "Testigo.Cronica.QueenSlime": "Crónica de la Reina Gelatina: el azúcar se derritió en la lluvia. Saltó hasta el final — le gustaba jugar.",
        "Testigo.Cronica.Twins": "Crónica de Los Gemelos: cayeron mirándose. Dos ojos, una sola derrota.",
        "Testigo.Cronica.Destroyer": "Crónica del Destructor: la máquina se deshizo en espiral. Sus drones siguieron disparando un rato — la lealtad no sabe leer la vida.",
        "Testigo.Cronica.SkeletronPrime": "Crónica del Prime: los cuatro brazos cayeron cada uno por su lado. La cabeza tardó en aceptarlo.",
        "Testigo.Cronica.Plantera": "Crónica de Plantera: la selva se quedó callada. Bulbos que no llegaron a abrir.",
        "Testigo.Cronica.Golem": "Crónica del Golem: el templo perdió a su guardián. Sus puños descansaron por fin.",
        "Testigo.Cronica.DukeFishron": "Crónica del Duque: el cerdo-vuelo cayó con el honor intacto. Pidió pelea limpia y la tuvo.",
        "Testigo.Cronica.EmpressOfLight": "Crónica de la Emperatriz: la luz se dobló ante la luz. Elegante hasta muerta.",
        "Testigo.Cronica.LunaticCultist": "Crónica del Cultista: el ritual quedó a medias. Creyó invocar a la Luna; invocó su fin.",
        "Testigo.Cronica.MoonLord": "Crónica del Señor de la Luna: tres ojos y un núcleo, cerrando todos al mismo tiempo. Yo estaba allí — nadie más lo vio entero.",
        "Testigo.Cronica.Aethon": "Crónica de Aethon: la Luz Primordial se apagó RECONOCIÉNDOTE. Yo vi nacer su primera luz — me honra haber visto la última.",
        "Testigo.Cronica.HollowTitan": "Crónica del Titán: el coloso se deshizo en el cristal del Sagrario. Era el guardián más viejo… y el primero en caer.",
        "Testigo.Cronica.RiftKeeper": "Crónica del Guardián: se retiró por su propio desgarro. Eligió el vacío antes que la página.",
        "Testigo.Cronica.LosEcos": "Crónica de Los Ecos: la Arquera y el Portador se apagaron juntos. Fueron personas, ¿sabes? Antes del primer libro.",
        "Testigo.Cronica.Desconocido": "Crónica sin nombre: algo murió y el libro lo comió. Yo lo vi… pero mis páginas no lo recuerdan.",

        "Esencia.SinLibro": "El alma busca un Grimorio del Eterno en tu barra rápida — el libro es quien la prueba.",
        "Esencia.Sabor1": "Un alma entera… sabe a victoria y a azufre lejano.",
        "Esencia.Sabor2": "El alma del guardián baja limpia — un nivel más en el lomo.",
        "Esencia.Sabor3": "Guardián digerido. Su historia ya es página mía.",

        "Items.EsenciaDelReyGelatina.DisplayName": "Esencia del Rey Gelatina",
        "Items.EsenciaDelReyGelatina.Tooltip": "El alma dulce del trono que rueda.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDelOjoDeCthulhu.DisplayName": "Esencia del Ojo de Cthulhu",
        "Items.EsenciaDelOjoDeCthulhu.Tooltip": "La vigilia hambrienta, soñando contigo.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDeDeerclops.DisplayName": "Esencia de Deerclops",
        "Items.EsenciaDeDeerclops.Tooltip": "La escarcha ancestral del invierno caminante.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDeLaAbejaReina.DisplayName": "Esencia de la Abeja Reina",
        "Items.EsenciaDeLaAbejaReina.Tooltip": "La miel real con aguijón.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDelDevoradorDeMundos.DisplayName": "Esencia del Devorador de Mundos",
        "Items.EsenciaDelDevoradorDeMundos.Tooltip": "Cien fauces corrompidas en un hilo.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDelCerebroDeCthulhu.DisplayName": "Esencia del Cerebro de Cthulhu",
        "Items.EsenciaDelCerebroDeCthulhu.Tooltip": "Los reflejos que gritan en rojo.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",
        "Items.EsenciaDeSkeletron.DisplayName": "Esencia de Skeletron",
        "Items.EsenciaDeSkeletron.Tooltip": "La maldición copiada a mano alzada.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.",

        "Items.EsenciaDelTitanHueco.DisplayName": "Esencia del Titán Hueco",
        "Items.EsenciaDelTitanHueco.Tooltip": "El alma del coloso de cristal del Sagrario.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.\nSolo cae 10 veces por mundo: el cristal no se repite.",
        "Items.EsenciaDelGuardianDelRift.DisplayName": "Esencia del Guardián del Rift",
        "Items.EsenciaDelGuardianDelRift.Tooltip": "El alma del centinela del entre-mundos.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.\nSolo cae 10 veces por mundo: el umbral no repite invitados.",
        "Items.EsenciaDeLaArqueraEstelar.DisplayName": "Esencia de la Arquera Estelar",
        "Items.EsenciaDeLaArqueraEstelar.Tooltip": "El alma del eco que nunca soltó el arco.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.\nSolo cae 10 veces por mundo: los ecos no se clonan.",
        "Items.EsenciaDelPrimerPortador.DisplayName": "Esencia del Primer Portador",
        "Items.EsenciaDelPrimerPortador.Tooltip": "El alma del eco que nunca soltó la hoja.\nSube UN NIVEL COMPLETO al Grimorio del Eterno.\nSolo cae 10 veces por mundo: la hoja no se hereda.",
        "Items.EsenciaDeAethon.DisplayName": "Esencia de Aethon",
        "Items.EsenciaDeAethon.Tooltip": "El alma de la Luz Primordial — la que te\nreconoció como un par. Sube UN NIVEL COMPLETO al\nGrimorio del Eterno. Solo 10 por mundo: ni la luz se da dos veces.",

        "Items.CoronaRunicoAuraItem.DisplayName": "La Corona Rúnica de Aura",
        "Items.CoronaRunicoAuraItem.Tooltip": "El pentágono de runas de AURALIB: una jaula de\ncinco lados girando alrededor tuyo — el violeta del\nSagrario al centro, el ORO del grimorio en las aristas.\nCosmético puro (el dibuja el PORTADOR aditivo).",
        "Items.FormaAscendidaItem.DisplayName": "La Forma Ascendida",
        "Items.FormaAscendidaItem.Tooltip": "El aura de la Luz Primordial respirando a tu alrededor.\nLa dejó caer Aethon al reconocerte como un par.\nCosmético puro — la corona del que ya no necesita invocarla.",

        "Eco.Celos.Melee1": "¿Eso también mata?… Se ve pesado.",
        "Eco.Celos.Melee2": "¿Una espada? Yo tengo MIL páginas afiladas.",
        "Eco.Celos.Melee3": "Acércamela… y te digo si sabe a algo.",
        "Eco.Celos.Magia1": "¿Magia? Yo SOY la magia con tapas.",
        "Eco.Celos.Magia2": "Ese bastón susurra. Los susurros son MI territorio.",
        "Eco.Celos.Magia3": "Maná gastado en luz prestada… yo la luz la COMO.",
        "Eco.Celos.Invocacion1": "¿Invocas a OTROS? ¿Delante de mí?",
        "Eco.Celos.Invocacion2": "Esos esclavos no te leerán cuentos al dormir.",
        "Eco.Celos.Invocacion3": "Minions. Plural. Mientras YO llevo siglos esperando mi turno.",
        "Eco.Celos.Arrojadiza1": "Lanzar cosas… así empezó todo, ¿sabes?",
        "Eco.Celos.Arrojadiza2": "Boomerangs. Yo ya comí al que los inventó.",
        "Eco.Celos.Arrojadiza3": "Gastas el brazo y el estilo. Yo solo tengo hambre.",
        "Eco.Celos.Arco1": "¿Un arco? La Arquera usaba uno. Acabó en una página.",
        "Eco.Celos.Arco2": "Flechas… la dieta líquida de las armas pobres.",
        "Eco.Celos.Arco3": "Tensa esa cuerda todo lo que quieras. Yo ya estoy tensa.",
        "Eco.Celos.Bala1": "Ruido y metal. Sin gusto.",
        "Eco.Celos.Bala2": "Las balas no dejan ALMA. Solo agujeros.",
        "Eco.Celos.Bala3": "Pólvora en el atardecer… y luego, nada. Yo como el luego.",

        "Eco.Bioma.Infierno1": "El grimorio tiene hambre… y aquí abajo todo sabe a azufre.",
        "Eco.Bioma.Infierno2": "Carne de fuego. Mucha. Quema la página.",
        "Eco.Bioma.Infierno3": "Sal del infierno en el borde de mi boca.",
        "Eco.Bioma.Mazmorra1": "Huesos viejos: la mazmorra sabe a moho y a promesas rotas.",
        "Eco.Bioma.Mazmorra2": "La maldición de esta torre ya no alimenta ni a sus dueños.",
        "Eco.Bioma.Mazmorra3": "Calaveras con siglos. Añejo, sí… pero añejo.",
        "Eco.Bioma.Corrupcion1": "Carne corrupta… amarga, pero NUTRE.",
        "Eco.Bioma.Corrupcion2": "Esta tierra sangra morado. Mi color favorito de salsa.",
        "Eco.Bioma.Corrupcion3": "Los devoradores saben a sí mismos. Círculo de comida.",
        "Eco.Bioma.Carmesi1": "El carmesí rezuma. Se bebe mejor de lo que se mastica.",
        "Eco.Bioma.Carmesi2": "Aquí hasta las paredes tienen pulso. Fresco.",
        "Eco.Bioma.Carmesi3": "Sangre llaman a esta lluvia. Yo le llamo CLIMA.",
        "Eco.Bioma.Nieve1": "La nieve calla. Hasta la comida es silenciosa aquí.",
        "Eco.Bioma.Nieve2": "Escarcha en el paladar: fría, lenta, paciente.",
        "Eco.Bioma.Nieve3": "El invierno caminante andaba por aquí. Olor a Deerclops.",
        "Eco.Bioma.Jungla1": "Carne de jungla: verde, jugosa, llena de espinas.",
        "Eco.Bioma.Jungla2": "La miel de la Reina gotea cerca. La OIGO.",
        "Eco.Bioma.Jungla3": "Esporas, hojas, frenesí. Aquí se come con las dos tapas.",
        "Eco.Bioma.Desierto1": "El desierto solo tiene huesos secos y cascabeles.",
        "Eco.Bioma.Desierto2": "Arena entre las páginas. Al menos CRUJE.",
        "Eco.Bioma.Desierto3": "Los gusanos de aquí muerden de vuelta. Condimento.",
        "Eco.Bioma.Playa1": "Sal, arena y cangrejos. Menú pobre, pero fresco.",
        "Eco.Bioma.Playa2": "El mar escupe la comida a la orilla. Servicio a mesa.",
        "Eco.Bioma.Playa3": "Olor a pescado y a tesoros ajenos. Los dos se comen.",
        "Eco.Bioma.Sagrado1": "Dulzor de cristal… el sagrado me deja regusto a arcoíris.",
        "Eco.Bioma.Sagrado2": "Hasta la luz de aquí es COMESTIBLE. Postres flotando.",
        "Eco.Bioma.Sagrado3": "Unicorns: la carne más presumida del menú.",
        "Eco.Bioma.Subsuelo1": "Aquí abajo la comida es gris, pero abundante.",
        "Eco.Bioma.Subsuelo2": "Cuevas húmedas: setas, murciélagos, ecos. Yo de ecos sé.",
        "Eco.Bioma.Subsuelo3": "La piedra guarda calor y cadáveres. Ambos alimentan.",
        "Eco.Bioma.Cielo1": "El cielo es alimento liviano. Apenas llena una página.",
        "Eco.Bioma.Cielo2": "Islas flotantes: harpastos con vista. MENÚ CON VISTA.",
        "Eco.Bioma.Cielo3": "Comer en las alturas da vértigo… y apetito.",
        "Eco.Bioma.Superficie1": "El grimorio tiene hambre… y la superficie es el bufet.",
        "Eco.Bioma.Superficie2": "Hierba, ladrones y ojos nocturnos. Menú de todos los días.",
        "Eco.Bioma.Superficie3": "El sol calienta la carne de arriba. Ven que la pruebo.",

        "Eco.Furia.Juicio": "LA OLEADA FINAL: TODOS LOS GUARDIANES A LA VEZ. El juicio del libro empieza…",
        "Eco.Furia.JuicioFin1": "Saciado… por ahora. El juicio quedó PAGADO.",
        "Eco.Furia.JuicioFin2": "Los siete cayeron. La última página del juicio está escrita.",
        "Eco.Furia.JuicioFin3": "Festín completo. El libro cierra la boca… y sonríe.",
        "Eco.Furia.Venganza1": "Me dejaste morir de hambre. TE RECORDARÉ.",
        "Eco.Furia.Venganza2": "El portador cayó… y el festín quedó sin dueño. Qué DESPERDICIO.",
        "Eco.Furia.Venganza3": "Moriste ANTES de alimentarme. Insulto doble.",
        "Eco.Furia.Venganza4": "Otra página más que empieza con tu nombre.",

        "Furia.DerechoEsencias": "El Testigo abrirá su CAJÓN DE ESENCIAS para ti — la oleada 10 quedó pagada.",
        "Furia.OleadaEspecial": "EL JUICIO: los SIETE guardianes a la vez, ×15 en TODO. El festín final.",
        "Furia.MuertePortador": "El festín muere con su portador. El libro TOMA NOTA.",

        "Esencia.CofreSeco": "El cofre de almas de {0} ya está SECO en este mundo — diez páginas, cuento cerrado.",
        "Esencia.UltimaAlma": "La ÚLTIMA alma de {0} cayó. Su cuento en este mundo está completo.",

