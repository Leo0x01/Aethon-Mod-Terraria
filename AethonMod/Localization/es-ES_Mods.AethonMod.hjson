Buffs: {
	OjoEternoBuff: {
		DisplayName: Ojos del Eterno
		Description: Los ojos del grimorio flotan en corona y disparan su rayo negro de bruma
	}

	AethonMenorBuff: {
		DisplayName: Aethon Menor
		Description: Una chispa viva del propio grimorio alumbra tu camino con el arcoíris
	}

	GrimorioMenorBuff: {
		DisplayName: Grimorio Menor
		Description: La miniatura del grimorio flota a tu hombro — se aburre, viaja al pueblo y molesta a los vecinos
	}

	NebulaJellyfishBuff: {
		DisplayName: Medusa Nebular
		Description: Una medusa de nebulosa deriva a tu lado a pulsos de gravedad
	}

	StellarCometBuff: {
		DisplayName: Cometa Estelar
		Description: Un cometa vivo orbita a tu lado y cae en picado sobre tus enemigos
	}

	LivingPulsarBuff: {
		DisplayName: Púlsar Vivo
		Description: Una estrella de neutrones gira a tu lado, sus haces rañando a tus enemigos
	}

	QuemaduraCosmica: {
		DisplayName: Quemadura cósmica
		Description: El horizonte de eventos te lame: el fuego que arde hacia dentro
	}

	OcasoActivoBuff: {
		DisplayName: El Ocaso
		Description: El ocaso arde: 8 segundos de muertes de estrella a daño ×3 con ejecución
	}

	SobrecalentadoBuff: {
		DisplayName: Sobrecalentada
		Description: El bastón humea y calla: no dispara mientras se enfría
	}

	CriaEstelarBuff: {
		DisplayName: Cría Estelar
		Description: Una cría de sierpe estelar nada a tu lado y caza a tus enemigos
	}

	FragmentoSupernovaBuff: {
		DisplayName: Fragmento de Supernova
		Description: Una singularidad alada flota a tu hombro y dispara ráfagas y rayos a tus enemigos
	}
}

NPCs: {
	AethonBoss: {
		// v6.50.117 — THE MEMORY SPLIT IN TWO: the boss is now
		// "Fragments of a Distant Memory - Aethon" and fights as a
		// light+darkness pair; the fusion is THE WHOLE MEMORY.
		// v6.50.121 — THE MISSING RENAME: .117 left the OLD name
		// here — only the dark twin and the fusion had been renamed.
		DisplayName: Fragmentos de un recuerdo lejano - Aethon
		// v6.50.61 — THE PURGE (the letter: "delete every NPC of the mod,
		// keep only the main boss, Aethon; delete the other bosses and the
		// witness"): HollowTitan, RiftKeeper, EchoArcher, EchoBlade and
		// TheWitness died with their entries.
		// v6.50.45 — THE HUNTER OF THE BOSS'S PACK
		Bestiary: Lo que queda de la mente de un dios muerto: un recuerdo que aún arde. Controla el tiempo para que jamás anochezca mientras exista.
	}

	AethonBossOscuro: {
		DisplayName: Fragmentos de un recuerdo lejano - Aethon
		Bestiary: La mitad oscura del recuerdo. Su sol está moribundo: negro por fuera, morado por dentro, y no calienta nada.
	}

	AethonBossFusionado: {
		DisplayName: El Recuerdo Completo - Aethon
		Bestiary: Las dos mitades recordaron ser una. Un eclipse con colmillos: la luz y la oscuridad ya no se turnan.
	}

	CazadorAstral.DisplayName: Cazador Astral

	GrimorioDormido: {
		// v6.50.61 — THE PURGE (the letter: "delete every NPC of the mod,
		// keep only the main boss, Aethon; delete the other bosses and the
		// witness"): HollowTitan, RiftKeeper, EchoArcher, EchoBlade and
		// TheWitness died with their entries.
		// v6.50.45 — THE HUNTER OF THE BOSS'S PACK
		DisplayName: El Grimorio Dormido
		// v6.50.117 — THE FALL: the book that waits in its crater
		Bestiario: Un grimorio caído del cielo en un cometa de tinta. Duerme flotando en su cráter… a la espera de la mano correcta.

		TownNPCMood: {
