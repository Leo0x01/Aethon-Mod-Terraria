// v6.52.0 — LA BOLSA DEL ESCRIBA: localización del ciclo nuevo
// (Task 84). ARCHIVO NUEVO — los hjson de raíz NO se tocan (la
// regla del ciclo). El prefijo del nombre (Mods.AethonMod) es el
// MISMO que el de raíz: tML FUSIONA todos los archivos del idioma
// (LocalizationLoader.TryGetCultureAndPrefixFromPath — verificado
// contra el tModLoader.dll decompilado, Task 84).
// ESPAÑOL LATINOAMÉRICA (es-MX) — la fuente del ciclo.

Items: {
	BolsaDelEscriba: {
		DisplayName: "Bolsa del Escriba"
		Tooltip: "El ciclo completo del Escriba en una bolsa: el arma del rayo masivo, la pluma viva con su árbol de inscripciones y la pluma que lo convoca. Ábrela con clic derecho (solo entrega lo que falte)."
		Abierta: "Las palabras del Escriba despiertan en tu inventario."
	}
	PrimerTrazo: {
		DisplayName: "El Primer Trazo"
		Tooltip: "La pluma que escribió la primera línea del mundo, cargada de luz. MANTÉN el clic: cinco trazos convergen en UN rayo masivo de ruido de Perlin. A plena carga el daño se triplica."
		Prueba: "SIN COSTE DE MANÁ — arma de prueba: canaliza sin miedo."
	}
	PlumaConsciente: {
		DisplayName: "La Pluma Consciente"
		Tooltip: "La última pluma del Escriba — con su conciencia atada dentro. Habla, recuerda y desbloquea sus propias palabras. Ábrelo con [P]: el árbol de inscripciones (Filigrana / Verso / Colofón). Cada jefe vencido con ella sube su nivel."
		Nivel: "Nivel de la pluma: {0}"
		Ranura0: "Filigrana: {0}"
		Ranura1: "Verso: {0}"
		Ranura2: "Colofón: {0}"
		Arbol: "[P] — Árbol de inscripciones (sosteniendo la pluma)"
	}
	PlumaConvocadora: {
		DisplayName: "Pluma Convocadora"
		Tooltip: "La pluma que llama a quien la sostentó por última vez. Invoca a EL ESCRIBA — el jefe demo de la coreografía (340.000 de vida, post-Señor de la Luna)."
	}
}
