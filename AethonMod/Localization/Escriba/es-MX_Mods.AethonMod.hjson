NPCs: {
	EscribaJefe: {
		DisplayName: "El Escriba, la Mano que Devoró el Libro"
		Bestiary: "La mano que escribió las páginas que Aethon devoró. No murió: se quedó a terminar el libro — y tú estás escrito en la última página."
	}
}
Keybinds: {
	EscribaArbol: {
		DisplayName: "Árbol de inscripciones (Pluma Consciente)"
	}
}
UI: {
	Arbol: {
		Titulo: "LAS INSCRIPCIONES DE LA PLUMA"
		Nivel: "Nivel del arma: {0}"
		Ranura0: "FILIGRANA"
		Ranura1: "VERSO"
		Ranura2: "COLOFÓN"
		Pista: "Señala una inscripción para leerla."
		PistaHecho: "La gana el hecho: {0}"
		PistaRegalo: "La regala el Escriba al vencer: {0}"
		PistaNacimiento: "La pluma ya nace sabiéndola."
	}
}
Escriba: {
	Anuncio: "El Escriba alza la pluma: la historia no ha terminado."
	BolsaEntregada: "La Bolsa del Escriba espera en tu inventario (clic derecho)."
	Encuentro1: "El Escriba: «…Así que tú eres quien lleva mi pluma.»"
	Encuentro2: "El Escriba: «Yo escribí las páginas que tu libro devoró. Todas.»"
	Encuentro3: "El Escriba: «Graba mis palabras en la pluma y verás de qué soy capaz.»"
	Encuentro4: "El Escriba: «[P]. Elige bien: todo poder tiene su carga.»"
	Susurro1: "El Escriba murmura: «Las líneas torcidas también terminan.»"
	Susurro2: "El Escriba murmura: «La tinta nunca olvida lo que escribió.»"
	Susurro3: "El Escriba murmura: «Ese enemigo… ya lo había descrito yo.»"
	Susurro4: "El Escriba murmura: «Sigue. La página se llena sola.»"
	HechoCumplido: "HECHO CUMPLIDO — el Escriba desbloquea: {0}"
	InscripcionDesbloqueada: "Nueva inscripción: {0}"
	PruebaVencida: "La pluma sube al nivel {0} — el arma recuerda a quien venció."
	AtaqueTrazo: "El Trazo"
	AtaqueLluvia: "Lluvia de Versos"
	AtaquePlumas: "Las Plumas"
	AtaqueBorron: "El Borrón"
	AtaqueCorregido: "El Trazo, Corregido"
	AtaqueJaula: "La Jaula de Tinta"
	AtaqueVerso: "El Verso"
	AtaqueAnotacion: "La Anotación"
	Transicion1: "La Corrección"
	Transicion2: "El Interlineado"
	Regalo: {
		Subrayado: "El Escriba: «El Ojo cayó. Lo importante va SUBRAYADO.» (Subrayado desbloqueada)"
		LetraCapital: "El Escriba: «El gusano/cerebro cayó. Todo título empieza con LETRA CAPITAL.» (Letra Capital desbloqueada)"
		TintaCorrosiva: "El Escriba: «El hueso viejo cayó. Mi tinta CORROE hasta eso.» (Tinta Corrosiva desbloqueada)"
		Firma: "El Escriba: «El Muro cayó. Lo escrito con sangre lleva FIRMA.» (Firma desbloqueada)"
		VersoCiego: "El Escriba: «Las máquinas cayeron. Este VERSO CIEGO encuentra solo a quién leer.» (Verso Ciego desbloqueado)"
		RimaInterna: "El Escriba: «La planta cayó. Escucha: la RIMA corre por dentro del trazo.» (Rima Interna desbloqueada)"
		Caligrafia: "El Escriba: «El guardián de piedra cayó. La CALIGRAFÍA es paciencia.» (Caligrafía desbloqueada)"
		Hemistiquio: "El Escriba: \"El fanático cayó. El HEMISTIQUIO atraviesa lo que divide.» (Hemistiquio desbloqueado)"
		TintaMadre: "El Escriba: «¡El SEÑOR LUNAR cayó! Esta es la TINTA MADRE — la de donde salieron todas.» (Tinta Madre desbloqueada)"
		ElColofon: "El Escriba: «…Me venciste con mi propia pluma. Toma EL COLOFÓN — la última palabra.» (El Colofón desbloqueado)"
	}
}
